---
import GuideDetail from '@/components/pages/GuideDetail.astro';
import { getGuides } from '@/lib/content';

// Astro hoists getStaticPaths out of module scope, so it may only use imports. One route file
// per language, listing only that language's entries, or a Chinese guide would also build an
// English URL from its own file.
export async function getStaticPaths() {
  const guides = await getGuides('en');
  return guides.map((entry) => ({ props: { entry }, params: { slug: entry.id.split('/').pop() as string } }));
}

const { entry } = Astro.props;
---

<GuideDetail entry={entry} />
