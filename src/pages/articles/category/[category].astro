---
import ArticlesCategory from '@/components/pages/ArticlesCategory.astro';
import { CATEGORY_KEYS } from '@/const';
import { getArticles } from '@/lib/content';

// Astro hoists getStaticPaths out of module scope, so it may only use imports.
export async function getStaticPaths() {
  const articles = await getArticles('en');
  return CATEGORY_KEYS.map((category) => ({
    params: { category },
    props: { list: articles.filter((e) => e.data.category === category) },
  }));
}

const { category } = Astro.params as { category: (typeof CATEGORY_KEYS)[number] };
const { list } = Astro.props;
---

<ArticlesCategory category={category} list={list} />
