---
import PageLayout from '@/layouts/PageLayout.astro';
import Icon from '@/components/ui/Icon.astro';

const links = [
  { label: 'Guides', href: '/guides', note: 'Cost, process, agencies, legal questions.' },
  { label: 'Explainers', href: '/articles', note: 'One question answered per page.' },
  { label: 'Destinations', href: '/destinations', note: 'What a legal system states, with sources.' },
  { label: 'Tools', href: '/tools', note: 'Quote comparison, checklists.' },
];
---

<PageLayout
  title="Page not found"
  description="That address does not resolve to a page on SurrogacyBase."
  noindex={true}
>
  <article class="shell py-16 max-w-[74ch]">
    <p class="text-[14px] font-semibold uppercase tracking-[0.14em] text-muted">Error 404</p>
    <h1 class="mt-3 text-[clamp(2.2rem,5vw,3.4rem)] leading-[1.05]">
      Nothing is published at this address
    </h1>
    <p class="mt-4 text-[17px] leading-relaxed text-muted max-w-[58ch]">
      Either the page moved, or it was researched and then withheld because the only available source
      came from a party selling the service. The
      <a href="/updates" class="link-underlined">updates log</a>
      lists which pages were refused and why, so a missing page is at least an explained one.
    </p>

    <nav class="mt-10" aria-label="Site sections">
      <ul class="divide-y divide-line border-y border-line">
        {links.map((l) => (
          <li>
            <a href={l.href} class="group flex items-baseline justify-between gap-6 py-4">
              <span>
                <span class="text-[17px] font-semibold group-hover:text-accent">{l.label}</span>
                <span class="mt-0.5 block text-[15px] text-muted">{l.note}</span>
              </span>
              <Icon
                name="arrow-up-right"
                size={18}
                class="shrink-0 text-accent transition-transform duration-(--dur) group-hover:-translate-y-0.5"
              />
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </article>
</PageLayout>
