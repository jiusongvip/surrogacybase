---
/*
 * The questions, printed rather than folded.
 *
 * A details element would look tidier and hide the answers from the first screen a crawler
 * indexes. The homepage's whole reason to exist here is to answer these in the HTML, so the
 * list is two columns of question and answer, in the order the questions are asked.
 */
import { langFromPath } from '@/i18n/paths';
import { HOME_FAQ } from '@/data/home-evidence';

const lang = langFromPath(Astro.url.pathname);
const copy = HOME_FAQ[lang];
const citeLabel = lang === 'zh' ? '来源' : 'Source';
---

<section class="scroll-mt-20 border-t border-line bg-paper py-16 lg:py-24" id="questions">
  <div class="shell">
    <div class="max-w-[62ch]">
      <h2 class="h-section max-w-[24ch]">{copy.heading}</h2>
      <p class="mt-5 text-[16px] leading-[1.75] text-muted">{copy.lede}</p>
    </div>

    {/* The question is set in the display face so it reads as a heading rather than as another
        paragraph, and the answer drops back to body setting. Nothing separates the pairs except
        space: six rules under six questions would rebuild the table this page just stopped being. */}
    <dl class="mt-12 grid gap-x-14 gap-y-10 border-t border-line-strong pt-9 lg:grid-cols-2">
      {
        copy.items.map((item) => (
          <div>
            <dt class="font-display text-[19px] font-medium leading-snug text-text">{item.q}</dt>
            <dd class="mt-2.5 max-w-[52ch] text-[15px] leading-[1.72] text-muted">
              {item.a}
              {item.cite && (
                <a
                  href={`#source-${item.cite}`}
                  class="ml-0.5 align-super text-[11px] font-medium text-accent hover:underline"
                  aria-label={`${citeLabel} ${item.cite}`}
                >
                  [{item.cite}]
                </a>
              )}
            </dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>
