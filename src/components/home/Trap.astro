---
/*
 * The trap section.
 *
 * It runs on the sand-grey surface so that it reads as a detour from the explanatory run above
 * it: the previous four sections describe how the thing works, this one describes how a plan
 * goes wrong while still looking finished. Each entry prints the question that separates the
 * two, because a warning without a test is only anxiety.
 */
import { langFromPath } from '@/i18n/paths';
import { HOME_TRAP } from '@/data/home-evidence';

const lang = langFromPath(Astro.url.pathname);
const copy = HOME_TRAP[lang];
const citeLabel = lang === 'zh' ? '来源' : 'Source';
---

<section class="scroll-mt-20 border-t border-line bg-surface-2 py-16 lg:py-24" id="surrogacy-trap">
  <div class="shell">
    <div class="max-w-[64ch]">
      <h2 class="h-section max-w-[20ch]">{copy.heading}</h2>
      <p class="mt-5 text-[16px] leading-[1.75] text-muted">{copy.lede}</p>
    </div>

    {/* The definition is set as the statement the rest of the section tests, not as a footnote
        under the heading: every entry below is one of the four questions this sentence names. */}
    <div class="mt-8 max-w-[68ch]">
      <p class="label">{copy.definitionLabel}</p>
      <p class="mt-3 font-display text-[clamp(1.15rem,1.85vw,1.4rem)] leading-[1.55] text-brand-fg">
        {copy.definition}
      </p>
    </div>

    <ol class="mt-12 grid gap-x-14 gap-y-11 border-t border-line-strong pt-10 sm:grid-cols-2">
      {
        copy.items.map((item, i) => (
          <li>
            <div class="flex items-baseline gap-3">
              <span class="tnum shrink-0 font-display text-[1.4rem] leading-none text-accent">
                {String(i + 1).padStart(2, '0')}
              </span>
              <h3 class="text-[17.5px] leading-snug">{item.title}</h3>
            </div>
            <p class="mt-2.5 text-[14.5px] leading-[1.68] text-muted">
              {item.body}
              {item.cite && (
                <a
                  href={`#source-${item.cite}`}
                  class="ml-0.5 align-super text-[11px] font-medium text-accent hover:underline"
                  aria-label={`${citeLabel} ${item.cite}`}
                >
                  [{item.cite}]
                </a>
              )}
            </p>
            {/* The test is a different voice, not another paragraph: the accent label carries the
                switch, so no rule is needed under each of the four, and the four stay level across
                the row however long the body above them runs. */}
            <p class="mt-3 text-[14px] leading-[1.6] text-text">
              <span class="label mr-2">{copy.testLabel}</span>
              {item.test}
            </p>
          </li>
        ))
      }
    </ol>

    <p class="mt-10 max-w-[64ch] font-display text-[17.5px] leading-[1.55] text-brand-fg">{copy.closing}</p>
  </div>
</section>
