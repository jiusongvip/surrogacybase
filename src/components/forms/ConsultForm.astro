---
/*
 * The enquiry form: the only one on this site that collects anything. It sits in the
 * homepage band and, through the header, in a dialog on every page, so it takes an id prefix
 * rather than assuming it is alone on the page.
 *
 * It posts the fields to /api/enquiry, where a Cloudflare Pages Function delivers them to the
 * site's own Feishu and WeCom inboxes. Those credentials are server-side only and are never
 * baked into this bundle. When the endpoint is not configured, or delivery fails, the form
 * falls back to the version this site had before it had a server: it shows the exact message in
 * the browser and lets the reader open it in their own mail app, copy it, or download it. The
 * status line says which of those happened rather than confirming a message that never arrived.
 *
 * The draft is stored in this browser so a half-written enquiry survives a reload. No identity
 * document, medical record or payment detail is asked for, because none of them is needed to
 * open a conversation.
 *
 * The wording lives in src/data/intake.ts. The script needs some of it at runtime to assemble
 * the message, so the chrome is serialized into the DOM and the bundle stays one file for both
 * languages.
 */
import Icon from '@/components/ui/Icon.astro';
import { SITE } from '@/const';
import { CONSULT_CHROME } from '@/data/intake';
import { langFromPath, localizedPath } from '@/i18n/paths';

interface Props {
  /** Field ids are printed into the page, so the dialog copy cannot reuse the inline one's. */
  idPrefix?: string;
  /** The dialog already draws a panel, so the form inside it stops drawing its own. */
  framed?: boolean;
}

const { idPrefix = 'cq', framed = true } = Astro.props;
const inbox = SITE.contactEmail;
const lang = langFromPath(Astro.url.pathname);
const copy = CONSULT_CHROME[lang];
const privacyHref = localizedPath(lang, '/privacy');
const source = idPrefix === 'dlg' ? 'dialog' : 'home';
---

<div
  class:list={[framed ? 'rounded-(--radius-card) border border-line bg-paper p-6 text-text shadow-lift sm:p-7' : 'text-text']}
  data-consult={inbox}
  data-endpoint="/api/enquiry"
  data-source={source}
  data-copy={JSON.stringify(copy)}
>
  <div data-form-body>
    <div class="grid gap-5">
      {/* The dial select is narrow and the number takes the rest of the row. The script sets the
        * code from the browser's locale before the reader touches it, so a reader in Hong Kong is
        * not asked to change +86 by hand. */}
      <div>
        <label class="field-label" for={`${idPrefix}-phone`}>
          {copy.phoneLabel}
          <span class="text-flag" aria-hidden="true">{copy.required}</span>
        </label>
        <div class="mt-1.5 flex gap-2">
          <select
            class="field-input w-[106px] shrink-0"
            id={`${idPrefix}-dial`}
            data-field="dial"
            aria-label={copy.dialLabel}
          >
            {copy.dials.map((dial) => <option value={dial}>{dial}</option>)}
          </select>
          <input
            class="field-input flex-1"
            id={`${idPrefix}-phone`}
            data-field="phone"
            type="tel"
            autocomplete="tel"
            inputmode="tel"
            maxlength="24"
            aria-required="true"
            aria-describedby={`${idPrefix}-phone-error`}
            placeholder={copy.phonePlaceholder}
          />
        </div>
        <p
          class="mt-1.5 text-[13px] leading-snug text-flag"
          id={`${idPrefix}-phone-error`}
          data-error-for="phone"
          hidden
        ></p>
      </div>

      {/* One account is enough. The tabs are ordered by the language the page is in, and the input
        * below them is relabelled per app in its placeholder: a WeChat ID is not a phone number and
        * a Telegram handle starts with @, so one generic "{app} number" would be wrong twice. */}
      <fieldset class="min-w-0">
        <legend class="field-label">
          {copy.channelLabel}
          <span class="text-flag" aria-hidden="true">{copy.required}</span>
          <span class="font-normal text-muted">{copy.channelHint}</span>
        </legend>
        <div class="mt-2 flex flex-wrap gap-x-5 border-b border-line">
          {
            copy.channels.map((channel) => (
              <label class="-mb-px flex cursor-pointer items-center border-b-2 border-transparent pb-2 text-[13px] text-muted transition-colors duration-(--dur) hover:text-text has-[:checked]:border-accent has-[:checked]:text-accent has-[:focus-visible]:text-accent">
                <input
                  class="sr-only"
                  type="radio"
                  name={`${idPrefix}-channel`}
                  data-field="platform"
                  value={channel.value}
                />
                {channel.label}
              </label>
            ))
          }
        </div>
        <input
          class="field-input mt-3"
          id={`${idPrefix}-handle`}
          data-field="handle"
          type="text"
          autocomplete="off"
          maxlength="80"
          aria-label={copy.handleLabel}
          aria-required="true"
          aria-describedby={`${idPrefix}-handle-error ${idPrefix}-channel-error`}
          placeholder={copy.channels[0].hint}
        />
        <p
          class="mt-1.5 text-[13px] leading-snug text-flag"
          id={`${idPrefix}-channel-error`}
          data-error-for="platform"
          hidden
        ></p>
        <p
          class="mt-1.5 text-[13px] leading-snug text-flag"
          id={`${idPrefix}-handle-error`}
          data-error-for="handle"
          hidden
        ></p>
        <p class="mt-2 text-[12.5px] leading-relaxed text-muted">{copy.channelNotice}</p>
      </fieldset>

      {/* The line between what the reply needs and what it does not. Below it, nothing is
        * required, and the line itself says so, so the two labels under it are not each marked a
        * second time. A reader who wants to be called but has not written the question yet can
        * still send the two fields above. */}
      <div class="flex items-center gap-3 pt-1 text-[12px] text-muted">
        <span class="h-px flex-1 bg-line"></span>
        {copy.optionalHeading}
        <span class="h-px flex-1 bg-line"></span>
      </div>

      <div>
        <label class="field-label" for={`${idPrefix}-name`}>{copy.nameLabel}</label>
        <input
          class="field-input mt-1.5"
          id={`${idPrefix}-name`}
          data-field="name"
          type="text"
          autocomplete="name"
          maxlength="80"
          placeholder={copy.namePlaceholder}
        />
      </div>

      <div>
        <label class="field-label" for={`${idPrefix}-message`}>{copy.messageLabel}</label>
        <textarea
          class="field-input mt-1.5 min-h-[112px]"
          id={`${idPrefix}-message`}
          data-field="message"
          rows="4"
          maxlength="1200"
          placeholder={copy.messagePlaceholder}></textarea>
      </div>

      <div>
        <label class="flex items-start gap-3 text-[13px] leading-relaxed text-muted" for={`${idPrefix}-consent`}>
          <input
            class="mt-0.5 h-4 w-4 shrink-0 rounded-[5px] border border-line-control text-accent accent-accent"
            id={`${idPrefix}-consent`}
            data-consent
            type="checkbox"
            aria-required="true"
            aria-describedby={`${idPrefix}-consent-error`}
          />
          <span>{copy.consentBefore}<a class="text-accent underline" href={privacyHref}>{copy.consentLink}</a>{copy.consentAfter}</span>
        </label>
        <p
          class="mt-1.5 text-[13px] leading-snug text-flag"
          id={`${idPrefix}-consent-error`}
          data-error-for="consent"
          hidden
        ></p>
      </div>
    </div>

    <div class="hidden" aria-hidden="true">
      <label for={`${idPrefix}-website`}>Website</label>
      <input id={`${idPrefix}-website`} data-field="website" type="text" tabindex="-1" autocomplete="off" />
    </div>

    <button type="button" class="btn-primary mt-6 w-full" data-action="submit">
      <span data-submit-label>{copy.submit}</span>
      <Icon name="arrow-right" size={16} />
    </button>

    <p class="mt-3 text-[14px] leading-relaxed text-muted" role="status" aria-live="polite" data-status hidden></p>

    {
      inbox ? (
        <p class="mt-1 text-[12.5px] leading-relaxed text-muted">
          {copy.mailNoteBefore}{' '}
          <a class="text-accent underline decoration-accent/40 underline-offset-2" href={`mailto:${inbox}`}>
            {inbox}
          </a>
          {copy.mailNoteAfter}
        </p>
      ) : null
    }

    <div class="mt-4 border-t border-line pt-4" data-result hidden>
      <p class="text-[13px] font-semibold uppercase tracking-[0.12em] text-muted">{copy.previewHeading}</p>
      <pre
        class="mt-3 max-h-64 overflow-auto rounded-(--radius) border border-line bg-surface p-4 text-[13px] leading-[1.6] whitespace-pre-wrap text-text"
        data-preview
        tabindex="0"
      ></pre>
      <div class="mt-4 flex flex-wrap gap-3">
        {
          inbox ? (
            <a class="btn-primary text-sm" data-send href={`mailto:${inbox}`}>
              {copy.sendMail}
              <Icon name="arrow-up-right" size={16} />
            </a>
          ) : null
        }
        <button type="button" class="btn-ghost text-sm" data-action="copy">{copy.copy}</button>
        <button type="button" class="btn-ghost text-sm" data-action="download">{copy.download}</button>
      </div>
    </div>
  </div>

  <div
    class="rounded-(--radius) border border-line bg-surface-2 p-5"
    data-success
    tabindex="-1"
    hidden
  >
    <p class="text-[17px] font-semibold">{copy.successHeading}</p>
    <p class="mt-2 text-[15px] leading-relaxed text-muted">{copy.successBody}</p>
    <button type="button" class="btn-ghost mt-4 text-sm" data-action="again">{copy.sendAnother}</button>
  </div>
</div>

<script>
  import type { ConsultChrome } from '@/data/intake';

  const FIELD_NAMES = ['name', 'dial', 'phone', 'platform', 'handle', 'message'] as const;
  type FieldName = (typeof FIELD_NAMES)[number];
  type Fields = Record<FieldName, string>;
  type Chrome = ConsultChrome;
  type Errors = Partial<Record<FieldName | 'consent', string>>;

  /* Bumped when the field set changed: a draft saved by the older form carries fields this
   * one no longer has, and restoring it would leave a phone number behind a removed email. */
  const KEY = 'surrogacybase.consult.v3';
  const SYNC = 'surrogacybase:consult-draft';
  const SENT = 'surrogacybase:consult-sent';
  const PHONE = /^[+()\d\s.-]{6,30}$/;

  /** Same token syntax as src/i18n/ui.ts, kept local because a bundle cannot import it. */
  function fill(template: string, vars: Record<string, string>): string {
    return template.replace(/\{(\w+)\}/g, (match, key: string) => (key in vars ? vars[key] : match));
  }

  for (const root of Array.from(document.querySelectorAll<HTMLElement>('[data-consult]'))) {
    const T = JSON.parse(root.dataset.copy!) as Chrome;
    const inbox = root.getAttribute('data-consult') ?? '';
    const endpoint = root.dataset.endpoint ?? '';
    const sourceButton = root.dataset.source ?? '';
    const status = root.querySelector<HTMLElement>('[data-status]')!;
    const body = root.querySelector<HTMLElement>('[data-form-body]')!;
    const success = root.querySelector<HTMLElement>('[data-success]')!;
    const preview = root.querySelector<HTMLPreElement>('[data-preview]')!;
    const result = root.querySelector<HTMLElement>('[data-result]')!;
    const send = root.querySelector<HTMLAnchorElement>('[data-send]');
    const consent = root.querySelector<HTMLInputElement>('[data-consent]')!;
    const website = root.querySelector<HTMLInputElement>('[data-field="website"]')!;
    const submit = root.querySelector<HTMLButtonElement>('[data-action="submit"]')!;
    const submitLabel = root.querySelector<HTMLElement>('[data-submit-label]')!;
    const inputs = Array.from(root.querySelectorAll<HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement>('[data-field]'));

    const box = (name: FieldName) =>
      root.querySelector<HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement>(`[data-field="${name}"]`);

    /** The channel is a radio group: its value is whichever one is checked, never the first. */
    const radios = Array.from(root.querySelectorAll<HTMLInputElement>('input[data-field="platform"]'));
    const handle = root.querySelector<HTMLInputElement>('[data-field="handle"]')!;
    const checkedChannel = () =>
      root.querySelector<HTMLInputElement>('input[data-field="platform"]:checked')?.value ?? '';

    const EMPTY: Fields = { name: '', dial: '', phone: '', platform: '', handle: '', message: '' };

    /** The dial code is part of the number everywhere it is stored or shown. */
    const fullPhone = (v: Fields) => `${v.dial} ${v.phone}`.trim();

    const read = (): Fields => {
      const out = { ...EMPTY };
      for (const name of FIELD_NAMES) {
        if (name === 'platform') continue;
        out[name] = box(name)?.value ?? '';
      }
      out.platform = checkedChannel();
      return out;
    };

    /** One text for every exit: the preview, the mail body, the clipboard and the file. */
    function compose(v: Fields): string {
      const lines: string[] = [];
      if (v.name.trim()) lines.push(fill(T.lineName, { value: v.name.trim() }));
      if (v.phone.trim()) lines.push(fill(T.linePhone, { value: fullPhone(v) }));
      if (v.platform) {
        const option = T.channels.find((o) => o.value === v.platform);
        lines.push(fill(T.lineChannel, { value: option?.label ?? v.platform }));
      }
      if (v.handle.trim()) lines.push(fill(T.lineHandle, { value: v.handle.trim() }));
      if (v.message.trim()) lines.push(fill(T.lineMessage, { value: v.message.trim() }));
      lines.push('', fill(T.lineSource, { value: window.location.pathname }));
      lines.push(T.lineFooter);
      return lines.join('\n');
    }

    function validate(): Errors {
      const errors: Errors = {};
      const v = read();
      const phone = v.phone.trim();
      const digits = (phone.match(/\d/g) ?? []).length;
      if (!phone) errors.phone = T.needPhone;
      else if (!PHONE.test(phone) || digits < 6) errors.phone = T.badPhone;
      if (!v.platform) errors.platform = T.needChannel;
      else if (!v.handle.trim()) errors.handle = T.needHandle;
      if (!consent.checked) errors.consent = T.needConsent;
      return errors;
    }

    function clearErrors() {
      for (const node of Array.from(root.querySelectorAll<HTMLElement>('[data-error-for]'))) {
        node.hidden = true;
        node.textContent = '';
      }
      for (const el of inputs) el.removeAttribute('aria-invalid');
      consent.removeAttribute('aria-invalid');
    }

    function paintErrors(errors: Errors) {
      clearErrors();
      for (const [name, message] of Object.entries(errors)) {
        if (!message) continue;
        const node = root.querySelector<HTMLElement>(`[data-error-for="${name}"]`);
        if (node) {
          node.textContent = message;
          node.hidden = false;
        }
        if (name === 'consent') consent.setAttribute('aria-invalid', 'true');
        else if (name === 'platform') for (const radio of radios) radio.setAttribute('aria-invalid', 'true');
        else box(name as FieldName)?.setAttribute('aria-invalid', 'true');
      }
    }

    function focusFirst(errors: Errors) {
      const order: (FieldName | 'consent')[] = ['phone', 'platform', 'handle', 'consent'];
      const hit = order.find((name) => errors[name]);
      if (!hit) return;
      if (hit === 'consent') consent.focus();
      else if (hit === 'platform') (radios[0] ?? handle).focus();
      else box(hit)?.focus();
    }

    function save(v: Fields | null) {
      try {
        if (v) localStorage.setItem(KEY, JSON.stringify(v));
        else localStorage.removeItem(KEY);
      } catch {
        /* storage blocked: the enquiry still works for this page view */
      }
    }

    function load(): Fields | null {
      try {
        const raw = localStorage.getItem(KEY);
        if (!raw) return null;
        const parsed = JSON.parse(raw) as Partial<Fields>;
        const out = { ...EMPTY };
        for (const name of FIELD_NAMES) {
          if (typeof parsed[name] === 'string') out[name] = parsed[name] as string;
        }
        return out;
      } catch {
        return null;
      }
    }

    function repaint() {
      const v = read();
      preview.textContent = compose(v);
      if (send && inbox) {
        const subject = v.name.trim() ? `${T.subjectFallback}: ${v.name.trim()}` : T.subjectFallback;
        send.href = `mailto:${inbox}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(compose(v))}`;
      }
    }

    /** The placeholder names the chosen app, because the shape of the answer differs by app. */
    function repaintHandleHint() {
      const option = T.channels.find((o) => o.value === checkedChannel());
      handle.setAttribute('placeholder', option?.hint ?? '');
    }

    /* The dial code follows the browser's region, but only while the form is untouched: a draft
     * or a code the reader picked always wins over the guess. */
    function preferredDial(fallback: string): string {
      const select = box('dial') as HTMLSelectElement | null;
      const options = Array.from(select?.options ?? []).map((option) => option.value);
      const regions: Record<string, string> = {
        CN: '+86', HK: '+852', MO: '+852', TW: '+886', SG: '+65',
        US: '+1', CA: '+1', GB: '+44', AU: '+61', NZ: '+61',
      };
      for (const tag of [navigator.language, ...(navigator.languages ?? [])]) {
        const region = (tag.split('-')[1] ?? '').toUpperCase();
        const hit = regions[region];
        if (hit && options.includes(hit)) return hit;
      }
      return fallback;
    }

    /** Nothing is said until there is something about the send worth reading. */
    function say(message: string) {
      status.textContent = message;
      status.hidden = false;
    }

    function hush() {
      status.hidden = true;
      status.textContent = '';
    }

    function setBusy(busy: boolean) {
      submit.disabled = busy;
      submit.setAttribute('aria-busy', busy ? 'true' : 'false');
      submitLabel.textContent = busy ? T.submitting : T.submit;
    }

    function ownerCanFocus(): boolean {
      const dialog = root.closest('dialog');
      const openDialog = document.querySelector('dialog[open]');
      if (dialog) return dialog.open;
      return !openDialog;
    }

    function showSuccess() {
      save(null);
      body.hidden = true;
      success.hidden = false;
      if (ownerCanFocus()) success.focus();
    }

    function showFallback() {
      result.hidden = false;
      repaint();
      say(T.fallbackStatus);
    }

    function reset() {
      for (const name of FIELD_NAMES) {
        const el = box(name);
        if (el) el.value = '';
      }
      for (const radio of radios) radio.checked = false;
      repaintHandleHint();
      consent.checked = false;
      clearErrors();
      save(null);
      result.hidden = true;
      success.hidden = true;
      body.hidden = false;
      hush();
      repaint();
      box('phone')?.focus();
    }

    for (const el of inputs) {
      el.addEventListener('input', () => {
        save(read());
        repaint();
        const name = el.getAttribute('data-field') as FieldName | 'website';
        if (name !== 'website') {
          const node = root.querySelector<HTMLElement>(`[data-error-for="${name}"]`);
          if (node) {
            node.hidden = true;
            node.textContent = '';
          }
          el.removeAttribute('aria-invalid');
        }
        announce();
      });
      el.addEventListener('change', () => {
        save(read());
        repaintHandleHint();
        repaint();
        announce();
      });
    }

    /* A mistyped number is cheaper to fix the moment the reader leaves the field than after they
     * have written the message, so the phone field confirms itself on blur as well as on submit. */
    const phoneInput = box('phone');
    phoneInput?.addEventListener('blur', () => {
      const value = phoneInput.value.trim();
      if (!value) return;
      const digits = (value.match(/\d/g) ?? []).length;
      if (PHONE.test(value) && digits >= 6) return;
      const node = root.querySelector<HTMLElement>('[data-error-for="phone"]');
      if (node) {
        node.textContent = T.badPhone;
        node.hidden = false;
      }
      phoneInput.setAttribute('aria-invalid', 'true');
    });

    consent.addEventListener('change', () => {
      if (consent.checked) {
        const node = root.querySelector<HTMLElement>('[data-error-for="consent"]');
        if (node) {
          node.hidden = true;
          node.textContent = '';
        }
        consent.removeAttribute('aria-invalid');
      }
    });

    /* The inline form and the dialog form hold the same draft, so neither may be left showing
     * what the other one typed. */
    window.addEventListener(SYNC, (event) => {
      const v = (event as CustomEvent<Fields>).detail;
      for (const name of FIELD_NAMES) {
        if (name === 'platform') continue;
        const el = box(name);
        if (el && el.value !== v[name] && document.activeElement !== el) el.value = v[name];
      }
      for (const radio of radios) radio.checked = radio.value === v.platform;
      repaintHandleHint();
      repaint();
    });

    window.addEventListener(SENT, () => showSuccess());

    function announce() {
      window.dispatchEvent(new CustomEvent(SYNC, { detail: read() }));
    }

    root.addEventListener('click', async (event) => {
      const trigger = (event.target as HTMLElement).closest<HTMLElement>('[data-action]');
      if (!trigger) return;
      const action = trigger.getAttribute('data-action');

      if (action === 'submit') {
        const errors = validate();
        if (Object.keys(errors).length > 0) {
          paintErrors(errors);
          say(T.invalidStatus);
          focusFirst(errors);
          return;
        }
        clearErrors();
        setBusy(true);
        say(T.submitting);
        try {
          const v = read();
          const response = await fetch(endpoint, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              ...v,
              consent: true,
              website: website.value,
              sourcePage: window.location.pathname,
              sourceTitle: document.title,
              language: document.documentElement.lang,
              sourceButton,
            }),
          });

          /* A static host answers unknown paths with a 200 HTML page, so only the endpoint's own
           * JSON confirmation may be read as delivered. */
          const data = (await response.json().catch(() => null)) as {
            ok?: boolean;
            fields?: string[];
          } | null;

          if (response.ok && data?.ok === true) {
            showSuccess();
            window.dispatchEvent(new CustomEvent(SENT));
            return;
          }

          if (response.status === 400) {
            const fields = Array.isArray(data?.fields) ? data.fields : [];
            if (fields.length > 0) {
              const messages: Errors = {};
              for (const field of fields) {
                if (field === 'consent') messages.consent = T.needConsent;
                else if (field === 'phone') messages.phone = T.badPhone;
                else if (field === 'platform') messages.platform = T.needChannel;
                else if (field === 'handle') messages.handle = T.needHandle;
              }
              paintErrors(messages);
              say(T.invalidStatus);
              focusFirst(messages);
              return;
            }
          }

          showFallback();
        } catch {
          showFallback();
        } finally {
          setBusy(false);
        }
        return;
      }

      if (action === 'again') {
        reset();
        return;
      }

      if (action === 'copy') {
        const text = compose(read());
        let ok = false;
        try {
          await navigator.clipboard.writeText(text);
          ok = true;
        } catch {
          /* clipboard blocked: the preview above is the manual fallback */
        }
        say(ok ? T.copied : T.clipboardBlocked);
        return;
      }

      if (action === 'download') {
        const blob = new Blob([`# ${T.exportHeading}\n\n${compose(read())}\n`], { type: 'text/markdown' });
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = T.filename;
        a.click();
        URL.revokeObjectURL(url);
        say(fill(T.downloaded, { file: T.filename }));
      }
    });

    const saved = load();
    if (saved) {
      for (const name of FIELD_NAMES) {
        if (name === 'platform') continue;
        const el = box(name);
        if (el) el.value = saved[name];
      }
      for (const radio of radios) radio.checked = radio.value === saved.platform;
    } else {
      const dial = box('dial') as HTMLSelectElement | null;
      if (dial) dial.value = preferredDial(dial.value);
    }
    repaintHandleHint();
    repaint();
  }
</script>
