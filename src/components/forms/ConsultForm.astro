---
/*
 * The enquiry form: the only one on this site that collects anything. It sits in the
 * homepage band and, through the header, in a dialog on every page, so it takes an id prefix
 * rather than assuming it is alone on the page.
 *
 * It posts the fields to /api/enquiry, where a Cloudflare Pages Function delivers them to the
 * site's own Feishu and WeCom inboxes. Those credentials are server-side only and are never
 * baked into this bundle. When the endpoint is not configured, or delivery fails, the form
 * falls back to the version this site had before it had a server: it shows the exact message in
 * the browser and lets the reader open it in their own mail app, copy it, or download it. The
 * status line says which of those happened rather than confirming a message that never arrived.
 *
 * The draft is stored in this browser so a half-written enquiry survives a reload. No identity
 * document, medical record or payment detail is asked for, because none of them is needed to
 * open a conversation.
 *
 * The wording lives in src/data/intake.ts. The script needs some of it at runtime to assemble
 * the message, so the chrome is serialized into the DOM and the bundle stays one file for both
 * languages.
 */
import Icon from '@/components/ui/Icon.astro';
import { SITE } from '@/const';
import { CONSULT_CHROME } from '@/data/intake';
import { langFromPath, localizedPath } from '@/i18n/paths';
import { DIAL_OPTIONS } from '@/lib/dial-codes';

interface Props {
  /** Field ids are printed into the page, so the dialog copy cannot reuse the inline one's. */
  idPrefix?: string;
  /** The dialog already draws a panel, so the form inside it stops drawing its own. */
  framed?: boolean;
}

const { idPrefix = 'cq', framed = true } = Astro.props;
const inbox = SITE.contactEmail;
const lang = langFromPath(Astro.url.pathname);
const copy = CONSULT_CHROME[lang];
const privacyHref = localizedPath(lang, '/privacy');
const source = idPrefix === 'dlg' ? 'dialog' : 'home';
const initialDial = DIAL_OPTIONS.find((option) => option.dial === copy.defaultDial) ?? DIAL_OPTIONS[0];

/**
 * Marks for the five apps, kept beside their names so a row of names is scannable
 * before the reader has read any of them. The paths are the simple-icons brand marks (CC0).
 * Messenger cuts its bolt out of the bubble, so its two subpaths need the even-odd rule to
 * stay a hole.
 */
const MARKS: Record<string, { d: string; evenOdd?: boolean }> = {
  wechat: {
    d: 'M8.691 2.188C3.891 2.188 0 5.476 0 9.53c0 2.212 1.17 4.203 3.002 5.55a.59.59 0 0 1 .213.665l-.39 1.48c-.019.07-.048.141-.048.213 0 .163.13.295.29.295a.326.326 0 0 0 .167-.054l1.903-1.114a.864.864 0 0 1 .717-.098 10.16 10.16 0 0 0 2.837.403c.276 0 .543-.027.811-.05-.857-2.578.157-4.972 1.932-6.446 1.703-1.415 3.882-1.98 5.853-1.838-.576-3.583-4.196-6.348-8.596-6.348zM5.785 5.991c.642 0 1.162.529 1.162 1.18a1.17 1.17 0 0 1-1.162 1.178A1.17 1.17 0 0 1 4.623 7.17c0-.651.52-1.18 1.162-1.18zm5.813 0c.642 0 1.162.529 1.162 1.18a1.17 1.17 0 0 1-1.162 1.178 1.17 1.17 0 0 1-1.162-1.178c0-.651.52-1.18 1.162-1.18zm5.34 2.867c-1.797-.052-3.746.512-5.28 1.786-1.72 1.428-2.687 3.72-1.78 6.22.942 2.453 3.666 4.229 6.884 4.229.826 0 1.622-.12 2.361-.336a.722.722 0 0 1 .598.082l1.584.926a.272.272 0 0 0 .14.047c.134 0 .24-.111.24-.247 0-.06-.023-.12-.038-.177l-.327-1.233a.582.582 0 0 1-.023-.156.49.49 0 0 1 .201-.398C23.024 18.48 24 16.82 24 14.98c0-3.21-2.931-5.837-6.656-6.088V8.89c-.135-.01-.27-.027-.407-.03zm-2.53 3.274c.535 0 .969.44.969.982a.976.976 0 0 1-.969.983.976.976 0 0 1-.969-.983c0-.542.434-.982.97-.982zm4.844 0c.535 0 .969.44.969.982a.976.976 0 0 1-.969.983.976.976 0 0 1-.969-.983c0-.542.434-.982.969-.982z',
  },
  line: {
    d: 'M19 3H5a4 4 0 00-4 4v6c0 2.21 1.79 4 4 4h.59l2.71 2.71c.39.39 1.02.39 1.41 0L12.41 17H19a4 4 0 004-4V7a4 4 0 00-4-4zm-7 10H9V8h3v5zm4 0h-2V8h2v5z',
  },
  whatsapp: {
    d: 'M17.5 14.4c-.3-.1-1.7-.8-2-1-.3-.1-.5-.1-.7.1l-1 1.2c-.2.2-.3.2-.6.1s-1.2-.5-2.3-1.4c-.8-.8-1.4-1.7-1.6-2-.2-.3 0-.4.1-.6l.4-.5c.1-.2.2-.3.3-.5s0-.3 0-.5L9 7.5c-.2-.4-.3-.4-.5-.4H7.5c-.2 0-.5.1-.7.3-.3.3-1 1-1 2.4s1 2.8 1.2 3c.1.2 2 3.1 4.9 4.3 2.9 1.2 2.9.8 3.4.8s1.7-.7 1.9-1.4c.2-.7.2-1.2.2-1.4-.1-.1-.3-.2-.5-.3zM12 2a10 10 0 00-8.6 15L2 22l5.2-1.4A10 10 0 1012 2z',
  },
  messenger: {
    d: 'M12 2C6.48 2 2 6.14 2 11.2c0 2.82 1.4 5.35 3.6 7.03V22l3.28-1.8c.96.27 1.98.4 3.04.4h.08c5.52 0 10-4.14 10-9.2C22 6.14 17.52 2 12 2zm1.1 12.3l-2.5-2.7-4.9 2.7 5.4-5.7 2.6 2.7 4.8-2.7-5.4 5.7z',
    evenOdd: true,
  },
  telegram: {
    d: 'M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm4.64 6.8c-.15 1.58-.8 5.42-1.13 7.19-.14.75-.42 1-.68 1.03-.58.05-1.02-.38-1.58-.75-.88-.58-1.38-.94-2.23-1.5-.99-.65-.35-1.01.22-1.59.15-.15 2.71-2.48 2.76-2.69a.2.2 0 00-.05-.18c-.06-.05-.14-.03-.21-.02-.09.02-1.49.95-4.22 2.79-.4.27-.76.41-1.08.4-.36-.01-1.04-.2-1.55-.37-.63-.2-1.12-.31-1.08-.66.02-.18.27-.36.74-.55 2.92-1.27 4.86-2.11 5.83-2.51 2.78-1.16 3.35-1.36 3.73-1.36.08 0 .27.02.39.12.1.08.13.19.14.27-.01.06.01.24 0 .38z',
  },
};
---

<div
  class:list={[framed ? 'rounded-(--radius-card) border border-line bg-paper p-6 text-text shadow-lift sm:p-7' : 'text-text']}
  data-consult={inbox}
  data-endpoint="/api/enquiry"
  data-source={source}
  data-copy={JSON.stringify(copy)}
>
  <div data-form-body>
    <div class="grid gap-5">
      {/* The dial picker is narrow and the number takes the rest of the row. The script sets the
        * code from the browser's region before the reader touches it, so a reader in Hong Kong is
        * not asked to change +86 by hand. */}
      <div>
        <label class="field-label" for={`${idPrefix}-phone`}>
          {copy.phoneLabel}
          <span class="text-flag" aria-hidden="true">{copy.required}</span>
        </label>
        <div class="mt-1.5 flex gap-2">
          <div class="relative shrink-0" data-dial-picker>
            <button
              type="button"
              class="field-input flex h-full w-[104px] cursor-pointer items-center gap-1.5 py-2.5 pr-2 pl-2.5 text-[13px] font-medium"
              data-dial-open
              aria-haspopup="listbox"
              aria-expanded="false"
              aria-controls={`${idPrefix}-dial-list`}
              aria-label={copy.dialLabel}
            >
              <img
                class="h-4 w-5 shrink-0 rounded-[3px] object-cover"
                src={`/flags/${initialDial.code.toLowerCase()}.svg`}
                alt=""
                width={20}
                height={15}
                data-dial-flag
              />
              <span class="tabular-nums" data-dial-code>{initialDial.dial}</span>
              <Icon name="chevron-down" size={13} class="shrink-0 text-muted" />
            </button>
            <input
              type="hidden"
              data-field="dial"
              value={initialDial.dial}
              data-code={initialDial.code}
            />
            <div
              class="absolute left-0 top-[calc(100%+4px)] z-30 w-[min(288px,78vw)] rounded-(--radius) border border-line bg-paper p-2 shadow-lift"
              data-dial-panel
              hidden
            >
              <label class="sr-only" for={`${idPrefix}-dial-search`}>{copy.dialSearch}</label>
              <input
                class="field-input text-[13px]"
                id={`${idPrefix}-dial-search`}
                type="search"
                autocomplete="off"
                placeholder={copy.dialSearch}
                data-dial-search
              />
              <ul
                class="mt-2 max-h-60 overflow-y-auto overflow-x-hidden outline-none"
                id={`${idPrefix}-dial-list`}
                role="listbox"
                data-dial-list
              ></ul>
            </div>
          </div>
          <input
            class="field-input flex-1"
            id={`${idPrefix}-phone`}
            data-field="phone"
            type="tel"
            autocomplete="tel"
            inputmode="tel"
            maxlength="24"
            aria-required="true"
            aria-describedby={`${idPrefix}-phone-error`}
            placeholder={copy.phonePlaceholder}
          />
        </div>
        <p
          class="mt-1.5 text-[13px] leading-snug text-flag"
          id={`${idPrefix}-phone-error`}
          data-error-for="phone"
          hidden
        ></p>
      </div>

      {/* One account is enough. The tabs are ordered by the language the page is in, and the input
        * below them is relabelled per app in its placeholder: a WeChat ID is not a phone number and
        * a Telegram handle starts with @, so one generic "{app} number" would be wrong twice. */}
      <fieldset class="min-w-0">
        <legend class="field-label">
          {copy.channelLabel}
          <span class="text-flag" aria-hidden="true">{copy.required}</span>
          <span class="font-normal text-muted">{copy.channelHint}</span>
        </legend>
        <div class="mt-2 -mx-1 flex gap-1 overflow-x-auto overflow-y-hidden border-b border-line px-1">
          {
            copy.channels.map((channel) => (
              <label
                class="-mb-px flex shrink-0 cursor-pointer items-center gap-1.5 border-b-2 border-transparent px-2.5 pb-2 text-[13px] text-muted transition-colors duration-(--dur) hover:text-text has-[:checked]:border-accent has-[:checked]:text-accent has-[:focus-visible]:text-accent"
                data-channel-tab={channel.value}
              >
                <input
                  class="sr-only"
                  type="radio"
                  name={`${idPrefix}-channel`}
                  data-field="platform"
                  value={channel.value}
                />
                <svg
                  class="shrink-0"
                  width={14}
                  height={14}
                  viewBox="0 0 24 24"
                  fill="currentColor"
                  aria-hidden="true"
                >
                  <path d={MARKS[channel.value].d} fill-rule={MARKS[channel.value].evenOdd ? 'evenodd' : undefined} />
                </svg>
                {channel.label}
              </label>
            ))
          }
        </div>
        <input
          class="field-input mt-3"
          id={`${idPrefix}-handle`}
          data-field="handle"
          type="text"
          autocomplete="off"
          maxlength="80"
          aria-label={copy.handleLabel}
          aria-required="true"
          aria-describedby={`${idPrefix}-handle-error ${idPrefix}-channel-error`}
          placeholder={copy.channels[0].hint}
        />
        <p
          class="mt-1.5 text-[13px] leading-snug text-flag"
          id={`${idPrefix}-channel-error`}
          data-error-for="platform"
          hidden
        ></p>
        <p
          class="mt-1.5 text-[13px] leading-snug text-flag"
          id={`${idPrefix}-handle-error`}
          data-error-for="handle"
          hidden
        ></p>
        <p class="mt-2 text-[12.5px] leading-relaxed text-muted">{copy.channelNotice}</p>
      </fieldset>

      {/* The line between what the reply needs and what it does not. Below it, nothing is
        * required, and the line itself says so, so the two labels under it are not each marked a
        * second time. A reader who wants to be called but has not written the question yet can
        * still send the two fields above. */}
      <div class="flex items-center gap-3 pt-1 text-[12px] text-muted">
        <span class="h-px flex-1 bg-line"></span>
        {copy.optionalHeading}
        <span class="h-px flex-1 bg-line"></span>
      </div>

      <div>
        <label class="field-label" for={`${idPrefix}-name`}>{copy.nameLabel}</label>
        <input
          class="field-input mt-1.5"
          id={`${idPrefix}-name`}
          data-field="name"
          type="text"
          autocomplete="name"
          maxlength="80"
          placeholder={copy.namePlaceholder}
        />
      </div>

      <div>
        <label class="field-label" for={`${idPrefix}-message`}>{copy.messageLabel}</label>
        <textarea
          class="field-input mt-1.5 min-h-[112px]"
          id={`${idPrefix}-message`}
          data-field="message"
          rows="4"
          maxlength="1200"
          placeholder={copy.messagePlaceholder}></textarea>
      </div>

      <div>
        <label class="flex items-start gap-3 text-[13px] leading-relaxed text-muted" for={`${idPrefix}-consent`}>
          <input
            class="mt-0.5 h-4 w-4 shrink-0 rounded-[5px] border border-line-control text-accent accent-accent"
            id={`${idPrefix}-consent`}
            data-consent
            type="checkbox"
            aria-required="true"
            aria-describedby={`${idPrefix}-consent-error`}
          />
          <span>{copy.consentBefore}<a class="text-accent underline" href={privacyHref}>{copy.consentLink}</a>{copy.consentAfter}</span>
        </label>
        <p
          class="mt-1.5 text-[13px] leading-snug text-flag"
          id={`${idPrefix}-consent-error`}
          data-error-for="consent"
          hidden
        ></p>
      </div>
    </div>

    <div class="hidden" aria-hidden="true">
      <label for={`${idPrefix}-website`}>Website</label>
      <input id={`${idPrefix}-website`} data-field="website" type="text" tabindex="-1" autocomplete="off" />
    </div>

    <button type="button" class="btn-primary mt-6 w-full" data-action="submit">
      <span data-submit-label>{copy.submit}</span>
      <Icon name="arrow-right" size={16} />
    </button>

    <p class="mt-3 text-[14px] leading-relaxed text-muted" role="status" aria-live="polite" data-status hidden></p>

    {
      inbox ? (
        <p class="mt-1 text-[12.5px] leading-relaxed text-muted">
          {copy.mailNoteBefore}{' '}
          <a class="text-accent underline decoration-accent/40 underline-offset-2" href={`mailto:${inbox}`}>
            {inbox}
          </a>
          {copy.mailNoteAfter}
        </p>
      ) : null
    }

    <div class="mt-4 border-t border-line pt-4" data-result hidden>
      <p class="text-[13px] font-semibold uppercase tracking-[0.12em] text-muted">{copy.previewHeading}</p>
      <pre
        class="mt-3 max-h-64 overflow-auto rounded-(--radius) border border-line bg-surface p-4 text-[13px] leading-[1.6] whitespace-pre-wrap text-text"
        data-preview
        tabindex="0"
      ></pre>
      <div class="mt-4 flex flex-wrap gap-3">
        {
          inbox ? (
            <a class="btn-primary text-sm" data-send href={`mailto:${inbox}`}>
              {copy.sendMail}
              <Icon name="arrow-up-right" size={16} />
            </a>
          ) : null
        }
        <button type="button" class="btn-ghost text-sm" data-action="copy">{copy.copy}</button>
        <button type="button" class="btn-ghost text-sm" data-action="download">{copy.download}</button>
      </div>
    </div>
  </div>

  <div
    class="rounded-(--radius) border border-line bg-surface-2 p-5"
    data-success
    tabindex="-1"
    hidden
  >
    <p class="text-[17px] font-semibold">{copy.successHeading}</p>
    <p class="mt-2 text-[15px] leading-relaxed text-muted">{copy.successBody}</p>
    <button type="button" class="btn-ghost mt-4 text-sm" data-action="again">{copy.sendAnother}</button>
  </div>
</div>

<script>
  import type { ConsultChrome } from '@/data/intake';
  import { DIAL_OPTIONS, type DialOption } from '@/lib/dial-codes';

  const FIELD_NAMES = ['name', 'dial', 'phone', 'platform', 'handle', 'message'] as const;
  type FieldName = (typeof FIELD_NAMES)[number];
  type Fields = Record<FieldName, string>;
  /** The draft plus the country the reader picked, which a shared code cannot carry on its own. */
  type Draft = Fields & { dialCode?: string };
  type Chrome = ConsultChrome;
  type Errors = Partial<Record<FieldName | 'consent', string>>;

  /* Bumped when the field set changed: a draft saved by the older form carries fields this
   * one no longer has, and restoring it would leave a phone number behind a removed email. */
  const KEY = 'surrogacybase.consult.v3';
  const SYNC = 'surrogacybase:consult-draft';
  const SENT = 'surrogacybase:consult-sent';
  const PHONE = /^[+()\d\s.-]{6,30}$/;

  /** Same token syntax as src/i18n/ui.ts, kept local because a bundle cannot import it. */
  function fill(template: string, vars: Record<string, string>): string {
    return template.replace(/\{(\w+)\}/g, (match, key: string) => (key in vars ? vars[key] : match));
  }

  /* Where the network sees the reader, asked of this site's own endpoint. One call serves every
   * copy of the form on the page, and a refusal or a missing endpoint answers null. */
  function visitorRegion(): Promise<string | null> {
    const seen = window as Window & { __surrogacybaseRegion?: Promise<string | null> };
    if (!seen.__surrogacybaseRegion) {
      seen.__surrogacybaseRegion = fetch('/api/region', { cache: 'no-store' })
        .then((response) => (response.ok ? response.json() : null))
        .then((data: { country?: unknown } | null) =>
          typeof data?.country === 'string' ? data.country : null,
        )
        .catch(() => null);
    }
    return seen.__surrogacybaseRegion;
  }

  /*
   * The app a visitor is likeliest to already have installed, so its tab comes first. Only the
   * places where one app clearly outranks the others are listed; everywhere else keeps the order
   * the page's own language sets. LINE leads in Japan, where it is used by over 70% of the
   * population, and in Thailand and Taiwan, which with Japan make up its largest user bases
   * (Rest of World, 2023; LY Corporation FY2025 Q2 presentation). WeChat is the default contact
   * app in China. KakaoTalk leads in South Korea and is not one of the five, so Korea keeps the
   * language order rather than promoting an app the reader may not have.
   */
  const REGION_CHANNEL: Record<string, string> = {
    CN: 'wechat',
    JP: 'line',
    TH: 'line',
    TW: 'line',
  };

  for (const root of Array.from(document.querySelectorAll<HTMLElement>('[data-consult]'))) {
    const T = JSON.parse(root.dataset.copy!) as Chrome;
    const inbox = root.getAttribute('data-consult') ?? '';
    const endpoint = root.dataset.endpoint ?? '';
    const sourceButton = root.dataset.source ?? '';
    const status = root.querySelector<HTMLElement>('[data-status]')!;
    const body = root.querySelector<HTMLElement>('[data-form-body]')!;
    const success = root.querySelector<HTMLElement>('[data-success]')!;
    const preview = root.querySelector<HTMLPreElement>('[data-preview]')!;
    const result = root.querySelector<HTMLElement>('[data-result]')!;
    const send = root.querySelector<HTMLAnchorElement>('[data-send]');
    const consent = root.querySelector<HTMLInputElement>('[data-consent]')!;
    const website = root.querySelector<HTMLInputElement>('[data-field="website"]')!;
    const submit = root.querySelector<HTMLButtonElement>('[data-action="submit"]')!;
    const submitLabel = root.querySelector<HTMLElement>('[data-submit-label]')!;
    const inputs = Array.from(root.querySelectorAll<HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement>('[data-field]'));

    const box = (name: FieldName) =>
      root.querySelector<HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement>(`[data-field="${name}"]`);

    /** The channel is a radio group: its value is whichever one is checked, never the first. */
    let radios = Array.from(root.querySelectorAll<HTMLInputElement>('input[data-field="platform"]'));
    const handle = root.querySelector<HTMLInputElement>('[data-field="handle"]')!;
    const checkedChannel = () =>
      root.querySelector<HTMLInputElement>('input[data-field="platform"]:checked')?.value ?? '';

    const EMPTY: Fields = { name: '', dial: '', phone: '', platform: '', handle: '', message: '' };

    /** The dial code is part of the number everywhere it is stored or shown. */
    const fullPhone = (v: Fields) => `${v.dial} ${v.phone}`.trim();

    const read = (): Fields => {
      const out = { ...EMPTY };
      for (const name of FIELD_NAMES) {
        if (name === 'platform') continue;
        out[name] = box(name)?.value ?? '';
      }
      out.platform = checkedChannel();
      return out;
    };

    /* A code on its own does not say which country it came from, and several share one, so the
     * draft and the other copy of the form are handed the reader's pick alongside the number. */
    const draftNow = (): Draft => ({ ...read(), dialCode: dialField.dataset.code });

    /** One text for every exit: the preview, the mail body, the clipboard and the file. */
    function compose(v: Fields): string {
      const lines: string[] = [];
      if (v.name.trim()) lines.push(fill(T.lineName, { value: v.name.trim() }));
      if (v.phone.trim()) lines.push(fill(T.linePhone, { value: fullPhone(v) }));
      if (v.platform) {
        const option = T.channels.find((o) => o.value === v.platform);
        lines.push(fill(T.lineChannel, { value: option?.label ?? v.platform }));
      }
      if (v.handle.trim()) lines.push(fill(T.lineHandle, { value: v.handle.trim() }));
      if (v.message.trim()) lines.push(fill(T.lineMessage, { value: v.message.trim() }));
      lines.push('', fill(T.lineSource, { value: window.location.pathname }));
      lines.push(T.lineFooter);
      return lines.join('\n');
    }

    function validate(): Errors {
      const errors: Errors = {};
      const v = read();
      const phone = v.phone.trim();
      const digits = (phone.match(/\d/g) ?? []).length;
      if (!phone) errors.phone = T.needPhone;
      else if (!PHONE.test(phone) || digits < 6) errors.phone = T.badPhone;
      if (!v.platform) errors.platform = T.needChannel;
      else if (!v.handle.trim()) errors.handle = T.needHandle;
      if (!consent.checked) errors.consent = T.needConsent;
      return errors;
    }

    function clearErrors() {
      for (const node of Array.from(root.querySelectorAll<HTMLElement>('[data-error-for]'))) {
        node.hidden = true;
        node.textContent = '';
      }
      for (const el of inputs) el.removeAttribute('aria-invalid');
      consent.removeAttribute('aria-invalid');
    }

    function paintErrors(errors: Errors) {
      clearErrors();
      for (const [name, message] of Object.entries(errors)) {
        if (!message) continue;
        const node = root.querySelector<HTMLElement>(`[data-error-for="${name}"]`);
        if (node) {
          node.textContent = message;
          node.hidden = false;
        }
        if (name === 'consent') consent.setAttribute('aria-invalid', 'true');
        else if (name === 'platform') for (const radio of radios) radio.setAttribute('aria-invalid', 'true');
        else box(name as FieldName)?.setAttribute('aria-invalid', 'true');
      }
    }

    function focusFirst(errors: Errors) {
      const order: (FieldName | 'consent')[] = ['phone', 'platform', 'handle', 'consent'];
      const hit = order.find((name) => errors[name]);
      if (!hit) return;
      if (hit === 'consent') consent.focus();
      else if (hit === 'platform') (radios[0] ?? handle).focus();
      else box(hit)?.focus();
    }

    function save(v: Fields | null) {
      try {
        if (v) localStorage.setItem(KEY, JSON.stringify(v));
        else localStorage.removeItem(KEY);
      } catch {
        /* storage blocked: the enquiry still works for this page view */
      }
    }

    function load(): Draft | null {
      try {
        const raw = localStorage.getItem(KEY);
        if (!raw) return null;
        const parsed = JSON.parse(raw) as Partial<Draft>;
        const out: Draft = { ...EMPTY };
        for (const name of FIELD_NAMES) {
          if (typeof parsed[name] === 'string') out[name] = parsed[name] as string;
        }
        if (typeof parsed.dialCode === 'string') out.dialCode = parsed.dialCode;
        return out;
      } catch {
        return null;
      }
    }

    function repaint() {
      const v = read();
      preview.textContent = compose(v);
      if (send && inbox) {
        const subject = v.name.trim() ? `${T.subjectFallback}: ${v.name.trim()}` : T.subjectFallback;
        send.href = `mailto:${inbox}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(compose(v))}`;
      }
    }

    /** The placeholder names the chosen app, because the shape of the answer differs by app. */
    function repaintHandleHint() {
      const option = T.channels.find((o) => o.value === checkedChannel());
      handle.setAttribute('placeholder', option?.hint ?? '');
    }

    /* The dial picker: a flag and a code in the trigger, every country searchable, listed in the
     * language the page is in. It is a button and a listbox rather than a select because a select
     * cannot show the flag next to the code it is choosing. */
    const dialPicker = root.querySelector<HTMLElement>('[data-dial-picker]')!;
    const dialField = dialPicker.querySelector<HTMLInputElement>('input[data-field="dial"]')!;
    const dialOpen = dialPicker.querySelector<HTMLButtonElement>('[data-dial-open]')!;
    const dialFlag = dialPicker.querySelector<HTMLImageElement>('[data-dial-flag]')!;
    const dialCode = dialPicker.querySelector<HTMLElement>('[data-dial-code]')!;
    const dialPanel = dialPicker.querySelector<HTMLElement>('[data-dial-panel]')!;
    const dialSearch = dialPicker.querySelector<HTMLInputElement>('[data-dial-search]')!;
    const dialList = dialPicker.querySelector<HTMLElement>('[data-dial-list]')!;
    const dialFallback = { code: dialField.dataset.code ?? '', dial: dialField.value };
    const namedInZh = document.documentElement.lang.startsWith('zh');

    const dialByCode = (code: string) => DIAL_OPTIONS.find((option) => option.code === code);

    function paintDial(code: string, dial: string) {
      dialField.value = dial;
      dialField.dataset.code = code;
      dialFlag.src = `/flags/${code.toLowerCase()}.svg`;
      dialFlag.alt = code.toUpperCase();
      dialCode.textContent = dial;
    }

    /** The face for a code that arrived from the other form or from a saved draft. Several
     * countries share one code, so `from` carries the reader's own choice when anything knows it. */
    function paintDialByValue(dial: string, from?: string) {
      const named = from ? dialByCode(from) : undefined;
      const carried = dialByCode(dialField.dataset.code ?? '');
      const option =
        named?.dial === dial
          ? named
          : carried?.dial === dial
            ? carried
            : DIAL_OPTIONS.find((o) => o.dial === dial);
      if (option) paintDial(option.code, option.dial);
    }

    function dialRow(option: DialOption, selected: boolean): HTMLLIElement {
      const row = document.createElement('li');
      row.setAttribute('role', 'option');
      row.tabIndex = -1;
      row.setAttribute('aria-selected', selected ? 'true' : 'false');
      row.dataset.code = option.code;
      row.dataset.dial = option.dial;
      row.className =
        'flex cursor-pointer items-center gap-2 rounded-[7px] px-2 py-1.5 text-[13px] outline-none hover:bg-surface-2 focus:bg-surface-2' +
        (selected ? ' text-accent' : '');

      const flag = document.createElement('img');
      flag.src = `/flags/${option.code.toLowerCase()}.svg`;
      flag.alt = '';
      flag.width = 20;
      flag.height = 15;
      flag.loading = 'lazy';
      flag.className = 'h-4 w-5 shrink-0 rounded-[3px] object-cover';

      const name = document.createElement('span');
      name.className = 'min-w-0 flex-1 truncate';
      name.textContent = namedInZh ? option.nameZh : option.name;

      const code = document.createElement('span');
      code.className = 'shrink-0 tabular-nums text-muted';
      code.textContent = option.dial;

      row.append(flag, name, code);
      return row;
    }

    function renderDialList(query: string) {
      const q = query.trim().toLowerCase();
      const matches = q
        ? DIAL_OPTIONS.filter(
            (option) =>
              option.name.toLowerCase().includes(q) ||
              option.nameZh.includes(query.trim()) ||
              option.dial.includes(q),
          )
        : DIAL_OPTIONS;
      const selected = dialField.dataset.code ?? '';
      dialList.replaceChildren(...matches.map((option) => dialRow(option, option.code === selected)));
      dialList.dataset.cursor = '0';
    }

    function openDial() {
      renderDialList(dialSearch.value);
      dialPanel.hidden = false;
      dialOpen.setAttribute('aria-expanded', 'true');
      dialSearch.focus();
    }

    function closeDial(back: boolean) {
      dialPanel.hidden = true;
      dialOpen.setAttribute('aria-expanded', 'false');
      dialSearch.value = '';
      if (back) dialOpen.focus();
    }

    /** The reader is typing in the search box, so the arrows move a highlight, not the caret. */
    function moveDialFocus(step: number) {
      const rows = Array.from(dialList.querySelectorAll<HTMLElement>('[role="option"]'));
      if (rows.length === 0) return;
      const at = Number(dialList.dataset.cursor ?? '0');
      const next = Math.min(rows.length - 1, Math.max(0, at + step));
      dialList.dataset.cursor = String(next);
      rows[next].focus();
      rows[next].scrollIntoView({ block: 'nearest' });
    }

    function chooseDial(row: HTMLElement) {
      dialChosen = true;
      paintDial(row.dataset.code ?? '', row.dataset.dial ?? '');
      closeDial(true);
      save(draftNow());
      repaint();
      announce();
    }

    dialOpen.addEventListener('click', () => {
      if (dialPanel.hidden) openDial();
      else closeDial(true);
    });

    dialSearch.addEventListener('input', () => renderDialList(dialSearch.value));

    dialList.addEventListener('click', (event) => {
      const row = (event.target as HTMLElement).closest<HTMLElement>('[role="option"]');
      if (row) chooseDial(row);
    });

    dialPicker.addEventListener('keydown', (event) => {
      const key = (event as KeyboardEvent).key;
      if (dialPanel.hidden) {
        if (key === 'ArrowDown' || key === 'ArrowUp') {
          event.preventDefault();
          openDial();
        }
        return;
      }
      if (key === 'Escape') {
        event.preventDefault();
        closeDial(true);
      } else if (key === 'ArrowDown' || key === 'ArrowUp') {
        event.preventDefault();
        moveDialFocus(key === 'ArrowDown' ? 1 : -1);
      } else if (key === 'Enter') {
        const row = document.activeElement as HTMLElement | null;
        if (row?.getAttribute('role') === 'option') {
          event.preventDefault();
          chooseDial(row);
        }
      } else if (key === 'Tab') {
        closeDial(false);
      }
    });

    document.addEventListener('click', (event) => {
      if (dialPanel.hidden) return;
      if (!dialPicker.contains(event.target as Node)) closeDial(false);
    });

    /* The browser's region is read as a country and looked up like any other, so no hand-kept
     * table of codes can go stale on a country this list already knows. */
    function guessedDial(): DialOption | null {
      for (const tag of [navigator.language, ...(navigator.languages ?? [])]) {
        const hit = dialByCode((tag.split('-')[1] ?? '').toUpperCase());
        if (hit) return hit;
      }
      return null;
    }

    /* The network's answer outranks the browser's, because a browser is set up once and a phone
     * travels. Neither outranks the reader: a code they picked, in this form or the other copy of
     * it, is left alone. */
    let ipDial: DialOption | null = null;
    let dialChosen = false;

    /** The likeliest app first, without disturbing whichever one is already checked. */
    function raiseChannel(value: string) {
      const tab = root.querySelector<HTMLElement>(`[data-channel-tab="${value}"]`);
      const strip = tab?.parentElement;
      if (!tab || !strip || strip.firstElementChild === tab) return;
      strip.prepend(tab);
      radios = Array.from(root.querySelectorAll<HTMLInputElement>('input[data-field="platform"]'));
    }

    function applyRegion(country: string | null) {
      if (!country) return;
      /* Reshuffling the tabs is welcome while they are still blank and intrusive once the reader
       * has answered them, so an answered group keeps the order the page was written in. */
      const channel = REGION_CHANNEL[country];
      if (channel && !checkedChannel()) raiseChannel(channel);
      const option = dialByCode(country);
      if (!option) return;
      ipDial = option;
      if (dialChosen || load()?.dialCode) return;
      paintDial(option.code, option.dial);
      repaint();
      announce();
    }

    /** Nothing is said until there is something about the send worth reading. */
    function say(message: string) {
      status.textContent = message;
      status.hidden = false;
    }

    function hush() {
      status.hidden = true;
      status.textContent = '';
    }

    function setBusy(busy: boolean) {
      submit.disabled = busy;
      submit.setAttribute('aria-busy', busy ? 'true' : 'false');
      submitLabel.textContent = busy ? T.submitting : T.submit;
    }

    function ownerCanFocus(): boolean {
      const dialog = root.closest('dialog');
      const openDialog = document.querySelector('dialog[open]');
      if (dialog) return dialog.open;
      return !openDialog;
    }

    function showSuccess() {
      save(null);
      body.hidden = true;
      success.hidden = false;
      if (ownerCanFocus()) success.focus();
    }

    function showFallback() {
      result.hidden = false;
      repaint();
      say(T.fallbackStatus);
    }

    function reset() {
      for (const name of FIELD_NAMES) {
        if (name === 'dial') continue;
        const el = box(name);
        if (el) el.value = '';
      }
      const guess = ipDial ?? guessedDial();
      dialChosen = false;
      paintDial(guess?.code ?? dialFallback.code, guess?.dial ?? dialFallback.dial);
      for (const radio of radios) radio.checked = false;
      repaintHandleHint();
      consent.checked = false;
      clearErrors();
      save(null);
      result.hidden = true;
      success.hidden = true;
      body.hidden = false;
      hush();
      repaint();
      box('phone')?.focus();
    }

    for (const el of inputs) {
      el.addEventListener('input', () => {
        save(draftNow());
        repaint();
        const name = el.getAttribute('data-field') as FieldName | 'website';
        if (name !== 'website') {
          const node = root.querySelector<HTMLElement>(`[data-error-for="${name}"]`);
          if (node) {
            node.hidden = true;
            node.textContent = '';
          }
          el.removeAttribute('aria-invalid');
        }
        announce();
      });
      el.addEventListener('change', () => {
        save(draftNow());
        repaintHandleHint();
        repaint();
        announce();
      });
    }

    /* A mistyped number is cheaper to fix the moment the reader leaves the field than after they
     * have written the message, so the phone field confirms itself on blur as well as on submit. */
    const phoneInput = box('phone');
    phoneInput?.addEventListener('blur', () => {
      const value = phoneInput.value.trim();
      if (!value) return;
      const digits = (value.match(/\d/g) ?? []).length;
      if (PHONE.test(value) && digits >= 6) return;
      const node = root.querySelector<HTMLElement>('[data-error-for="phone"]');
      if (node) {
        node.textContent = T.badPhone;
        node.hidden = false;
      }
      phoneInput.setAttribute('aria-invalid', 'true');
    });

    consent.addEventListener('change', () => {
      if (consent.checked) {
        const node = root.querySelector<HTMLElement>('[data-error-for="consent"]');
        if (node) {
          node.hidden = true;
          node.textContent = '';
        }
        consent.removeAttribute('aria-invalid');
      }
    });

    /* The inline form and the dialog form hold the same draft, so neither may be left showing
     * what the other one typed. */
    window.addEventListener(SYNC, (event) => {
      const { dialCode: picked, ...v } = (event as CustomEvent<Draft>).detail;
      for (const name of FIELD_NAMES) {
        if (name === 'platform') continue;
        const el = box(name);
        if (el && el.value !== v[name] && document.activeElement !== el) el.value = v[name];
      }
      for (const radio of radios) radio.checked = radio.value === v.platform;
      paintDialByValue(v.dial, picked);
      repaintHandleHint();
      repaint();
    });

    window.addEventListener(SENT, () => showSuccess());

    function announce() {
      window.dispatchEvent(new CustomEvent(SYNC, { detail: draftNow() }));
    }

    root.addEventListener('click', async (event) => {
      const trigger = (event.target as HTMLElement).closest<HTMLElement>('[data-action]');
      if (!trigger) return;
      const action = trigger.getAttribute('data-action');

      if (action === 'submit') {
        const errors = validate();
        if (Object.keys(errors).length > 0) {
          paintErrors(errors);
          say(T.invalidStatus);
          focusFirst(errors);
          return;
        }
        clearErrors();
        setBusy(true);
        say(T.submitting);
        try {
          const v = read();
          const response = await fetch(endpoint, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              ...v,
              consent: true,
              website: website.value,
              sourcePage: window.location.pathname,
              sourceTitle: document.title,
              language: document.documentElement.lang,
              sourceButton,
            }),
          });

          /* A static host answers unknown paths with a 200 HTML page, so only the endpoint's own
           * JSON confirmation may be read as delivered. */
          const data = (await response.json().catch(() => null)) as {
            ok?: boolean;
            fields?: string[];
          } | null;

          if (response.ok && data?.ok === true) {
            showSuccess();
            window.dispatchEvent(new CustomEvent(SENT));
            return;
          }

          if (response.status === 400) {
            const fields = Array.isArray(data?.fields) ? data.fields : [];
            if (fields.length > 0) {
              const messages: Errors = {};
              for (const field of fields) {
                if (field === 'consent') messages.consent = T.needConsent;
                else if (field === 'phone') messages.phone = T.badPhone;
                else if (field === 'platform') messages.platform = T.needChannel;
                else if (field === 'handle') messages.handle = T.needHandle;
              }
              paintErrors(messages);
              say(T.invalidStatus);
              focusFirst(messages);
              return;
            }
          }

          showFallback();
        } catch {
          showFallback();
        } finally {
          setBusy(false);
        }
        return;
      }

      if (action === 'again') {
        reset();
        return;
      }

      if (action === 'copy') {
        const text = compose(read());
        let ok = false;
        try {
          await navigator.clipboard.writeText(text);
          ok = true;
        } catch {
          /* clipboard blocked: the preview above is the manual fallback */
        }
        say(ok ? T.copied : T.clipboardBlocked);
        return;
      }

      if (action === 'download') {
        const blob = new Blob([`# ${T.exportHeading}\n\n${compose(read())}\n`], { type: 'text/markdown' });
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = T.filename;
        a.click();
        URL.revokeObjectURL(url);
        say(fill(T.downloaded, { file: T.filename }));
      }
    });

    const saved = load();
    if (saved) {
      for (const name of FIELD_NAMES) {
        if (name === 'platform') continue;
        const el = box(name);
        if (el) el.value = saved[name];
      }
      for (const radio of radios) radio.checked = radio.value === saved.platform;
      paintDialByValue(saved.dial, saved.dialCode);
      /* A draft that names its country was chosen by the reader. One that only carries a code was
       * written by a guess, so the network is still allowed to correct it. */
      dialChosen = Boolean(saved.dialCode);
    } else {
      const guess = guessedDial();
      if (guess) paintDial(guess.code, guess.dial);
    }
    repaintHandleHint();
    repaint();

    /* The lookup waits until this copy of the form is on screen: a page whose enquiry band is
     * never reached asks nothing, and the dialog copy is not on screen until it is opened. */
    const onScreen = new IntersectionObserver((entries, seen) => {
      if (!entries.some((entry) => entry.isIntersecting)) return;
      seen.disconnect();
      void visitorRegion().then(applyRegion);
    });
    onScreen.observe(root);
  }
</script>
