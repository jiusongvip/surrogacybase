---
/*
 * The homepage enquiry.
 *
 * It has the five fields the layout calls for, and it cannot submit them: this is a static
 * build with no server, so there is nowhere for a POST to go. What happens when the button is
 * pressed is therefore the honest version of a submission. The enquiry is assembled on screen,
 * the reader reads it, and it leaves through their own mail app, clipboard or a downloaded
 * file. The status line says which of those just happened instead of confirming a message that
 * never went anywhere.
 *
 * The draft is stored in this browser so a half-written enquiry survives a reload. No identity
 * document, medical record or payment detail is asked for, because none of them is needed to
 * open a conversation, and the budget field takes a band rather than a figure.
 *
 * The wording lives in src/data/intake.ts. The script needs some of it at runtime to assemble
 * the message, so the chrome is serialized into the DOM and the bundle stays one file for both
 * languages. Option labels are read back off the selected option, so a message can only ever
 * carry the words the page is showing.
 */
import Icon from '@/components/ui/Icon.astro';
import NeedsInput from '@/components/ui/NeedsInput.astro';
import { SITE } from '@/const';
import { CONSULT_BUDGETS, CONSULT_CHROME, CONSULT_INTERESTS } from '@/data/intake';
import { langFromPath } from '@/i18n/paths';
import { pick } from '@/i18n/ui';

const inbox = SITE.contactEmail;
const lang = langFromPath(Astro.url.pathname);
const copy = CONSULT_CHROME[lang];
const interests = CONSULT_INTERESTS.map((o) => ({ value: o.value, label: pick(o.label, lang) }));
const budgets = CONSULT_BUDGETS.map((o) => ({ value: o.value, label: pick(o.label, lang) }));
---

<div
  class="rounded-(--radius) border border-line bg-paper p-6 text-text shadow-lift sm:p-7"
  data-consult={inbox}
  data-copy={JSON.stringify(copy)}
>
  <div class="grid gap-5 sm:grid-cols-2">
    <div>
      <label class="field-label" for="cq-name">
        {copy.nameLabel}
        <span class="text-flag" aria-hidden="true">{copy.required}</span>
      </label>
      <input
        class="field-input mt-1.5"
        id="cq-name"
        data-field="name"
        type="text"
        autocomplete="name"
        maxlength="80"
        required
        placeholder={copy.namePlaceholder}
      />
    </div>

    <div>
      <label class="field-label" for="cq-email">
        {copy.emailLabel}
        <span class="text-flag" aria-hidden="true">{copy.required}</span>
      </label>
      <input
        class="field-input mt-1.5"
        id="cq-email"
        data-field="email"
        type="email"
        autocomplete="email"
        maxlength="120"
        required
        placeholder={copy.emailPlaceholder}
      />
    </div>

    <div>
      <label class="field-label" for="cq-interest">
        {copy.interestLabel}
        <span class="text-flag" aria-hidden="true">{copy.required}</span>
      </label>
      <select class="field-input mt-1.5" id="cq-interest" data-field="interest" required>
        <option value="">{copy.selectPlaceholder}</option>
        {interests.map((o) => <option value={o.value}>{o.label}</option>)}
      </select>
    </div>

    <div>
      <label class="field-label" for="cq-budget">
        {copy.budgetLabel}
        <span class="text-flag" aria-hidden="true">{copy.required}</span>
      </label>
      <select class="field-input mt-1.5" id="cq-budget" data-field="budget" required>
        <option value="">{copy.selectPlaceholder}</option>
        {budgets.map((o) => <option value={o.value}>{o.label}</option>)}
      </select>
      <p class="mt-1.5 text-[13px] leading-relaxed text-muted">{copy.budgetHint}</p>
    </div>

    <div class="sm:col-span-2">
      <label class="field-label" for="cq-message">
        {copy.messageLabel}
        <span class="font-normal text-muted">{copy.optional}</span>
      </label>
      <textarea
        class="field-input mt-1.5 min-h-[112px]"
        id="cq-message"
        data-field="message"
        rows="4"
        maxlength="1200"
        placeholder={copy.messagePlaceholder}></textarea>
    </div>
  </div>

  <button type="button" class="btn-primary mt-6 w-full" data-action="submit">
    {copy.submit}
    <Icon name="arrow-right" size={16} />
  </button>

  <p class="mt-3 text-[14px] leading-relaxed text-muted" role="status" aria-live="polite" data-status>
    {copy.statusIdle}
  </p>

  {inbox ? null : <div class="mt-4"><NeedsInput label={copy.needsLabel} why={copy.needsWhy} /></div>}

  <div class="mt-5 hidden border-t border-line pt-5" data-result>
    <p class="text-[13px] font-semibold uppercase tracking-[0.12em] text-muted">{copy.previewHeading}</p>
    <pre
      class="tnum mt-2 overflow-x-auto rounded-(--radius) border border-line bg-surface p-4 text-[13px] leading-[1.6] whitespace-pre-wrap text-text"
      data-preview
      tabindex="0"
    ></pre>
    <div class="mt-4 flex flex-wrap gap-3">
      {
        inbox ? (
          <a class="btn-primary text-sm" data-send href={`mailto:${inbox}`}>
            {copy.sendMail}
            <Icon name="arrow-up-right" size={16} />
          </a>
        ) : null
      }
      <button type="button" class="btn-ghost text-sm" data-action="copy">{copy.copy}</button>
      <button type="button" class="btn-ghost text-sm" data-action="download">{copy.download}</button>
    </div>
  </div>
</div>

<script>
  import type { ConsultChrome } from '@/data/intake';

  type Fields = { name: string; email: string; interest: string; budget: string; message: string };
  type Chrome = ConsultChrome;

  const KEY = 'surrogacybase.consult.v1';
  const ADDRESS = /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/;

  /** Same token syntax as src/i18n/ui.ts, kept local because a bundle cannot import it. */
  function fill(template: string, vars: Record<string, string>): string {
    return template.replace(/\{(\w+)\}/g, (match, key: string) => (key in vars ? vars[key] : match));
  }

  for (const root of Array.from(document.querySelectorAll<HTMLElement>('[data-consult]'))) {
    const T = JSON.parse(root.dataset.copy!) as Chrome;
    const inbox = root.getAttribute('data-consult') ?? '';
    const status = root.querySelector<HTMLElement>('[data-status]')!;
    const result = root.querySelector<HTMLElement>('[data-result]')!;
    const preview = root.querySelector<HTMLPreElement>('[data-preview]')!;
    const send = root.querySelector<HTMLAnchorElement>('[data-send]');
    const inputs = Array.from(root.querySelectorAll<HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement>('[data-field]'));

    const box = (name: keyof Fields) => root.querySelector<HTMLElement>(`[data-field="${name}"]`) as HTMLInputElement | null;

    const EMPTY: Fields = { name: '', email: '', interest: '', budget: '', message: '' };

    const read = (): Fields => {
      const out = { ...EMPTY };
      for (const el of inputs) out[el.getAttribute('data-field') as keyof Fields] = el.value;
      return out;
    };

    /**
     * The selected option's own text, which is the label the reader saw. A code-to-label table
     * in here would be a second copy of the wording, and the message could end up in a language
     * the page is not written in.
     */
    const labelOf = (name: 'interest' | 'budget') => {
      const el = root.querySelector<HTMLSelectElement>(`[data-field="${name}"]`);
      return el && el.selectedIndex > 0 ? el.options[el.selectedIndex].text : '';
    };

    /** One text for every exit: the preview, the mail body, the clipboard and the file. */
    function compose(v: Fields): string {
      const lines = [fill(T.lineName, { value: v.name.trim() })];
      lines.push(fill(T.lineEmail, { value: v.email.trim() }));
      lines.push(fill(T.lineInterest, { value: labelOf('interest') }));
      lines.push(fill(T.lineBudget, { value: labelOf('budget') }));
      lines.push(
        v.message.trim()
          ? fill(T.lineMessage, { value: v.message.trim() })
          : T.lineNoMessage
      );
      lines.push('', T.lineFooter);
      return lines.join('\n');
    }

    /** The first thing wrong, named rather than beeped at. */
    function problem(): string | null {
      const v = read();
      if (!v.name.trim()) return T.needName;
      if (!v.email.trim()) return T.needEmail;
      if (!ADDRESS.test(v.email.trim())) return T.badEmail;
      if (!v.interest) return T.needInterest;
      if (!v.budget) return T.needBudget;
      return null;
    }

    function focusProblem() {
      const v = read();
      const order: [keyof Fields, boolean][] = [
        ['name', !v.name.trim()],
        ['email', !v.email.trim() || !ADDRESS.test(v.email.trim())],
        ['interest', !v.interest],
        ['budget', !v.budget],
      ];
      const hit = order.find(([, bad]) => bad);
      if (hit) box(hit[0])?.focus();
    }

    function save(v: Fields) {
      try {
        localStorage.setItem(KEY, JSON.stringify(v));
      } catch {
        /* storage blocked: the enquiry still works for this page view */
      }
    }

    function load(): Fields | null {
      try {
        const raw = localStorage.getItem(KEY);
        if (!raw) return null;
        const parsed = JSON.parse(raw) as Partial<Fields>;
        const out = { ...EMPTY };
        for (const name of Object.keys(EMPTY) as (keyof Fields)[]) {
          if (typeof parsed[name] === 'string') out[name] = parsed[name] as string;
        }
        return out;
      } catch {
        return null;
      }
    }

    function repaint() {
      const v = read();
      preview.textContent = compose(v);
      if (send && inbox) {
        const subject = v.name.trim() ? `${T.subjectFallback}: ${v.name.trim()}` : T.subjectFallback;
        send.href = `mailto:${inbox}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(compose(v))}`;
      }
    }

    for (const el of inputs) {
      el.addEventListener('input', () => {
        save(read());
        repaint();
      });
      el.addEventListener('change', () => {
        save(read());
        repaint();
      });
    }

    root.addEventListener('click', async (event) => {
      const trigger = (event.target as HTMLElement).closest<HTMLElement>('[data-action], [data-send]');
      if (!trigger) return;
      const action = trigger.getAttribute('data-action');

      if (action === 'submit') {
        const bad = problem();
        if (bad) {
          status.textContent = bad;
          focusProblem();
          return;
        }
        result.classList.remove('hidden');
        repaint();
        if (inbox && send) {
          send.click();
          status.textContent = T.submittedWithMail;
        } else {
          status.textContent = T.submittedWithoutMail;
          preview.focus();
        }
        return;
      }

      if (action === 'copy') {
        const text = compose(read());
        let ok = false;
        try {
          await navigator.clipboard.writeText(text);
          ok = true;
        } catch {
          /* clipboard blocked: the preview above is the manual fallback */
        }
        status.textContent = ok ? T.copied : T.clipboardBlocked;
        return;
      }

      if (action === 'download') {
        const blob = new Blob([`# ${T.exportHeading}\n\n${compose(read())}\n`], { type: 'text/markdown' });
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = T.filename;
        a.click();
        URL.revokeObjectURL(url);
        status.textContent = fill(T.downloaded, { file: T.filename });
      }
    });

    const saved = load();
    if (saved) {
      for (const name of Object.keys(EMPTY) as (keyof Fields)[]) {
        const el = box(name);
        if (el) el.value = saved[name];
      }
    }
    repaint();
  }
</script>
