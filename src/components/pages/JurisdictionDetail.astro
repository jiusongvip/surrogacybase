---
/*
 * One jurisdiction record. The markup is here rather than in the route file because both
 * language routes build the same page from the same record, and only the wording around it
 * differs. Provenance is never taken from the dictionary: the source url, publisher and dates
 * come from src/data/jurisdictions, and scripts/audit-zh.mjs checks the Chinese record against it.
 */
import PageLayout from '@/layouts/PageLayout.astro';
import Breadcrumbs from '@/components/ui/Breadcrumbs.astro';
import Icon from '@/components/ui/Icon.astro';
import NextStep from '@/components/content/NextStep.astro';
import ArticleCard from '@/components/content/ArticleCard.astro';
import { NEXT_STEP } from '@/data/next-steps';
import type { CollectionEntry } from 'astro:content';
import { langFromPath, localizedPath } from '@/i18n/paths';
import { BASIS_LABELS, SUB_STATUS_LABELS, UI, fill } from '@/i18n/ui';
import { formatDate } from '@/lib/dates';
import { localize } from '@/lib/jurisdictions';
import { costText } from '@/lib/costs';
import { getLiveContent } from '@/lib/content';
import { contentImage } from '@/data/content-images';
import { ADMISSION_FAMILIES, admissionFor, familyLabel, unadmitted } from '@/lib/admits';

type Props = { entry: CollectionEntry<'jurisdictions'> };

const { entry } = Astro.props;
const lang = langFromPath(Astro.url.pathname);
const copy = UI[lang].pages.jurisdiction;
const costsCopy = UI[lang].costs;
const admitsCopy = UI[lang].admits;
const d = localize(entry.data, lang);

/*
 * The related-reading block at the foot of the page. The articles a reader actually wants after a
 * country page are the ones scoped to that country, and the articles collection already carries a
 * jurisdictions field that names them. Filtering on it means the block writes itself from the data:
 * a country no article is scoped to simply prints nothing rather than an empty heading.
 */
const related = (await getLiveContent(lang)).filter((e) => e.data.jurisdictions.includes(d.code));

/**
 * The record's admission rows, gathered by what a reader has to weigh: same status, same
 * qualification, same source. Family types that share all three are one line, so the sentence that
 * qualifies them is printed once and cited once rather than once per type.
 */
type AdmissionGroup = {
  status: (typeof d.admits)[number]['status'];
  note: (typeof d.admits)[number]['note'];
  families: string[];
  source: (typeof d.facts)[number]['source'];
};
const groups: AdmissionGroup[] = [];
for (const family of ADMISSION_FAMILIES) {
  const row = admissionFor(d.admits, family);
  if (!row) continue;
  const fact = d.facts[row.fact];
  if (!fact) throw new Error(`${d.code} admits row names fact ${row.fact}, which the record does not carry.`);
  const existing = groups.find(
    (g) => g.status === row.status && g.note === row.note && g.source.url === fact.source.url,
  );
  if (existing) existing.families.push(familyLabel(family, lang));
  else
    groups.push({
      status: row.status,
      note: row.note,
      families: [familyLabel(family, lang)],
      source: fact.source,
    });
}
const unsettled = unadmitted(d.admits);

/*
 * The four cells a reader gets before the argument. Each is read off a structured field of the
 * record rather than written here, so the strip cannot claim anything the sections below do not:
 * the basis label, whether the record's own sources admit intended parents from abroad, which
 * family types the provision names as open, and the one published total. Intended parents living
 * abroad is excluded from the third cell because it has a cell of its own, and listing it twice
 * would read as two separate findings.
 */
const internationalRow = admissionFor(d.admits, 'international');
const openFamilies = ADMISSION_FAMILIES.filter(
  (family) => family !== 'international' && admissionFor(d.admits, family)?.status === 'open',
);
const totalCost = d.costs.find((figure) => figure.item === 'total');

/*
 * The legality map, when the record carries one. A divided jurisdiction (a federation, or a country
 * of separate legal systems) answers "is this open?" only region by region, so the first thing a
 * reader should see is where it is open, not where the record is silent. Permitted states are plain
 * chips; restricted ones carry the note that explains the limit; the unlegislated remainder is
 * described once rather than listed state by state, because the sources name only the permitted and
 * restricted ones by name.
 */
const subMap = d.subJurisdictions ?? [];
const permittedSubs = subMap.filter((s) => s.status === 'permitted');
const restrictedSubs = subMap.filter((s) => s.status === 'restricted');
const prohibitedSubs = subMap.filter((s) => s.status === 'prohibited');

const glance = [
  { label: copy.positions.legalBasis, value: BASIS_LABELS[lang][d.basis] ?? d.basis },
  {
    label: copy.atGlance.international,
    value: internationalRow ? admitsCopy.status[internationalRow.status] : admitsCopy.cell.none,
  },
  {
    label: copy.atGlance.families,
    value: openFamilies.length
      ? openFamilies.map((family) => familyLabel(family, lang)).join(admitsCopy.join)
      : copy.atGlanceNone,
  },
  {
    label: copy.atGlance.cost,
    value: totalCost ? costText(totalCost, lang) : copy.atGlance.noCost,
  },
];

const positions = [
  { label: copy.positions.whoMayCommission, value: d.eligibility },
  { label: copy.positions.payment, value: d.paymentModel },
  { label: copy.positions.parentage, value: d.parentage },
];
---

<PageLayout
  title={fill(copy.title, { name: d.name })}
  description={fill(copy.description, { name: d.name })}
>
  <Breadcrumbs
    crumbs={[{ label: copy.breadcrumb, href: localizedPath(lang, '/destinations') }, { label: d.name }]}
  />

  <article class="shell py-10">
    <header class="max-w-[72ch]">
      <p class="text-[14px] text-muted">{d.region}</p>
      <h1 class="mt-2 text-[clamp(2rem,4.2vw,3rem)] leading-[1.06]">{fill(copy.heading, { name: d.name })}</h1>
      <p class="mt-4 text-[17px] leading-relaxed text-muted">
        {copy.intro}
      </p>
      <p class="mt-4 tnum text-[14px] text-muted">
        {fill(copy.checked, { date: formatDate(d.statusVerifiedOn, lang) })}
      </p>
    </header>

    {d.insufficientData && (
      <aside class="mt-8 flex items-start gap-3 rounded-(--radius) border border-flag/35 bg-flag-tint px-5 py-4 text-[15px] text-flag">
        <Icon name="alert-triangle" size={18} class="mt-0.5 shrink-0" />
        <p>
          {fill(copy.insufficient, { name: d.name })}
        </p>
      </aside>
    )}

    {
      subMap.length > 0 && (
        <section class="mt-8">
          <h2 class="text-[22px]">{copy.legalMap.title}</h2>
          <p class="mt-2 max-w-[62ch] text-[16px] leading-relaxed text-muted">{copy.legalMap.intro}</p>

          <div class="mt-6 space-y-6">
            <div>
              <p class="text-[14px] font-semibold">
                {copy.legalMap.permittedLabel}
                <span class="ml-1 text-[13px] font-normal text-muted">({permittedSubs.length})</span>
              </p>
              <div class="mt-3 flex flex-wrap gap-2">
                {permittedSubs.map((s) => (
                  <span class="rounded-full border border-line bg-surface px-3 py-1 text-[14px] leading-tight">
                    {s.name}
                  </span>
                ))}
              </div>
            </div>

            {(restrictedSubs.length > 0 || prohibitedSubs.length > 0) && (
              <div>
                <p class="text-[14px] font-semibold text-flag">
                  {copy.legalMap.restrictedLabel}
                  <span class="ml-1 text-[13px] font-normal text-muted">
                    ({restrictedSubs.length + prohibitedSubs.length})
                  </span>
                </p>
                <ul class="mt-3 space-y-2">
                  {[...restrictedSubs, ...prohibitedSubs].map((s) => (
                    <li class="text-[15px] leading-relaxed">
                      <span class="font-medium">{s.name}</span>
                      <span class="ml-2 text-[12.5px] uppercase tracking-wide text-muted">
                        {SUB_STATUS_LABELS[lang][s.status]}
                      </span>
                      {s.note && <span class="mt-0.5 block text-[14px] leading-[1.65] text-muted">{s.note}</span>}
                    </li>
                  ))}
                </ul>
              </div>
            )}

            <p class="max-w-[62ch] text-[14px] leading-[1.7] text-muted">{copy.legalMap.unlegislatedNote}</p>
          </div>
        </section>
      )
    }

    <section class="mt-8 grid gap-px overflow-hidden rounded-(--radius-card) border border-line bg-line sm:grid-cols-2 lg:grid-cols-4">
      {
        glance.map((cell) => (
          <div class="bg-surface px-5 py-4">
            <p class="text-[13px] font-medium text-muted">{cell.label}</p>
            <p class="mt-1.5 text-[15px] leading-[1.5] font-medium">{cell.value}</p>
          </div>
        ))
      }
    </section>

    <section class="mt-10 grid gap-x-10 gap-y-6 border-t border-line pt-8 sm:grid-cols-3">
      {positions.map((p) => (
        <div>
          <h2 class="text-[14px] font-semibold text-muted">{p.label}</h2>
          <p class="mt-1.5 text-[16px] leading-relaxed">{p.value}</p>
        </div>
      ))}
    </section>

    {
      d.timeline.length > 0 && (
        <section class="mt-12">
          <h2 class="text-[22px]">{copy.timelineTitle}</h2>
          <p class="mt-2 max-w-[62ch] text-[16px] leading-relaxed text-muted">{copy.timelineIntro}</p>
          <ol class="mt-6 space-y-5">
            {d.timeline.map((event) => (
              <li class="grid gap-x-6 gap-y-1 border-l-2 border-line-strong pl-5 sm:grid-cols-[7.5rem_minmax(0,1fr)]">
                <time class="tnum text-[14px] font-medium text-accent" datetime={event.on}>
                  {formatDate(event.on, lang)}
                </time>
                <div>
                  <p class="text-[16px] leading-relaxed">{event.claim}</p>
                  <p class="mt-1.5 text-[13px] text-muted">
                    <a
                      href={d.facts[event.fact].source.url}
                      rel="noopener noreferrer"
                      target="_blank"
                      class="link-underlined"
                    >
                      {d.facts[event.fact].source.label}
                    </a>
                    <span class="tnum">{fill(copy.citeChecked, { date: formatDate(d.facts[event.fact].source.verifiedOn, lang) })}</span>
                  </p>
                </div>
              </li>
            ))}
          </ol>
        </section>
      )
    }

    {
      groups.length > 0 ? (
        <section class="mt-12">
          <h2 class="text-[22px]">{admitsCopy.heading}</h2>
          <p class="mt-2 max-w-[62ch] text-[16px] leading-relaxed text-muted">{admitsCopy.intro}</p>

          <ul class="mt-6 space-y-4">
            {groups.map((g) => (
              <li class="grid gap-x-6 gap-y-1 border-t border-line pt-4 sm:grid-cols-[minmax(0,1fr)_minmax(0,1.4fr)]">
                <p class="text-[17px] leading-relaxed font-medium">{g.families.join(admitsCopy.join)}</p>
                <div>
                  <p class:text-flag={g.status === 'closed'} class="text-[17px] leading-relaxed">
                    {admitsCopy.status[g.status]}
                    {g.note !== undefined && (
                      <span class="mt-1 block text-[15px] leading-[1.65] text-muted">
                        {admitsCopy.note[g.note]}
                      </span>
                    )}
                  </p>
                  <p class="mt-1 text-[13px] text-muted">
                    <a href={g.source.url} rel="noopener noreferrer" target="_blank" class="link-underlined">
                      {g.source.label}
                    </a>
                    <span class="tnum block">
                      {fill(copy.citeChecked, { date: formatDate(g.source.verifiedOn, lang) })}
                    </span>
                  </p>
                </div>
              </li>
            ))}
          </ul>

          {
            unsettled.length > 0 && (
              <p class="mt-6 max-w-[62ch] text-[14px] leading-[1.7] text-flag">
                {fill(admitsCopy.notEstablished, {
                  families: unsettled
                    .map((family) => familyLabel(family, lang))
                    .join(admitsCopy.join),
                })}
              </p>
            )
          }
        </section>
      ) : (
        <aside class="mt-12 rounded-(--radius) border border-line px-5 py-4 text-[15px] leading-[1.7] text-muted">
          {admitsCopy.noneForRecord}
        </aside>
      )
    }

    <section class="mt-12">
      <h2 class="text-[22px]">{copy.guide.processHeading}</h2>
      <p class="mt-2 max-w-[62ch] text-[16px] leading-relaxed text-muted">{copy.guide.processIntro}</p>
      <ol class="mt-6 space-y-4">
        {copy.guide.processStages.map((stage, i) => (
          <li class="grid gap-x-4 gap-y-1 sm:grid-cols-[2rem_minmax(0,1fr)]">
            <span class="tnum text-[15px] font-semibold text-accent">{i + 1}</span>
            <div>
              <p class="text-[16px] leading-relaxed font-medium">{stage.title}</p>
              <p class="mt-1 text-[15px] leading-relaxed text-muted">{stage.blurb}</p>
            </div>
          </li>
        ))}
      </ol>
      <a href={localizedPath(lang, '/guides/surrogacy-process')} class="textlink mt-5">{copy.guide.processLink}</a>
    </section>

    <section class="mt-12">
      <h2 class="text-[22px]">{costsCopy.heading}</h2>
      <p class="mt-2 max-w-[62ch] text-[16px] leading-relaxed text-muted">{costsCopy.intro}</p>

      {
        d.costs.length > 0 ? (
          <div class="mt-6 overflow-x-auto">
            <table class="w-full min-w-[640px] border-collapse text-left text-[15px]">
              <caption class="sr-only">{costsCopy.heading}</caption>
              <thead>
                <tr>
                  <th class="border-b border-line-strong pb-2 pr-4 font-semibold">{costsCopy.columns.item}</th>
                  <th class="border-b border-line-strong pb-2 pr-4 font-semibold">{costsCopy.columns.figure}</th>
                  <th class="border-b border-line-strong pb-2 pr-4 font-semibold">{costsCopy.columns.source}</th>
                  <th class="border-b border-line-strong pb-2 font-semibold">{costsCopy.asOfYear}</th>
                </tr>
              </thead>
              <tbody>
                {d.costs.map((figure) => (
                  <tr>
                    <td class="border-b border-line py-3 pr-4 align-top">{costsCopy.items[figure.item]}</td>
                    <td class="border-b border-line py-3 pr-4 align-top tnum">{costText(figure, lang)}</td>
                    <td class="border-b border-line py-3 pr-4 align-top text-muted">
                      <a href={d.facts[figure.fact].source.url} rel="noopener noreferrer" target="_blank" class="link-underlined">
                        {d.facts[figure.fact].source.label}
                      </a>
                      <span class="tnum block text-[13px]">
                        {fill(copy.citeChecked, { date: formatDate(d.facts[figure.fact].source.verifiedOn, lang) })}
                      </span>
                    </td>
                    <td class="border-b border-line py-3 align-top tnum text-[13px] text-muted">
                      {fill(costsCopy.asOf, { year: figure.asOf })}
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        ) : (
          <p class="mt-4 max-w-[62ch] text-[16px] leading-relaxed">{costsCopy.none}</p>
        )
      }
      <a href={localizedPath(lang, '/tools/cost-figures')} class="textlink mt-5">{copy.costFiguresLink}</a>
    </section>

    <section class="mt-12">
      <h2 class="text-[22px]">{copy.guide.contractHeading}</h2>
      <p class="mt-2 max-w-[62ch] text-[16px] leading-relaxed text-muted">{copy.guide.contractIntro}</p>
      <a href={localizedPath(lang, '/guides/surrogacy-legal-considerations')} class="textlink mt-4">{copy.guide.contractLink}</a>
    </section>

    <section class="mt-12">
      <h2 class="text-[22px]">{copy.guide.agencyHeading}</h2>
      <p class="mt-2 max-w-[62ch] text-[16px] leading-relaxed text-muted">{copy.guide.agencyIntro}</p>
      <a href={localizedPath(lang, '/guides/choosing-a-surrogacy-agency')} class="textlink mt-4">{copy.guide.agencyLink}</a>
    </section>

    <section class="mt-12">
      <h2 class="text-[22px]">{copy.guide.faqHeading}</h2>
      <dl class="mt-6 space-y-5">
        {copy.guide.faq.map((item) => (
          <div class="border-l-2 border-accent pl-5">
            <dt class="text-[17px] leading-relaxed font-medium">{item.q}</dt>
            <dd class="mt-1.5 text-[16px] leading-relaxed text-muted">{item.a}</dd>
          </div>
        ))}
      </dl>
    </section>

    {d.facts.length > 0 && (
      <section class="mt-12">
        <h2 class="text-[22px]">{copy.restsTitle}</h2>
        <ul class="mt-5 space-y-6">
          {d.facts.map((fact) => (
            <li class="border-l-2 border-accent pl-5">
              <p class="text-[17px] leading-relaxed">{fact.claim}</p>
              <p class="mt-2 text-[14px] text-muted">
                <a
                  href={fact.source.url}
                  rel="noopener noreferrer"
                  target="_blank"
                  class="link-underlined"
                >
                  {fact.source.label}
                </a>
                <span> · {fact.source.publisher}</span>
                <span class="tnum">{fill(copy.citeChecked, { date: formatDate(fact.source.verifiedOn, lang) })}</span>
              </p>
            </li>
          ))}
        </ul>
      </section>
    )}

    {d.openQuestions.length > 0 && (
      <section class="mt-12 border-t border-line pt-8" id="open-questions">
        <h2 class="text-[22px]">{copy.openTitle}</h2>
        <p class="mt-2 max-w-[62ch] text-[16px] leading-relaxed text-muted">
          {fill(copy.openIntro, { name: d.name })}
        </p>
        <ul class="mt-5 grid gap-3">
          {d.openQuestions.map((q) => (
            <li class="flex gap-3 text-[16px] leading-relaxed">
              <Icon name="chevron-right" size={16} class="mt-1.5 shrink-0 text-accent" />
              <span>{q}</span>
            </li>
          ))}
        </ul>
      </section>
    )}

    <section class="mt-12 flex flex-wrap items-start justify-between gap-6 border-t border-line pt-8">
      <div class="max-w-[52ch]">
        <h2 class="text-[20px]">{copy.compareTitle}</h2>
        <p class="mt-2 text-[16px] leading-relaxed text-muted">
          {copy.compareBody}
        </p>
      </div>
      <div class="flex flex-wrap items-center gap-3">
        <a href={localizedPath(lang, '/tools/destination-comparison')} class="btn-primary">{copy.compareBoard}</a>
        <a href={localizedPath(lang, '/tools/destination-research-checklist')} class="btn-ghost">{copy.openChecklist}</a>
      </div>
      <div class="flex flex-wrap gap-x-6 gap-y-2 sm:basis-full">
        <a href={localizedPath(lang, '/guides/surrogacy-legal-considerations')} class="textlink">{copy.legalFramework}</a>
        <a href={localizedPath(lang, '/guides/bringing-your-child-home')} class="textlink">{copy.documentsGuide}</a>
      </div>
    </section>

    {
      related.length > 0 && (
        <section class="mt-12 border-t border-line pt-8">
          <h2 class="text-[22px]">{fill(copy.relatedTitle, { name: d.name })}</h2>
          <p class="mt-2 max-w-[62ch] text-[16px] leading-relaxed text-muted">
            {fill(copy.relatedIntro, { name: d.name })}
          </p>
          <ul class="mt-7 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
            {related.map((entry) => (
              <li class="h-full">
                <ArticleCard entry={entry} showKind={true} image={contentImage(entry.id)} />
              </li>
            ))}
          </ul>
        </section>
      )
    }

    <section class="mt-16">
      <NextStep
        secondaryHref={localizedPath(lang, '/guides/surrogacy-cost')}
        secondaryLabel={NEXT_STEP[lang].costGuide}
      />
    </section>
  </article>
</PageLayout>
