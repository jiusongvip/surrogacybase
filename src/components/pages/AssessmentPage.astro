---
/*
 * The assessment's own page, in both languages.
 *
 * What the service is, what it refuses to do, and which parts of it are still undecided. The last
 * of those is the reason the wording lives in a dictionary: an English page that admits a gap and a
 * Chinese page that quietly papers over it would be two different services.
 */
import PageLayout from '@/layouts/PageLayout.astro';
import Breadcrumbs from '@/components/ui/Breadcrumbs.astro';
import Icon from '@/components/ui/Icon.astro';
import NeedsInput from '@/components/ui/NeedsInput.astro';
import AssessmentRequest from '@/components/forms/AssessmentRequest.astro';
import { SITE } from '@/const';
import { ASSESSMENT_PAGE, ASSESSMENT_REVISION } from '@/data/service-pages';
import { formatDate } from '@/lib/dates';
import { langFromPath, localizedPath } from '@/i18n/paths';
import { fill } from '@/i18n/ui';

const UPDATED_ON = ASSESSMENT_REVISION;

const lang = langFromPath(Astro.url.pathname);
const copy = ASSESSMENT_PAGE[lang];
---

<PageLayout title={copy.title} description={copy.description} updatedOn={UPDATED_ON}>
  <Breadcrumbs crumbs={[{ label: copy.title }]} />

  <article class="shell py-10 max-w-[74ch]">
    <p class="flex flex-wrap items-center gap-2 text-[14px] text-muted">
      <Icon name="clock" size={16} class="text-flag" />
      {copy.statusNote}
    </p>
    <h1 class="mt-4 text-[clamp(2.1rem,4.4vw,3.1rem)] leading-[1.06]">{copy.h1}</h1>
    <p class="mt-4 text-[19px] leading-[1.6] text-muted">{copy.intro}</p>

    <section class="mt-12 border-t border-line pt-8">
      <h2 class="text-[22px]">{copy.forHeading}</h2>
      <p class="mt-3 text-[16px] leading-relaxed text-muted">{copy.forBody}</p>
    </section>

    <section class="mt-12 border-t border-line pt-8">
      <h2 class="text-[22px]">{copy.bringHeading}</h2>
      <ul class="mt-4 space-y-3 text-[16px] leading-relaxed text-muted">
        {
          copy.brings.map((b) => (
            <li class="flex gap-3">
              <Icon name="check" size={16} class="mt-1.5 shrink-0 text-accent" />
              <span>{b}</span>
            </li>
          ))
        }
      </ul>
      <p class="mt-6 text-[16px] leading-relaxed">
        {copy.bringBefore}
        <a href={localizedPath(lang, '/privacy')} class="link-underlined">{copy.bringLink}</a>
        {copy.bringAfter}
      </p>
    </section>

    <section class="mt-12 border-t border-line pt-8">
      <h2 class="text-[22px]">{copy.receiveHeading}</h2>
      <dl class="mt-5 grid gap-6">
        {
          copy.receives.map((r, i) => (
            <div class="border-l-2 border-accent pl-5">
              <dt class="sr-only">{fill(copy.outcome, { n: i + 1 })}</dt>
              <dd class="text-[16px] leading-relaxed text-muted">{r}</dd>
            </div>
          ))
        }
      </dl>
      <p class="mt-6 text-[16px] leading-relaxed text-muted">{copy.receiveBody}</p>
    </section>

    <section class="mt-12 border-t border-line pt-8">
      <h2 class="text-[22px]">{copy.neverHeading}</h2>
      <div class="mt-6 grid gap-8">
        {
          copy.never.map((n) => (
            <div>
              <h3 class="text-[17px] font-semibold">{n.h}</h3>
              <p class="mt-2 text-[16px] leading-relaxed text-muted">{n.p}</p>
            </div>
          ))
        }
      </div>
    </section>

    <section class="mt-12 border border-dashed border-line-strong bg-surface p-6">
      <h2 class="text-[22px]">{copy.settledHeading}</h2>
      <p class="mt-3 text-[16px] leading-relaxed text-muted">{copy.settledBody}</p>
      <ul class="mt-5 space-y-3 text-[16px]">
        {
          copy.settledNeeds.map((n) => (
            <li>
              <NeedsInput label={n.label} why={n.why} />
            </li>
          ))
        }
      </ul>
    </section>

    <section class="mt-12 border-t border-line pt-8" id="brief">
      <h2 class="text-[22px]">{copy.startHeading}</h2>
      <p class="mt-3 text-[16px] leading-relaxed text-muted">{copy.startBody}</p>
      <div class="mt-5 flex flex-wrap gap-3">
        <a href={localizedPath(lang, '/#assessment')} class="btn-primary">
          {copy.startPrimary}
          <Icon name="arrow-right" size={16} />
        </a>
        <a href={localizedPath(lang, '/privacy')} class="btn-ghost">{copy.startSecondary}</a>
      </div>

      {/* The structured version of the same enquiry, for a reader already on the service page. */}
      <div class="mt-8 max-w-[620px]">
        <AssessmentRequest email={SITE.contactEmail} />
      </div>
    </section>

    <section class="mt-12 border-t border-line pt-8">
      <h2 class="text-[22px]">{copy.diyHeading}</h2>
      <p class="mt-3 text-[16px] leading-relaxed text-muted">{copy.diyBody}</p>
      <div class="mt-5 flex flex-wrap gap-3">
        <a href={localizedPath(lang, '/tools/agency-quote-comparison')} class="btn-primary">
          {copy.diyPrimary}
          <Icon name="arrow-right" size={16} />
        </a>
        <a href={localizedPath(lang, '/guides/choosing-a-surrogacy-agency')} class="btn-ghost">
          {copy.diySecondary}
        </a>
      </div>
    </section>

    <p class="mt-12 border-t border-line pt-6 text-[14px] text-muted">
      {fill(copy.revised, { date: formatDate(UPDATED_ON, lang) })}
    </p>
  </article>
</PageLayout>
