---
/*
 * The brief, and how to use it.
 *
 * This page used to describe an assessment performed for the reader, with no name, no price and no
 * address behind it. The useful half of that description was the document it promised, so the
 * document is now the product: assembled here from the destination records, and handed over by
 * clipboard or file for the reader to address to whoever has to answer it.
 *
 * Every sentence is in src/data/service-pages.ts in both languages, because a page that admits a
 * limitation in English and papers over it in Chinese would be two different offers.
 */
import PageLayout from '@/layouts/PageLayout.astro';
import Breadcrumbs from '@/components/ui/Breadcrumbs.astro';
import Icon from '@/components/ui/Icon.astro';
import BriefBuilder from '@/components/tools/BriefBuilder.astro';
import { ASSESSMENT_PAGE, ASSESSMENT_REVISION } from '@/data/service-pages';
import { formatDate } from '@/lib/dates';
import { langFromPath, localizedPath } from '@/i18n/paths';
import { fill } from '@/i18n/ui';

const lang = langFromPath(Astro.url.pathname);
const copy = ASSESSMENT_PAGE[lang];

/** The three pages that hold the rest of a question list, in the order copy.sendItems names them. */
const SEND_HREFS = [
  '/tools/agency-question-checklist',
  '/tools/destination-research-checklist',
  '/articles/what-must-be-signed-before-the-first-transfer',
];
if (SEND_HREFS.length !== copy.sendItems.length) {
  throw new Error('/assessment names ' + copy.sendItems.length + ' destinations for the brief but has ' + SEND_HREFS.length + ' addresses.');
}

const home = localizedPath(lang, '/');
---

<PageLayout title={copy.title} description={copy.description} updatedOn={ASSESSMENT_REVISION}>
  <Breadcrumbs crumbs={[{ label: copy.title }]} />

  <article class="shell py-10 max-w-[74ch]">
    <h1 class="text-[clamp(2.1rem,4.4vw,3.1rem)] leading-[1.06]">{copy.h1}</h1>
    <p class="mt-4 text-[19px] leading-[1.6] text-muted">{copy.intro}</p>

    <section class="mt-12 border-t border-line pt-8">
      <h2 class="text-[22px]">{copy.partsHeading}</h2>
      <ul class="mt-4 space-y-3 text-[16px] leading-relaxed text-muted">
        {
          copy.parts.map((line) => (
            <li class="flex gap-3">
              <Icon name="check" size={16} class="mt-1.5 shrink-0 text-accent" />
              <span>{line}</span>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="mt-12 border-t border-line pt-8" id="brief">
      <h2 class="text-[22px]">{copy.toolHeading}</h2>
      <p class="mt-3 text-[16px] leading-relaxed text-muted">{copy.toolIntro}</p>
      <div class="mt-7">
        <BriefBuilder />
      </div>
    </section>

    <section class="mt-12 border-t border-line pt-8">
      <h2 class="text-[22px]">{copy.neverHeading}</h2>
      <div class="mt-6 grid gap-8">
        {
          copy.never.map((n) => (
            <div>
              <h3 class="text-[17px] font-semibold">{n.h}</h3>
              <p class="mt-2 text-[16px] leading-relaxed text-muted">{n.p}</p>
            </div>
          ))
        }
      </div>
    </section>

    <section class="mt-12 border-t border-line pt-8">
      <h2 class="text-[22px]">{copy.sendHeading}</h2>
      <p class="mt-3 text-[16px] leading-relaxed text-muted">{copy.sendBody}</p>
      <ul class="mt-5 space-y-3">
        {
          copy.sendItems.map((label, i) => (
            <li>
              <a href={localizedPath(lang, SEND_HREFS[i])} class="textlink text-[16px]">
                {label}
                <Icon name="arrow-right" size={16} />
              </a>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="mt-12 border-t border-line pt-8">
      <h2 class="text-[22px]">{copy.askHeading}</h2>
      <p class="mt-3 text-[16px] leading-relaxed text-muted">{copy.askBody}</p>
      <div class="mt-5 flex flex-wrap gap-3">
        <a href={`${home}#assessment`} class="btn-primary">{copy.askPrimary}</a>
        <a href={localizedPath(lang, '/privacy')} class="btn-ghost">
          {copy.askSecondary}
        </a>
      </div>
    </section>

    <p class="mt-12 border-t border-line pt-6 text-[14px] text-muted">
      {fill(copy.revised, { date: formatDate(ASSESSMENT_REVISION, lang) })}
    </p>
  </article>
</PageLayout>
