---
import PageLayout from '@/layouts/PageLayout.astro';
import Breadcrumbs from '@/components/ui/Breadcrumbs.astro';
import Icon from '@/components/ui/Icon.astro';
import ArticleCard from '@/components/content/ArticleCard.astro';
import EmptyState from '@/components/ui/EmptyState.astro';
import { type CategoryKey } from '@/const';
import { langFromPath, localizedPath } from '@/i18n/paths';
import { CATEGORY_LABELS, UI, fill } from '@/i18n/ui';
import { type ContentEntry } from '@/lib/content';

type Props = { category: CategoryKey; list: ContentEntry[] };

const { category, list } = Astro.props as Props;
const lang = langFromPath(Astro.url.pathname);
const copy = UI[lang].pages;
const label = CATEGORY_LABELS[lang][category];
const sorted = [...list].sort((a, b) => b.data.publishedOn.localeCompare(a.data.publishedOn));

const vars = { label, labelLower: label.toLowerCase() };
const introVars = { n: sorted.length };
---

<PageLayout
  title={fill(copy.category.title, vars)}
  description={
    sorted.length > 0
      ? fill(copy.category.descriptionFull, vars)
      : fill(copy.category.descriptionEmpty, vars)
  }
>
  <Breadcrumbs crumbs={[{ label: copy.articles.title, href: localizedPath(lang, '/articles') }, { label }]} />

  <header class="shell py-10">
    <h1 class="text-[clamp(2rem,4vw,2.9rem)] leading-[1.08]">{label}</h1>
    <p class="mt-3 max-w-[62ch] text-[17px] leading-relaxed text-muted">
      {sorted.length > 0
        ? fill(sorted.length === 1 ? copy.category.introOne : copy.category.introMany, introVars)
        : copy.category.introEmpty}
    </p>
    <a href={localizedPath(lang, '/articles')} class="textlink mt-5">
      {copy.category.allArticles}
      <Icon name="arrow-right" size={16} />
    </a>
  </header>

  <div class="shell pb-16">
    {
      sorted.length > 0 ? (
        <ul class="grid gap-3 sm:grid-cols-2">
          {sorted.map((e) => (
            <ArticleCard entry={e} />
          ))}
        </ul>
      ) : (
        <EmptyState
          title={copy.category.emptyTitle}
          body={copy.category.emptyBody}
          action={{ label: copy.category.emptyAction, href: localizedPath(lang, '/articles') }}
        />
      )
    }
  </div>
</PageLayout>
