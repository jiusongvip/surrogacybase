---
/*
 * The terms of use, in both languages.
 *
 * Terms are the wording a reader would quote back, so the mirror carries all six boundaries and
 * both of the gaps that stop them binding anything yet.
 */
import PageLayout from '@/layouts/PageLayout.astro';
import Breadcrumbs from '@/components/ui/Breadcrumbs.astro';
import NeedsInput from '@/components/ui/NeedsInput.astro';
import { TERMS_PAGE } from '@/data/policy-pages';
import { formatDate } from '@/lib/dates';
import { langFromPath } from '@/i18n/paths';
import { fill } from '@/i18n/ui';

const UPDATED_ON = '2026-10-14';

const lang = langFromPath(Astro.url.pathname);
const copy = TERMS_PAGE[lang];
---

<PageLayout title={copy.title} description={copy.description} updatedOn={UPDATED_ON}>
  <Breadcrumbs crumbs={[{ label: copy.title }]} />

  <article class="shell py-10 max-w-[74ch]">
    <h1 class="text-[clamp(2.1rem,4.4vw,3.1rem)] leading-[1.06]">{copy.h1}</h1>
    <p class="mt-4 text-[19px] leading-[1.6] text-muted">{copy.intro}</p>

    <div class="prose mt-8">
      <p>{copy.acceptance}</p>
    </div>

    <section class="mt-10">
      <h2 class="text-[22px]">{copy.boundaryHeading}</h2>
      <dl class="mt-5 grid gap-6">
        {
          copy.terms.map((t) => (
            <div class="border-t border-line pt-5">
              <dt class="text-[17px] font-semibold">{t.h}</dt>
              <dd class="mt-2 text-[16px] leading-relaxed text-muted">{t.body}</dd>
            </div>
          ))
        }
      </dl>
    </section>

    <section class="mt-12 border-t border-line pt-8">
      <h2 class="text-[22px]">{copy.openHeading}</h2>
      <p class="mt-3 text-[16px] leading-relaxed text-muted">{copy.openIntro}</p>
      <ul class="mt-4 space-y-3 text-[16px]">
        {
          copy.openNeeds.map((n) => (
            <li>
              <NeedsInput label={n.label} why={n.why} />
            </li>
          ))
        }
      </ul>
    </section>

    <p class="mt-12 border-t border-line pt-6 text-[14px] text-muted">
      {fill(copy.revised, { date: formatDate(UPDATED_ON, lang) })}
    </p>
  </article>
</PageLayout>
