---
/*
 * The quote comparison page, one component for both languages.
 *
 * The tool itself is mounted below this header, and its own wording travels with it; what is
 * assembled here is the prose around it, which has to agree with the tool's language rather than
 * with whichever language the route file happened to be written in.
 */
import PageLayout from '@/layouts/PageLayout.astro';
import Breadcrumbs from '@/components/ui/Breadcrumbs.astro';
import Icon from '@/components/ui/Icon.astro';
import QuoteComparison from '@/components/tools/QuoteComparison.astro';
import { QUOTE_PAGE, TOOLS_INDEX_PAGE } from '@/data/tool-pages';
import { langFromPath, localizedPath } from '@/i18n/paths';

const lang = langFromPath(Astro.url.pathname);
const copy = QUOTE_PAGE[lang];
---

<PageLayout title={copy.title} description={copy.description}>
  <Breadcrumbs
    crumbs={[{ label: TOOLS_INDEX_PAGE[lang].label, href: localizedPath(lang, '/tools') }, { label: copy.h1 }]}
  />

  <header class="shell py-10">
    <h1 class="text-[clamp(1.9rem,3.8vw,2.7rem)] leading-[1.08]">{copy.h1}</h1>
    <p class="mt-3 max-w-[62ch] text-[17px] leading-relaxed text-muted">
      {copy.intro}
    </p>
  </header>

  <div class="shell">
    <QuoteComparison />
  </div>

  <section class="shell mt-14 grid gap-10 border-t border-line pt-10 md:grid-cols-[minmax(0,1fr)_minmax(0,1fr)]">
    <div>
      <h2 class="text-[20px]">{copy.howToHeading}</h2>
      <ol class="mt-4 space-y-3 text-[16px] leading-relaxed text-muted">
        {copy.howTo.map((line) => <li>{line}</li>)}
      </ol>
    </div>
    <div>
      <h2 class="text-[20px]">{copy.limitsHeading}</h2>
      <ul class="mt-4 space-y-3 text-[16px] leading-relaxed text-muted">
        {
          copy.limits.map((line) => (
            <li class="flex gap-2.5">
              <Icon name="x" size={16} class="mt-1.5 shrink-0 text-flag" />
              <span>{line}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="shell mt-12 flex flex-wrap items-center justify-between gap-4 rounded-(--radius) bg-sand px-6 py-7">
    <div class="max-w-[54ch]">
      <h2 class="text-[20px]">{copy.bandHeading}</h2>
      <p class="mt-1.5 text-[16px] leading-relaxed text-brand-fg">{copy.bandBody}</p>
    </div>
    <div class="flex flex-wrap gap-3">
      <a href={localizedPath(lang, '/guides/surrogacy-cost')} class="btn-ghost">{copy.bandCostGuide}</a>
      <a href={localizedPath(lang, '/tools/agency-question-checklist')} class="btn-primary">
        {copy.bandQuestions}
      </a>
    </div>
  </section>

  <div class="h-16"></div>
</PageLayout>
