---
/*
 * One checklist page, two languages.
 *
 * The route files that mount this only name which checklist they show, so the questions, the
 * heading and the closing section cannot fall out of step with each other across the mirror: they
 * all come from the same dictionary entry, resolved against the URL.
 */
import PageLayout from '@/layouts/PageLayout.astro';
import Breadcrumbs from '@/components/ui/Breadcrumbs.astro';
import HeroPurpose from '@/components/ui/HeroPurpose.astro';
import Icon from '@/components/ui/Icon.astro';
import ChecklistTool from '@/components/tools/ChecklistTool.astro';
import { CHECKLISTS } from '@/data/checklists';
import { NEXT_STEP } from '@/data/next-steps';
import { TOOLS_INDEX_PAGE } from '@/data/tool-pages';
import { langFromPath, localizedPath } from '@/i18n/paths';
import { pick } from '@/i18n/ui';

type Props = {
  /** The id in src/data/checklists. */
  checklist: string;
};

const { checklist: id } = Astro.props;
const entry = CHECKLISTS.find((c) => c.id === id);
if (!entry) throw new Error(`Checklist "${id}" is not in src/data/checklists.`);

const lang = langFromPath(Astro.url.pathname);
const copy = entry.page[lang];
const home = localizedPath(lang, '/');

const groups = entry.groups.map((g) => ({
  id: g.id,
  title: pick(g.title, lang),
  hint: g.hint ? pick(g.hint, lang) : undefined,
  items: g.items.map((i) => ({ id: i.id, question: pick(i.question, lang) })),
}));

/* The export carries the locale in its name, so a document says which language it was written in. */
const exportName = lang === 'en' ? `${entry.stem}.md` : `${entry.stem}-${lang}.md`;
const hrefs = entry.hrefs.map((h) => localizedPath(lang, h));
---

<PageLayout title={copy.title} description={copy.description}>
  <Breadcrumbs
    crumbs={[{ label: TOOLS_INDEX_PAGE[lang].label, href: localizedPath(lang, '/tools') }, { label: copy.h1 }]}
  />

  <header class="shell py-10 max-w-[74ch]">
    <h1 class="text-[clamp(2.1rem,4.4vw,3.1rem)] leading-[1.06]">{copy.h1}</h1>
    <HeroPurpose text={copy.purpose} />
    <ol class="mt-6 grid gap-4 sm:grid-cols-3">
      {copy.howTo.map((step, i) => (
        <li class="border-t border-line pt-3">
          <span class="tnum text-[13px] font-semibold text-accent">{String(i + 1).padStart(2, '0')}</span>
          <p class="mt-1.5 text-[15px] leading-[1.6] text-muted">{step}</p>
        </li>
      ))}
    </ol>
    <p class="mt-5 flex items-start gap-2.5 text-[15px] leading-relaxed text-muted">
      <Icon name="lock" size={17} class="mt-0.5 shrink-0 text-accent" />
      <span>{copy.note}</span>
    </p>
  </header>

  <div class="shell pb-16 max-w-[1100px]">
    <ChecklistTool {groups} exportName={exportName} />

    <section class="mt-14 border-t border-line pt-8">
      <h2 class="text-[22px]">{copy.closing.heading}</h2>
      <p class="mt-3 max-w-[68ch] text-[16px] leading-[1.75] text-muted">{copy.closing.body}</p>
      {
        entry.cta === 'text' ? (
          <div class="mt-6 flex flex-wrap gap-3">
            <a href={hrefs[0]} class="textlink">
              {copy.links[0]}
              <Icon name="arrow-right" size={16} />
            </a>
            <a href={hrefs[1]} class="textlink">
              {copy.links[1]}
              <Icon name="arrow-right" size={16} />
            </a>
            <a href={`${home}#assessment`} class="textlink" data-enquiry-cta>
              {NEXT_STEP[lang].primary}
              <Icon name="arrow-right" size={16} />
            </a>
          </div>
        ) : (
          <div class="mt-6 flex flex-wrap gap-3">
            <a href={hrefs[0]} class="btn-primary">
              {copy.links[0]}
              <Icon name="arrow-right" size={16} />
            </a>
            <a href={hrefs[1]} class="btn-ghost">{copy.links[1]}</a>
            <a href={`${home}#assessment`} class="textlink" data-enquiry-cta>
              {NEXT_STEP[lang].primary}
              <Icon name="arrow-right" size={16} />
            </a>
          </div>
        )
      }
    </section>
  </div>
</PageLayout>
