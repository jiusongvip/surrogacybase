---
import PageLayout from '@/layouts/PageLayout.astro';
import Breadcrumbs from '@/components/ui/Breadcrumbs.astro';
import Icon from '@/components/ui/Icon.astro';
import ArticleCard from '@/components/content/ArticleCard.astro';
import EmptyState from '@/components/ui/EmptyState.astro';
import { langFromPath, localizedPath } from '@/i18n/paths';
import { UI, TOPIC_LABELS, TOPIC_BLURBS } from '@/i18n/ui';
import { contentImage } from '@/data/content-images';
import { pathOf, getGuides, resolveRefs } from '@/lib/content';

const lang = langFromPath(Astro.url.pathname);
const copy = UI[lang].pages.articles;

/* The same four topics the homepage module uses, so the two cannot disagree about how a piece is
 * filed. Articles with no topic are left out of every group here; every live piece has one. */
const topicOrder = ['legal', 'choice', 'process', 'cost'];

/* Guides and explainers are one collection now, so a single call returns the whole library. The
 * paths below are curated reading orders; everything else is grouped by the question it answers. */
const articles = await getGuides(lang);

const PATH_REFS = [
  [
    'guides/why-no-average-surrogacy-cost-exists',
    'guides/surrogacy-costs-that-sit-outside-a-quote',
    'guides/surrogacy-escrow-accounts-and-payment-stages',
  ],
  [
    'guides/questions-to-ask-about-surrogacy-law-before-choosing-a-destination',
    'guides/getting-a-birth-certificate-accepted-abroad',
    'guides/the-six-month-limit-on-a-uk-parental-order',
  ],
  [
    'guides/what-must-be-signed-before-the-first-transfer',
    'guides/surrogacy-escrow-accounts-and-payment-stages',
  ],
  ['guides/what-40177-transfers-do-not-promise-you'],
];

const paths = (
  await Promise.all(
    PATH_REFS.map(async (refs, i) => ({ ...copy.paths[i], entries: await resolveRefs(refs, lang) })),
  )
).filter((path) => path.entries.length > 0);
---

<PageLayout title={copy.title} titleTag={copy.titleTag} description={copy.description}>
  <Breadcrumbs crumbs={[{ label: copy.title }]} />

  <header class="shell py-10">
    <h1 class="text-[clamp(2.1rem,4.4vw,3.1rem)] leading-[1.06]">{copy.title}</h1>
    {/* No "9 published guides" line under the intro. It counted the library instead of saying
     * anything about a piece, and the same number was cut from the home hero a round earlier --
     * leaving it here would have had the page contradict the page above it. */}
    <p class="mt-3 max-w-[60ch] text-[17px] leading-relaxed text-muted">
      {copy.intro}
    </p>
    {/* The one exit to the editorial policy. A section used to sit further down this page making
     * the same three claims the intro now makes, under a heading about how the pieces are built;
     * the section is gone, and the link is what a reader who wants the checking itself still needs. */}
    <a href={localizedPath(lang, '/editorial-policy')} class="textlink mt-4 inline-flex">
      {copy.standardsLink}
      <Icon name="arrow-right" size={16} />
    </a>
  </header>

  {
    articles.length === 0 ? (
      <div class="shell pb-16">
        <EmptyState
          title={copy.emptyTitle}
          body={copy.emptyBody}
          action={{ label: copy.emptyAction, href: localizedPath(lang, '/editorial-policy') }}
        />
      </div>
    ) : (
      <>
        <section class="shell pb-16" aria-labelledby="paths-h">
          <div class="max-w-[64ch]">
            <h2 id="paths-h" class="text-[clamp(1.6rem,3vw,2.2rem)] leading-[1.12]">
              {copy.startHeading}
            </h2>
            <p class="mt-3 text-[16px] leading-[1.75] text-muted">{copy.startIntro}</p>
          </div>

          <ul class="mt-8 grid gap-4 sm:grid-cols-2">
            {paths.map((path, i) => (
              <li class="card flex flex-col p-6">
                <span class="tnum text-[13px] font-semibold tracking-[0.16em] text-accent">
                  {String(i + 1).padStart(2, '0')}
                </span>
                <h3 class="mt-2 text-[21px] leading-snug">{path.title}</h3>
                <p class="mt-2 text-[15px] leading-[1.7] text-muted">{path.body}</p>
                <ol class="mt-5 flex flex-col gap-1 border-t border-line pt-3">
                  {path.entries.map((entry, j) => (
                    <li>
                      <a
                        href={pathOf(entry)}
                        class="group flex items-start gap-3 py-1.5 text-[15px] leading-snug"
                      >
                        <span class="tnum mt-px text-[13px] text-muted">{j + 1}</span>
                        <span class="group-hover:text-accent">{entry.data.title}</span>
                      </a>
                    </li>
                  ))}
                </ol>
              </li>
            ))}
          </ul>
        </section>

        <section class="border-t border-line bg-surface-2 py-16" aria-labelledby="all-h">
          <div class="shell">
            <h2 id="all-h" class="text-[clamp(1.8rem,3.4vw,2.6rem)] leading-[1.1]">
              {copy.allHeading}
            </h2>
            <div class="mt-10 space-y-12">
              {
                topicOrder
                  .filter((t) => articles.some((a) => a.data.topic === t))
                  .map((t) => (
                    <div>
                      <div class="flex flex-wrap items-baseline gap-x-4 gap-y-1">
                        <h3 class="text-[20px] leading-none font-medium">{TOPIC_LABELS[lang][t]}</h3>
                        <p class="text-[14px] leading-[1.5] text-muted">{TOPIC_BLURBS[lang][t]}</p>
                      </div>
                      <ul class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
                        {articles
                          .filter((a) => a.data.topic === t)
                          .map((entry) => {
                            const image = contentImage(entry.id);
                            /* showKind off: every card on this page is a guide, and the H1 above
                             * already says so. Printing the kind here would repeat that label nine times. */
                            return (
                              <li class="h-full">
                                <ArticleCard entry={entry} showKind={false} image={image} />
                              </li>
                            );
                          })}
                      </ul>
                    </div>
                  ))
              }
            </div>
          </div>
        </section>
      </>
    )
  }
</PageLayout>
