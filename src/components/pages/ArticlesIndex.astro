---
import PageLayout from '@/layouts/PageLayout.astro';
import Breadcrumbs from '@/components/ui/Breadcrumbs.astro';
import Icon from '@/components/ui/Icon.astro';
import ArticleCard from '@/components/content/ArticleCard.astro';
import EmptyState from '@/components/ui/EmptyState.astro';
import { langFromPath, localizedPath } from '@/i18n/paths';
import { UI } from '@/i18n/ui';
import { contentImage } from '@/data/content-images';
import { pathOf, getArticles, getGuides, resolveRefs } from '@/lib/content';
import { GUIDE_CARDS, GUIDE_ORDER } from '@/data/guides';

const lang = langFromPath(Astro.url.pathname);
const copy = UI[lang].pages.articles;

/*
 * Categories still label a card, but they no longer own a page. Five listings that held one or
 * two pieces each read to a search engine as thin pages and to a reader as a detour. This page
 * carries every explainer, and the paths below put them in the order a decision arrives.
 */
const articles = await getArticles(lang);

/* The guides in the order the decisions arrive, topped up with anything the collection holds that
 * GUIDE_ORDER does not, so a guide published later still shows up here. Same construction the
 * homepage uses, so the two cannot disagree about which guide comes second. */
const preferredGuides = await resolveRefs(GUIDE_ORDER, lang);
const otherGuides = await getGuides(lang);
const guidesInOrder = [
  ...preferredGuides,
  ...otherGuides.filter((guide) => !preferredGuides.some((p) => p.id === guide.id)),
];

const PATH_REFS = [
  [
    'articles/why-no-average-surrogacy-cost-exists',
    'articles/surrogacy-costs-that-sit-outside-a-quote',
    'articles/surrogacy-escrow-accounts-and-payment-stages',
  ],
  [
    'articles/questions-to-ask-about-surrogacy-law-before-choosing-a-destination',
    'articles/getting-a-birth-certificate-accepted-abroad',
    'articles/the-six-month-limit-on-a-uk-parental-order',
  ],
  [
    'articles/what-must-be-signed-before-the-first-transfer',
    'articles/surrogacy-escrow-accounts-and-payment-stages',
  ],
  ['articles/what-40177-transfers-do-not-promise-you'],
];

const paths = (
  await Promise.all(
    PATH_REFS.map(async (refs, i) => ({ ...copy.paths[i], entries: await resolveRefs(refs, lang) })),
  )
).filter((path) => path.entries.length > 0);
---

<PageLayout title={copy.title} titleTag={copy.titleTag} description={copy.description}>
  <Breadcrumbs crumbs={[{ label: copy.title }]} />

  <header class="shell py-10">
    <h1 class="text-[clamp(2.1rem,4.4vw,3.1rem)] leading-[1.06]">{copy.title}</h1>
    {/* No "9 published explainers" line under the intro. It counted the library instead of saying
     * anything about a piece, and the same number was cut from the home hero a round earlier --
     * leaving it here would have had the page contradict the page above it. */}
    <p class="mt-3 max-w-[60ch] text-[17px] leading-relaxed text-muted">
      {copy.intro}
    </p>
    {/* The one exit to the editorial policy. A section used to sit further down this page making
     * the same three claims the intro now makes, under a heading about how the pieces are built;
     * the section is gone, and the link is what a reader who wants the checking itself still needs. */}
    <a href={localizedPath(lang, '/editorial-policy')} class="textlink mt-4 inline-flex">
      {copy.standardsLink}
      <Icon name="arrow-right" size={16} />
    </a>
  </header>

  {
    articles.length === 0 ? (
      <div class="shell pb-16">
        <EmptyState
          title={copy.emptyTitle}
          body={copy.emptyBody}
          action={{ label: copy.emptyAction, href: localizedPath(lang, '/editorial-policy') }}
        />
      </div>
    ) : (
      <>
        <section class="shell pb-16" aria-labelledby="paths-h">
          <div class="max-w-[64ch]">
            <h2 id="paths-h" class="text-[clamp(1.6rem,3vw,2.2rem)] leading-[1.12]">
              {copy.startHeading}
            </h2>
            <p class="mt-3 text-[16px] leading-[1.75] text-muted">{copy.startIntro}</p>
          </div>

          <ul class="mt-8 grid gap-4 sm:grid-cols-2">
            {paths.map((path, i) => (
              <li class="card flex flex-col p-6">
                <span class="tnum text-[13px] font-semibold tracking-[0.16em] text-accent">
                  {String(i + 1).padStart(2, '0')}
                </span>
                <h3 class="mt-2 text-[21px] leading-snug">{path.title}</h3>
                <p class="mt-2 text-[15px] leading-[1.7] text-muted">{path.body}</p>
                <ol class="mt-5 flex flex-col gap-1 border-t border-line pt-3">
                  {path.entries.map((entry, j) => (
                    <li>
                      <a
                        href={pathOf(entry)}
                        class="group flex items-start gap-3 py-1.5 text-[15px] leading-snug"
                      >
                        <span class="tnum mt-px text-[13px] text-muted">{j + 1}</span>
                        <span class="group-hover:text-accent">{entry.data.title}</span>
                      </a>
                    </li>
                  ))}
                </ol>
              </li>
            ))}
          </ul>
        </section>

        <section class="border-t border-line bg-surface-2 py-16" aria-labelledby="all-h">
          <div class="shell">
            <h2 id="all-h" class="text-[clamp(1.8rem,3.4vw,2.6rem)] leading-[1.1]">
              {copy.allHeading}
            </h2>
            <ul class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
              {articles.map((entry) => {
                const image = contentImage(entry.id);
                /* showKind off: every card on this page is an explainer, and the H1 above already
                 * says so. Printing the kind here would repeat that label nine times. */
                return (
                  <li class="h-full">
                    <ArticleCard entry={entry} showKind={false} image={image} />
                  </li>
                );
              })}
            </ul>
          </div>
        </section>

        {/* The guides, listed. No sentence about them: this page's H1, the intro and the section
         * heading above already say what an explainer is, and a fourth line explaining that a guide
         * is longer explains nothing a reader can act on. The six titles are the argument. The order
         * is the order the decisions arrive, which is the one thing the numbering carries. Rows stay
         * lighter than the cards above on purpose - this block closes the page, and six bordered
         * boxes would compete with the nine that answer the question the page was written for. The
         * icon travels with each guide in GUIDE_CARDS, so it is a second read of the same page, not
         * a decoration invented here. On hover the row fills with sand, so the icon disc has to go
         * lighter, not darker: a translucent brand over sand dries out to a muddy grey, and the
         * accent tint is the light-warm step the palette already carries for exactly this. */}
        <section class="shell pt-12 pb-20" aria-labelledby="guides-h">
          <div class="flex items-center gap-5">
            <h2 id="guides-h" class="text-[19px] leading-none">{copy.guidesHeading}</h2>
            <span class="mt-px h-px flex-1 bg-line" aria-hidden="true" />
          </div>
          <ol class="mt-3 grid gap-2 sm:grid-cols-2">
            {
              guidesInOrder.map((guide, i) => {
                const card = GUIDE_CARDS[guide.id.split('/').pop() ?? ''];
                return (
                  <li class="flex">
                    <a
                      href={pathOf(guide)}
                      class="group flex flex-1 items-center gap-4 rounded-(--radius) px-4 py-3 transition-colors duration-(--dur) ease-(--ease) hover:bg-sand"
                    >
                      <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-surface-2 transition-colors duration-(--dur) ease-(--ease) group-hover:bg-accent-tint">
                        <Icon name={card?.icon ?? 'book'} size={18} class="text-accent" />
                      </span>
                      <span class="min-w-0 flex-1 text-[15px] leading-snug transition-colors duration-(--dur) group-hover:text-accent">
                        {guide.data.title}
                      </span>
                      <span class="tnum shrink-0 text-[12px] text-muted">
                        {String(i + 1).padStart(2, '0')}
                      </span>
                    </a>
                  </li>
                );
              })
            }
          </ol>
        </section>
      </>
    )
  }
</PageLayout>
