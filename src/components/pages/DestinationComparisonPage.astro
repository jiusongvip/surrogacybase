---
/*
 * The destination comparison page, one component for both languages.
 *
 * The board below the header is assembled from published jurisdiction records and prints only
 * what those records carry. The prose here is the frame around it: what the comparison does not
 * do, and where to take the shortlist once it has been narrowed.
 */
import PageLayout from '@/layouts/PageLayout.astro';
import Breadcrumbs from '@/components/ui/Breadcrumbs.astro';
import HeroPurpose from '@/components/ui/HeroPurpose.astro';
import Icon from '@/components/ui/Icon.astro';
import DestinationComparison from '@/components/tools/DestinationComparison.astro';
import { DESTINATION_COMPARE_PAGE } from '@/data/destination-comparison';
import { TOOLS_INDEX_PAGE } from '@/data/tool-pages';
import { langFromPath, localizedPath } from '@/i18n/paths';

const lang = langFromPath(Astro.url.pathname);
const copy = DESTINATION_COMPARE_PAGE[lang];
const home = localizedPath(lang, '/');
---

<PageLayout title={copy.title} titleTag={copy.titleTag} description={copy.description}>
  <Breadcrumbs
    crumbs={[{ label: TOOLS_INDEX_PAGE[lang].label, href: localizedPath(lang, '/tools') }, { label: copy.h1 }]}
  />

  <header class="shell py-10 max-w-[74ch]">
    <h1 class="text-[clamp(2.1rem,4.4vw,3.1rem)] leading-[1.06]">{copy.h1}</h1>
    <HeroPurpose text={copy.purpose} />
    <p class="mt-4 text-[18px] leading-[1.65] text-muted">{copy.lede}</p>
    <p class="mt-4 flex items-start gap-2.5 text-[15px] leading-relaxed text-muted">
      <Icon name="scale" size={17} class="mt-0.5 shrink-0 text-accent" />
      <span>{copy.note}</span>
    </p>
  </header>

  <div class="shell pb-14">
    <DestinationComparison />
  </div>

  <section class="shell pb-12 max-w-[74ch]">
    <h2 class="text-[22px]">{copy.limitsHeading}</h2>
    <ul class="mt-4 space-y-3">
      {
        copy.limits.map((line) => (
          <li class="flex gap-2.5 text-[16px] leading-relaxed text-muted">
            <Icon name="x" size={16} class="mt-1.5 shrink-0 text-flag" />
            <span>{line}</span>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="shell pb-16 max-w-[74ch]">
    <h2 class="text-[22px]">{copy.closingHeading}</h2>
    <p class="mt-3 text-[16px] leading-[1.75] text-muted">{copy.closingBody}</p>
    <div class="mt-6 flex flex-wrap gap-3">
      <a href={localizedPath(lang, '/tools/destination-research-checklist')} class="btn-primary">
        {copy.checklist}
        <Icon name="arrow-right" size={16} />
      </a>
      <a href={localizedPath(lang, '/guides/surrogacy-legal-considerations')} class="btn-ghost">{copy.legalGuide}</a>
      <a href={`${home}#assessment`} class="btn-ghost" data-enquiry-cta>{copy.enquiry}</a>
    </div>
  </section>
</PageLayout>
