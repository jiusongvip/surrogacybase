---
/*
 * The homepage, in both languages.
 *
 * The page now runs in the order a reader arrives: what the word means, how the arrangement
 * works, the stages, the money, and the pattern this site calls the trap — then the country
 * records, the questions, the sources, and the enquiry band. The owner asked for the country
 * section and the form to stay; everything above them is written against the phrases people
 * actually search for ("surrogacy meaning", "how does surrogacy work", "surrogacy process",
 * "surrogacy cost", "the surrogacy trap"), and each of those sections lives in its own component
 * under src/components/home so that one block can be revised without re-reading the page.
 *
 * Two things are unchanged from the previous draft, because they were the parts that worked.
 * The country cards are the published jurisdiction records, so a card cannot appear for a
 * country nobody has sourced. And every number printed in the country band is read off the
 * collection it describes, so no section can advertise more than the site holds.
 *
 * This is a component rather than a page because / and /zh render the same argument twice, and a
 * second copy of the markup is a second place for the two languages to drift apart.
 */
import PageLayout from '@/layouts/PageLayout.astro';
import Icon from '@/components/ui/Icon.astro';
import ConsultForm from '@/components/forms/ConsultForm.astro';
import Meaning from '@/components/home/Meaning.astro';
import Mechanics from '@/components/home/Mechanics.astro';
import Process from '@/components/home/Process.astro';
import Cost from '@/components/home/Cost.astro';
import Trap from '@/components/home/Trap.astro';
import Faq from '@/components/home/Faq.astro';
import Sources from '@/components/home/Sources.astro';
import { SITE } from '@/const';
import { langFromPath, localizedPath } from '@/i18n/paths';
import { fill, pick } from '@/i18n/ui';
import { formatShortDate } from '@/lib/dates';
import { getJurisdictions } from '@/lib/jurisdictions';
import { HOME_BAND, HOME_BAND_TRUST, HOME_COUNTRIES, HOME_HERO, HOME_META } from '@/data/home';
import { HOME_FAQ, HOME_SOURCES } from '@/data/home-evidence';
import { Image } from 'astro:assets';
import heroTerrace from '@/assets/images/hero-terrace.jpg';

const lang = langFromPath(Astro.url.pathname);
const records = await getJurisdictions(lang);
const meta = HOME_META[lang];
const hero = HOME_HERO[lang];
const countries = HOME_COUNTRIES[lang];
const band = HOME_BAND[lang];

/* The hero anchor is read off the two collections it describes, so adding a record or re-opening a
 * source moves the line by itself. A number written into the string would be a number the page
 * could grow past without noticing. */
const lastChecked = HOME_SOURCES.reduce(
  (latest, source) => (source.checkedOn > latest ? source.checkedOn : latest),
  HOME_SOURCES[0].checkedOn,
);
const heroKicker = fill(hero.kicker, { n: records.length, date: formatShortDate(lastChecked, lang) });

/* The hero is deliberately thin: the anchors, the scope, the four questions, and the two ways
 * forward. The one count it prints is the number of records, because that is the scope the reader
 * is choosing to enter. The guides and tools stay unlisted, since those are small numbers to
 * someone deciding whether to stay, and the source list is printed at the foot of the page rather
 * than counted twice. There is no second invitation, because the ghost button already points at
 * the form. */

/** The mock's order, with any record that is not listed kept after it rather than dropped. */
const COUNTRY_ORDER = ['us', 'ca', 'gb', 'co', 'gr'];
const byOrder = (a: { data: { code: string } }, b: { data: { code: string } }) => {
  const i = COUNTRY_ORDER.indexOf(a.data.code);
  const j = COUNTRY_ORDER.indexOf(b.data.code);
  return (i < 0 ? COUNTRY_ORDER.length : i) - (j < 0 ? COUNTRY_ORDER.length : j);
};
/* The flag is the only picture a country card can carry without inventing something. A landscape
 * under a country name implies the place was photographed, and none of these were; the flag says
 * only what the record says, which is that the page is about that jurisdiction. Under the name sits
 * the one line a reader comparing countries is actually looking for: whether the route is open to
 * someone like them. The record's own counts are not printed here - how many sentences an edit
 * sourced and how many questions it left are the workshop, not the answer. */
const cards = [...records].sort(byOrder).map((row) => ({
  code: row.data.code,
  href: `/destinations/${row.data.code}`,
  name: row.data.name,
  region: row.data.region,
  note: countries.notes[row.data.code] ?? '',
}));

/* The questions section is also the page's FAQPage markup. The answers are printed in full on the
 * page, so the schema restates what a reader can already see rather than describing hidden text. */
const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: HOME_FAQ[lang].items.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: item.a },
  })),
};

const lp = (path: string) => localizedPath(lang, path);
const home = localizedPath(lang, '/');
---

<PageLayout title={SITE.name} titleTag={meta.titleTag} description={meta.description} jsonLd={[faqLd]}>
  {/*
    * 1. Hero. The frame runs edge to edge and the copy sits on it. The section is 580px at
    * desktop, so the heading of the section below shows above the fold and the reader can see
    * the page continues.
    *
    * This block introduces the site, not the topic. The heading names what the site holds and the
    * sentence under it names what a record answers, because a first-time reader's first question is
    * what this place is for. The definition of the word is not repeated here: it opens the section
    * immediately below, where it stands alone and can be quoted on its own.
    * The primary action goes to the country records, which are what the site is; a reader who
    * wants the explanation is already one scroll away from it.
    */}
  <section class="relative isolate overflow-hidden border-b border-line bg-paper" id="top">
    <Image
      src={heroTerrace}
      widths={[720, 1100, 1536]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
      class="block h-[220px] w-full object-cover sm:h-[300px] lg:absolute lg:inset-0 lg:h-full lg:w-full"
      alt={hero.imageAlt}
    />
    <div class="absolute inset-0 hidden bg-linear-to-r from-paper via-paper/85 to-paper/0 lg:block" aria-hidden="true"></div>

    <div class="shell relative flex items-center py-10 sm:py-12 lg:min-h-[640px] lg:py-16">
      {/*
        * The width cap is what keeps the wash honest: every line has to end where the paper is
        * still paper, so the column stops at 600 rather than growing with the frame.
        */}
      <div class="max-w-[600px]">
        {/*
          * The kicker carries the three things a reader can check rather than a description of
          * themselves: who compiled this, how many records it holds, when the material was last
          * opened. The heading under it names what the site holds.
          */}
        <p class="eyebrow rise">{heroKicker}</p>
        <h1
          class:list={[
            'rise rise-1 mt-3.5 text-balance text-[clamp(2.05rem,3.4vw,3rem)] leading-[1.06] text-brand-fg',
            /* Han characters are already full-width squares, so the display tracking that
               stops a Latin headline looking loose crowds them. */
            lang === 'zh' ? '' : 'tracking-[-0.02em]',
          ]}
        >
          {hero.h1}
        </h1>
        <p class="rise rise-2 mt-6 max-w-[52ch] text-[16.5px] leading-[1.7] text-text lg:text-[17.5px]">
          {hero.lead}
        </p>
        <div class="rise rise-2 mt-9 flex flex-wrap items-center gap-3">
          <a href={`${home}#destinations`} class="btn-primary">
            {hero.ctaPrimary}
            <Icon name="arrow-down-right" size={16} />
          </a>
          <a href={`${home}#assessment`} class="btn-ghost" data-enquiry-cta>{hero.ctaSecondary}</a>
        </div>
      </div>
    </div>
  </section>

  {/* 2-6. The explanatory run: meaning, mechanics, process, cost, and the trap. */}
  <Meaning />
  <Mechanics />
  <Process />
  <Cost />
  <Trap />

  {/*
    * 7. The country records, on the deep green. This is the section the owner asked to keep, and
    * it is the one full-colour band in the page: cells that share their rules like a printed
    * table, each a flag, the jurisdiction, and the line on who can use the route. Cells rather
    * than cards, because eight cards float apart and eight cells read as one atlas.
    */}
  <section class="scroll-mt-20 bg-brand py-16 lg:py-24" id="destinations">
    <div class="shell">
      <h2 class="max-w-[26ch] text-balance text-[clamp(1.9rem,3.2vw,2.85rem)] leading-[1.08] text-band">
        {countries.heading}
      </h2>
      <p class="mt-5 max-w-[62ch] text-[16px] leading-[1.75] text-band-muted">{countries.intro}</p>

      <ul class="mt-12 grid grid-cols-1 gap-px border border-band/15 bg-band/15 sm:grid-cols-2 lg:grid-cols-4">
        {
          cards.map((c) => (
            <li>
              <a
                href={lp(c.href)}
                class="group flex h-full flex-col bg-brand p-6 transition-colors duration-(--dur) hover:bg-band/[0.07] lg:p-7"
              >
                <img
                  src={`/flags/${c.code}.svg`}
                  alt=""
                  width={64}
                  height={48}
                  loading="lazy"
                  decoding="async"
                  class="h-[36px] w-auto self-start rounded-[2px] ring-1 ring-band/25"
                />
                <span class="mt-5 block font-display text-[1.25rem] leading-tight text-band">{c.name}</span>
                <span class="mt-1 block text-[12.5px] leading-tight text-band-muted">{c.region}</span>
                {c.note ? <span class="mt-3 block text-[14px] leading-[1.55] text-band-muted">{c.note}</span> : null}
              </a>
            </li>
          ))
        }
      </ul>

      <div class="mt-7 flex justify-end">
        <a href={lp('/destinations')} class="exit-on-band">
          {countries.cta}
          <Icon name="arrow-right" size={15} />
        </a>
      </div>
    </div>
  </section>

  {/* 8-9. The questions, then the documents they rest on, so a reader can check the page itself. */}
  <Faq />
  <Sources />

  {/*
    * 10. The enquiry. The form delivers when the inbox is configured, and falls back to a
    * message the reader sends themselves when it is not.
    */}
  <section class="band-brand relative isolate scroll-mt-20 overflow-hidden py-16 lg:py-24" id="assessment">
    <div class="shell grid gap-12 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.02fr)] lg:gap-16">
      <div>
        <h2
          class="max-w-[16ch] text-balance text-[clamp(1.9rem,3.1vw,2.9rem)] leading-[1.08] text-band"
          id="consult-heading"
        >
          {band.heading}
        </h2>
        <p class="mt-6 max-w-[46ch] text-[16px] leading-[1.8] text-band-muted">{band.para}</p>

        <ul class="mt-10 grid gap-x-10 gap-y-7 border-t border-white/15 pt-8 sm:grid-cols-2">
          {
            HOME_BAND_TRUST.map((t) => (
              <li>
                <span class="flex items-center gap-2 text-[14.5px] text-band">
                  <Icon name={t.icon} size={16} />
                  {pick(t.label, lang)}
                </span>
                <p class="mt-2 max-w-[26ch] text-[13.5px] leading-[1.6] text-band-muted">{pick(t.body, lang)}</p>
              </li>
            ))
          }
        </ul>

        {/* A reader who is not ready to write anything still has somewhere to go, so the band offers
            one method page beside the form rather than only the form. Not .textlink: that class is
            cut for a light surface, and its nowrap would overflow a narrow column. */}
        <a
          href={lp(band.link.href)}
          class="mt-8 inline-flex items-center gap-2 border-b border-band/40 pb-1 text-[15px] font-medium text-band transition-colors duration-(--dur) hover:border-band"
        >
          {band.link.label}
          <Icon name="arrow-right" size={15} />
        </a>
      </div>

      <div class="shadow-lift">
        <ConsultForm />
      </div>
    </div>
  </section>
</PageLayout>
