---
import ContentLayout from '@/layouts/ContentLayout.astro';
import { langFromPath, localizedPath } from '@/i18n/paths';
import { UI } from '@/i18n/ui';
import { renderContent, relatedFor, toolLinksFor, type ContentEntry } from '@/lib/content';

type Props = { entry: ContentEntry };

const { entry } = Astro.props;
const lang = langFromPath(Astro.url.pathname);
const copy = UI[lang].pages;
const { Content, headings } = await renderContent(entry);
const { related } = await relatedFor(entry, lang);

const toolLinks = toolLinksFor(entry.data.relatedTools, lang);
if (entry.data.category === 'destinations') {
  toolLinks.push({
    label: copy.detail.destinationConditions,
    href: localizedPath(lang, '/destinations'),
    note: copy.detail.destinationConditionsNote,
  });
}

const crumbs = [
  { label: copy.articles.title, href: localizedPath(lang, '/guides') },
  { label: entry.data.title },
];
---

<ContentLayout
  entry={entry}
  Content={Content}
  headings={headings}
  crumbs={crumbs}
  related={related}
  relatedTools={toolLinks}
/>
