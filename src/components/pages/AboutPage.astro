---
/*
 * The About page in whichever language the URL says it is.
 *
 * The "we are not" statements, and the statement about what an enquiry costs the reader, are the
 * same data on both sides of the mirror, so they come from one dictionary entry rather than from
 * two files that can drift apart.
 */
import PageLayout from '@/layouts/PageLayout.astro';
import Breadcrumbs from '@/components/ui/Breadcrumbs.astro';
import { SITE } from '@/const';
import { ABOUT_PAGE } from '@/data/service-pages';
import { READER_CASES, REVIEWERS } from '@/data/trust';
import { langFromPath, localizedPath } from '@/i18n/paths';
import { fill, pick } from '@/i18n/ui';
import { formatDate } from '@/lib/dates';

const lang = langFromPath(Astro.url.pathname);
const copy = ABOUT_PAGE[lang];
const reviewers = REVIEWERS;
const cases = READER_CASES.filter((entry) => entry.published);

/*
 * These questions are the page's own visible text, so the markup restates them rather than
 * adding a set of questions written for a search result. A machine reader gets the same answers
 * a visitor reads.
 */
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: copy.statements.map((s) => ({
      '@type': 'Question',
      name: s.q,
      acceptedAnswer: { '@type': 'Answer', text: s.a },
    })),
  },
];
---

<PageLayout title={copy.title} titleTag={copy.titleTag} description={copy.description} jsonLd={jsonLd}>
  <Breadcrumbs crumbs={[{ label: copy.title }]} />

  <article class="shell py-10 max-w-[74ch]">
    <h1 class="text-[clamp(2.1rem,4.4vw,3.1rem)] leading-[1.06]">{fill(copy.h1, { name: SITE.name })}</h1>
    <p class="mt-4 text-[19px] leading-[1.6] text-muted">{copy.tagline}</p>

    <div class="prose mt-8">
      {
        copy.body.map((paragraph) => (
          <p>{paragraph}</p>
        ))
      }
    </div>

    <section class="mt-12 border-t border-line pt-8">
      <h2 class="text-[22px]">{copy.notHeading}</h2>
      <dl class="mt-5 grid gap-6">
        {
          copy.statements.map((s) => (
            <div>
              <dt class="text-[17px] font-semibold">{s.q}</dt>
              <dd class="mt-1.5 text-[16px] leading-relaxed text-muted">{s.a}</dd>
            </div>
          ))
        }
      </dl>
    </section>

    <section class="mt-12 border-t border-line pt-8">
      <h2 class="text-[22px]">{copy.whoHeading}</h2>
      <p class="mt-3 text-[16px] leading-relaxed text-muted">{fill(copy.whoBody, { team: SITE.team, board: SITE.board })}</p>
    </section>

    <section class="mt-12 border-t border-line pt-8" id="review">
      <h2 class="text-[22px]">{copy.reviewHeading}</h2>
      <p class="mt-3 text-[16px] leading-relaxed text-muted">{fill(copy.reviewBody, { board: SITE.board })}</p>

      {
        reviewers.length > 0 && (
          <ul class="mt-6 grid gap-4 sm:grid-cols-2">
            {reviewers.map((reviewer) => {
              const external = /^https?:\/\//.test(reviewer.credentialUrl);
              const href = external ? reviewer.credentialUrl : localizedPath(lang, reviewer.credentialUrl);
              return (
                <li class="rounded-(--radius) border border-line bg-surface p-5">
                  <p class="text-[17px] font-semibold">{reviewer.name}</p>
                  <p class="mt-1 text-[15px] text-muted">{pick(reviewer.role, lang)}</p>
                  <a
                    class="mt-2 inline-block text-[14px] text-accent underline"
                    href={href}
                    target={external ? '_blank' : undefined}
                    rel={external ? 'noopener noreferrer' : undefined}
                  >
                    {pick(reviewer.credentialLabel, lang)}
                  </a>
                  <p class="mt-2 text-[13px] text-muted">
                    {fill(copy.reviewerReviewed, { date: formatDate(reviewer.reviewedOn, lang) })}
                  </p>
                </li>
              );
            })}
          </ul>
        )
      }

      <h3 class="mt-10 text-[20px]">{copy.casesHeading}</h3>
      <p class="mt-3 text-[16px] leading-relaxed text-muted">{copy.casesBody}</p>

      {
        cases.length > 0 && (
          <div class="mt-6 grid gap-5 lg:grid-cols-2">
            {cases.map((entry) => (
              <article class="rounded-(--radius-card) border border-line bg-surface p-6">
                <p class="text-[13px] font-semibold uppercase tracking-[0.12em] text-muted">{pick(entry.label, lang)}</p>
                <p class="mt-3 text-[16px] leading-relaxed">{pick(entry.situation, lang)}</p>
                <p class="mt-3 text-[15px] leading-relaxed text-muted">{pick(entry.checked, lang)}</p>
                <p class="mt-4 text-[13px] text-muted">
                  {fill(copy.caseConsent, { date: formatDate(entry.consentOn, lang) })}
                </p>
                <ul class="mt-3 flex flex-wrap gap-x-4 gap-y-1 text-[14px]">
                  {entry.links.map((link) => (
                    <li>
                      <a class="text-accent underline" href={localizedPath(lang, link.href)}>
                        {pick(link.label, lang)}
                      </a>
                    </li>
                  ))}
                </ul>
              </article>
            ))}
          </div>
        )
      }
    </section>

    <section class="mt-12 border-t border-line pt-8" id="contact">
      <h2 class="text-[22px]">{copy.correctionsHeading}</h2>
      <p class="mt-3 text-[16px] leading-relaxed text-muted">{fill(copy.correctionsBody, { email: SITE.contactEmail })}</p>
    </section>
  </article>
</PageLayout>
