---
/*
 * The About page in whichever language the URL says it is.
 *
 * The four "we are not" statements and the list of things still missing are the same data on both
 * sides of the mirror, so they come from one dictionary entry rather than from two files that can
 * drift apart.
 */
import PageLayout from '@/layouts/PageLayout.astro';
import Breadcrumbs from '@/components/ui/Breadcrumbs.astro';
import NeedsInput from '@/components/ui/NeedsInput.astro';
import { SITE } from '@/const';
import { ABOUT_PAGE } from '@/data/service-pages';
import { langFromPath } from '@/i18n/paths';
import { fill } from '@/i18n/ui';

const lang = langFromPath(Astro.url.pathname);
const copy = ABOUT_PAGE[lang];
---

<PageLayout title={copy.title} description={copy.description}>
  <Breadcrumbs crumbs={[{ label: copy.title }]} />

  <article class="shell py-10 max-w-[74ch]">
    <h1 class="text-[clamp(2.1rem,4.4vw,3.1rem)] leading-[1.06]">{fill(copy.h1, { name: SITE.name })}</h1>
    <p class="mt-4 text-[19px] leading-[1.6] text-muted">{copy.tagline}</p>

    <div class="prose mt-8">
      {
        copy.body.map((paragraph) => (
          <p>{paragraph}</p>
        ))
      }
    </div>

    <section class="mt-12 border-t border-line pt-8">
      <h2 class="text-[22px]">{copy.notHeading}</h2>
      <dl class="mt-5 grid gap-6">
        {
          copy.statements.map((s) => (
            <div>
              <dt class="text-[17px] font-semibold">{s.q}</dt>
              <dd class="mt-1.5 text-[16px] leading-relaxed text-muted">{s.a}</dd>
            </div>
          ))
        }
      </dl>
    </section>

    <section class="mt-12 border-t border-line pt-8">
      <h2 class="text-[22px]">{copy.whoHeading}</h2>
      <p class="mt-3 text-[16px] leading-relaxed text-muted">{fill(copy.whoBody, { team: SITE.team })}</p>
      <ul class="mt-4 space-y-3 text-[16px]">
        {
          copy.whoNeeds.map((n) => (
            <li>
              <NeedsInput label={n.label} why={n.why} />
            </li>
          ))
        }
      </ul>
    </section>

    <section class="mt-12 border-t border-line pt-8" id="contact">
      <h2 class="text-[22px]">{copy.correctionsHeading}</h2>
      <p class="mt-3 text-[16px] leading-relaxed text-muted">{copy.correctionsBody}</p>
      <p class="mt-3 text-[16px] leading-relaxed text-muted">
        <NeedsInput label={copy.correctionsNeeds.label} why={copy.correctionsNeeds.why} />
      </p>
    </section>
  </article>
</PageLayout>
