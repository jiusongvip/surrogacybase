---
/*
 * The privacy page, in both languages.
 *
 * It describes the build, so the Chinese text has to describe the same build: the same absence of
 * cookies, the same local-storage tool, the same enquiry form with no endpoint behind it. What is not
 * settled yet is not listed here in its own words: one register on the About page holds it, and this
 * page points there, so a gap cannot be described one way in English and another way in Chinese.
 */
import PageLayout from '@/layouts/PageLayout.astro';
import Breadcrumbs from '@/components/ui/Breadcrumbs.astro';
import Icon from '@/components/ui/Icon.astro';
import OpenQuestionsNote from '@/components/ui/OpenQuestionsNote.astro';
import { PRIVACY_PAGE, PRIVACY_REVISION } from '@/data/policy-pages';
import { formatDate } from '@/lib/dates';
import { langFromPath } from '@/i18n/paths';
import { fill } from '@/i18n/ui';

const UPDATED_ON = PRIVACY_REVISION;

const lang = langFromPath(Astro.url.pathname);
const copy = PRIVACY_PAGE[lang];
---

<PageLayout title={copy.title} description={copy.description} updatedOn={UPDATED_ON}>
  <Breadcrumbs crumbs={[{ label: copy.title }]} />

  <article class="shell py-10 max-w-[74ch]">
    <h1 class="text-[clamp(2.1rem,4.4vw,3.1rem)] leading-[1.06]">{copy.h1}</h1>
    <p class="mt-4 text-[19px] leading-[1.6] text-muted">{copy.intro}</p>

    <section class="mt-10 rounded-(--radius) border border-line bg-surface p-6">
      <h2 class="text-[15px] font-semibold">{copy.shortHeading}</h2>
      <p class="mt-2 text-[16px] leading-relaxed">{copy.shortBody}</p>
    </section>

    <section class="mt-12">
      <h2 class="text-[22px]">{copy.storedHeading}</h2>
      <dl class="mt-5 grid gap-6">
        {
          copy.stored.map((c) => (
            <div class="border-t border-line pt-5">
              <dt class="text-[17px] font-semibold">{c.h}</dt>
              <dd class="mt-2 text-[16px] leading-relaxed text-muted">{c.body}</dd>
            </div>
          ))
        }
      </dl>
    </section>

    <section class="mt-12 border-t border-line pt-8">
      <h2 class="text-[22px]">{copy.avoidedHeading}</h2>
      <ul class="mt-4 space-y-3 text-[16px] leading-relaxed text-muted">
        {
          copy.avoided.map((a) => (
            <li class="flex gap-3">
              <Icon name="x" size={16} class="mt-1.5 shrink-0 text-muted" />
              <span>{a}</span>
            </li>
          ))
        }
      </ul>
      <p class="mt-6 text-[16px] leading-relaxed">{copy.avoidedTail}</p>
    </section>

    <section class="mt-12 border-t border-line pt-8">
      <h2 class="text-[22px]">{copy.strictHeading}</h2>
      <p class="mt-3 text-[16px] leading-relaxed text-muted">{copy.strictBody}</p>
    </section>

    <section class="mt-12 border-t border-line pt-8">
      <h2 class="text-[22px]">{copy.contactHeading}</h2>
      <ul class="mt-4 space-y-3 text-[16px] leading-relaxed text-muted">
        {
          copy.contact.map((s) => <li class="border-l-2 border-accent pl-5">{s}</li>)
        }
      </ul>
    </section>

    <section class="mt-12 border-t border-line pt-8">
      <h2 class="text-[22px]">{copy.unsettledHeading}</h2>
      <p class="mt-3 text-[16px] leading-relaxed text-muted">{copy.unsettledIntro}</p>
      <p class="mt-6 text-[16px] leading-relaxed">{copy.rightsBody}</p>
      <OpenQuestionsNote />
    </section>

    <p class="mt-12 border-t border-line pt-6 text-[14px] text-muted">
      {fill(copy.revised, { date: formatDate(UPDATED_ON, lang) })}
    </p>
  </article>
</PageLayout>
