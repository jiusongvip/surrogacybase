---
/*
 * The checklist as a reading list, plus one button.
 *
 * Every question sits on the page in the language the page is written in, grouped by who usually
 * owns the answer. The status dropdown and the note field that used to sit beside each question are
 * gone: sixty-six controls stood between a visitor and the questions, and a draft kept in a browser
 * is a worse place for those answers than a file. The download writes the same questions with an
 * empty box beside each, so the ticking off happens in any editor, or in the hands of the
 * professional being asked. Nothing on this page collects, stores or sends anything.
 *
 * The questions are server-rendered, so the page reads and prints the same with JavaScript
 * switched off, and the exported file can only ever say what the screen shows.
 */
import Icon from '@/components/ui/Icon.astro';
import { LANG_META } from '@/i18n/config';
import { langFromPath } from '@/i18n/paths';
import { fill } from '@/i18n/ui';
import { CHECKLIST_CHROME } from '@/data/checklists';

type Props = {
  /** Resolved for this page's language by the page that mounts the tool. */
  groups: {
    id: string;
    title: string;
    hint?: string;
    items: { id: string; question: string }[];
  }[];
  /** Stamped with the locale, so an exported file says which language it was written in. */
  exportName: string;
};

const { groups, exportName } = Astro.props;

/*
 * The tool is used from both locales, so the copy is resolved here rather than passed in: a prop
 * a page can hand over in the wrong language is a page that prints the wrong language.
 */
const lang = langFromPath(Astro.url.pathname);
const chrome = CHECKLIST_CHROME[lang];
const questionTotal = groups.reduce((sum, group) => sum + group.items.length, 0);
---

<div data-checklist data-export={exportName} data-locale={LANG_META[lang].dateLocale} data-copy={JSON.stringify(chrome)}>
  <div class="flex flex-wrap items-end gap-3">
    <button type="button" class="btn-ghost text-sm" data-action="export">
      <Icon name="download" size={15} />
      {chrome.exportButton}
    </button>
  </div>
  <p class="mt-3 max-w-[68ch] text-[14px] leading-relaxed text-muted">{chrome.exportNote}</p>

  <nav
    class="mt-8 rounded-(--radius) border border-line bg-surface-2/60 px-4 py-4 sm:px-5"
    aria-labelledby="checklist-contents"
  >
    <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
      <h2 id="checklist-contents" class="text-[14px] font-semibold">{chrome.contentsHeading}</h2>
      <p class="text-[13px] text-muted">
        {fill(chrome.totalCount, { groups: groups.length, questions: questionTotal })}
      </p>
    </div>
    <ol class="mt-3 grid gap-x-6 gap-y-1 sm:grid-cols-2">
      {
        groups.map((group, index) => (
          <li>
            <a
              href={`#${group.id}`}
              class="flex items-baseline justify-between gap-3 rounded-(--radius) py-1.5 text-[14px] leading-snug hover:text-accent"
            >
              <span>
                <span class="tnum mr-2 text-[13px] text-muted">{index + 1}</span>
                {group.title}
              </span>
              <span class="shrink-0 text-[12.5px] text-muted">
                {fill(chrome.questionCount, { n: group.items.length })}
              </span>
            </a>
          </li>
        ))
      }
    </ol>
  </nav>

  {
    groups.map((group) => (
      <section class="mt-10 scroll-mt-24" id={group.id} data-group={group.id}>
        <h2 class="text-[19px] leading-snug">{group.title}</h2>
        {group.hint ? <p class="mt-1.5 text-[14px] leading-relaxed text-muted" data-group-hint>{group.hint}</p> : null}

        <ul class="mt-4 border-t border-line">
          {group.items.map((item) => (
            <li class="border-b border-line py-3.5">
              <p class="text-[15px] leading-[1.6]" data-question>
                {item.question}
              </p>
            </li>
          ))}
        </ul>
      </section>
    ))
  }

  <div class="mt-10 border-t border-line pt-6">
    <button type="button" class="btn-ghost text-sm" data-action="export">
      <Icon name="download" size={15} />
      {chrome.exportButton}
    </button>
    <p class="mt-3 max-w-[68ch] text-[14px] leading-relaxed text-muted">{chrome.bottomNote}</p>
  </div>
</div>

<script>
  for (const root of Array.from(document.querySelectorAll<HTMLElement>('[data-checklist]'))) {
    /* One bundle serves both languages, so the wording comes off the page rather than the dictionary. */
    const T = JSON.parse(root.dataset.copy!);
    const locale = root.dataset.locale ?? 'en-US';
    const fileName = root.dataset.export ?? 'checklist.md';

    const text = (el: Element | null | undefined) => el?.textContent?.trim() ?? '';

    /** Re-reads the rendered page, so the file cannot drift from what the screen shows. */
    function asMarkdown(): string {
      const title = document.querySelector<HTMLElement>('h1')?.textContent?.trim() || T.fallbackTitle;
      const savedAt = new Date().toLocaleString(locale, { dateStyle: 'long', timeStyle: 'short' });
      const lines: string[] = [`# ${title}`, '', `${T.savedLine} ${savedAt}`, '', T.fileHint];
      for (const section of Array.from(root.querySelectorAll<HTMLElement>('[data-group]'))) {
        lines.push('', `## ${text(section.querySelector('h2'))}`);
        const hint = section.querySelector<HTMLElement>('[data-group-hint]');
        if (hint) lines.push('', `_${text(hint)}_`);
        for (const item of Array.from(section.querySelectorAll<HTMLElement>('[data-question]'))) {
          lines.push('', `- [ ] ${text(item)}`);
        }
      }
      lines.push('', T.exportFooter);
      return lines.join('\n');
    }

    root.addEventListener('click', (event) => {
      const trigger = (event.target as HTMLElement).closest<HTMLElement>('[data-action]');
      if (!trigger || trigger.dataset.action !== 'export') return;
      const blob = new Blob([asMarkdown()], { type: 'text/markdown' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = fileName;
      a.click();
      URL.revokeObjectURL(url);
    });
  }
</script>
