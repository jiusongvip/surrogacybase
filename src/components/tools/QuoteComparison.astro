---
/*
 * Agency quote comparison, built around the quote a visitor already has.
 *
 * The nine costs a quote is usually built from are printed by the server, so nobody has to build
 * a table before entering a number. One quote is shown at first; a second panel appears only when
 * the visitor asks for it. Typing an amount marks that line as included and brings it into the
 * total immediately, which leaves two deliberate exceptions: a line the quote excludes is set to
 * "not included", and a line the quote never mentions is left blank and stays out of the total.
 *
 * Nothing is collected and nothing is kept: there is no browser storage behind this tool, closing
 * the page discards what was typed, and the download is the only copy that leaves.
 *
 * The copy is serialized into the DOM by the page rather than written into the script below,
 * because one bundle serves both languages and a status label left in English would sit inside
 * Chinese rows.
 */
import { langFromPath } from '@/i18n/paths';
import { QUOTE_CHROME } from '@/data/tool-pages';
import { LANG_META } from '@/i18n/config';

const lang = langFromPath(Astro.url.pathname);
const copy = QUOTE_CHROME[lang];
const plans = [
  { id: 'a', letter: 'A' },
  { id: 'b', letter: 'B' },
] as const;
const name = (letter: string) => copy.quoteName.replace('{letter}', letter);
---

<div
  class="rounded-(--radius-panel) border border-line bg-surface p-5 sm:p-7"
  data-quote-tool
  data-locale={LANG_META[lang].dateLocale}
  data-copy={JSON.stringify(copy)}
>
  <p class="text-[13px] text-muted">
    {copy.stays}
  </p>

  <div class="mt-5 flex flex-wrap items-end gap-3">
    <div class="w-40">
      <label class="field-label" for="qc-currency">{copy.currency}</label>
      <select id="qc-currency" class="field-input" data-field="currency" aria-describedby="qc-currency-note">
        {
          copy.currencies.map((code) => (
            <option value={code} selected={code === 'USD'}>
              {code}
            </option>
          ))
        }
      </select>
    </div>
    <button type="button" class="btn-ghost text-sm" data-action="download">{copy.download}</button>
    <button type="button" class="btn-ghost text-sm" data-action="reset">{copy.reset}</button>
  </div>
  <p class="mt-2 max-w-[64ch] text-[13px] leading-[1.5] text-muted" id="qc-currency-note">{copy.currencyNote}</p>

  <p
    id="quote-status-hint"
    class="mt-5 max-w-[68ch] border-l-2 border-accent pl-3 text-[14px] leading-relaxed"
  >
    {copy.statusHint}
  </p>

  <noscript>
    <style>{`
      [data-plan="b"][hidden] { display: block !important; }
      [data-add-wrap] { display: none !important; }
      [data-remove-plan] { display: none !important; }
    `}</style>
  </noscript>

  <div class="mt-6 grid items-start gap-5 lg:grid-cols-2">
    {
      plans.map((plan) => (
        <section
          class="rounded-(--radius) border border-line bg-surface-2/60"
          data-plan={plan.id}
          hidden={plan.id === 'b'}
          aria-labelledby={`quote-${plan.id}`}
        >
          <header class="sticky top-16 z-10 flex flex-wrap items-center justify-between gap-x-3 gap-y-1 rounded-t-(--radius) border-b border-line bg-surface-2 px-4 py-3 sm:px-5">
            <div class="flex flex-wrap items-baseline gap-x-2.5 gap-y-1">
              <h2 id={`quote-${plan.id}`} class="text-[17px] font-semibold tracking-tight">
                {name(plan.letter)}
              </h2>
              <span class="text-[13px] text-muted" data-progress={plan.letter}>
                {copy.progress.replace('{done}', '0').replace('{total}', String(copy.items.length))}
              </span>
            </div>
            <div class="flex items-baseline gap-x-3">
              <span class="tnum text-[16px] font-medium" data-header-total={plan.letter}>&nbsp;</span>
              {plan.id === 'b' && (
                <button
                  type="button"
                  class="text-[13px] text-muted underline underline-offset-4 hover:text-ink"
                  data-remove-plan
                >
                  {copy.removePlan}
                </button>
              )}
            </div>
          </header>
          <ul class="px-4 sm:px-5">
            {copy.items.map((label, index) => (
              <li class="grid grid-cols-[minmax(0,1fr)_8.5rem] items-center gap-x-3 gap-y-2 border-b border-line py-3 last:border-b-0 sm:grid-cols-[minmax(0,1fr)_7.5rem_9rem]">
                <label
                  class="col-span-2 text-[14px] leading-snug sm:col-span-1"
                  for={`qc-${index}-${plan.id}-amount`}
                >
                  {label}
                  <span class="sr-only">, {name(plan.letter)}</span>
                </label>
                <input
                  id={`qc-${index}-${plan.id}-amount`}
                  class="field-input tnum w-full text-right text-[14px]"
                  type="text"
                  inputmode="decimal"
                  autocomplete="off"
                  data-cell={`${index}:${plan.letter}`}
                />
                <label class="sr-only" for={`qc-${index}-${plan.id}-status`}>
                  {copy.srScope.replace('{item}', label).replace('{plan}', name(plan.letter))}
                </label>
                <select
                  id={`qc-${index}-${plan.id}-status`}
                  class="field-input w-full text-[13px]"
                  data-status={`${index}:${plan.letter}`}
                  aria-describedby="quote-status-hint"
                >
                  <option value="verify" selected>
                    {copy.statusVerify}
                  </option>
                  <option value="in">{copy.statusIn}</option>
                  <option value="out">{copy.statusOut}</option>
                </select>
              </li>
            ))}
          </ul>
          <footer class="border-t border-line px-4 py-3.5 sm:px-5">
            <div class="flex items-baseline justify-between gap-3">
              <span class="text-[13px] font-medium text-muted">{copy.totalLabel}</span>
              <span class="tnum text-[22px] leading-none" data-total={plan.letter}>&nbsp;</span>
            </div>
            <p class="mt-1.5 text-[12.5px] leading-relaxed text-muted">{copy.totalHint}</p>
            <p class="mt-2 grid gap-0.5 text-[13px] leading-relaxed text-muted">
              <span data-pending={plan.letter}></span>
              <span data-excluded={plan.letter}></span>
              <span data-invalid={plan.letter} class="text-flag" hidden></span>
            </p>
          </footer>
        </section>
      ))
    }

    <div class="flex items-start" data-add-wrap>
      <button
        type="button"
        class="w-full rounded-(--radius) border border-dashed border-line-strong px-4 py-5 text-[14px] text-muted transition-colors hover:border-accent hover:text-ink"
        data-add-plan
      >
        <span aria-hidden="true">+ </span>{copy.addPlan}
      </button>
    </div>
  </div>

  <section class="mt-6 rounded-(--radius) border border-flag/35 bg-flag-tint px-5 py-4" data-diff hidden>
    <p class="text-[13px] font-semibold tracking-wide text-flag">{copy.diffHeading}</p>
    <p class="mt-1 tnum text-[26px] leading-none text-flag" data-diff-value>&nbsp;</p>
    <p class="mt-2 text-[14px] leading-relaxed text-flag">
      {copy.diffBody}
    </p>
  </section>

  <p class="mt-5 text-[14px] leading-relaxed text-muted">{copy.footer}</p>

  <div class="mt-6 border-t border-line pt-5">
    <button type="button" class="btn-ghost text-sm" data-action="download">{copy.download}</button>
  </div>
</div>

<script>
  import { fill } from '@/i18n/ui';
  import type { QuoteChrome } from '@/data/tool-pages';

  type Status = 'in' | 'out' | 'verify';

  for (const node of Array.from(document.querySelectorAll<HTMLElement>('[data-quote-tool]'))) {
    const root = node;
    const T = JSON.parse(root.dataset.copy!) as QuoteChrome;
    const locale = root.dataset.locale ?? 'en-US';
    const letters = ['A', 'B'] as const;
    const itemCount = root.querySelectorAll<HTMLInputElement>('[data-cell$=":A"]').length;

    const state: { currency: string; cells: Record<string, { amount: string; status: Status }> } = {
      currency: 'USD',
      cells: {},
    };
    const autoStatus = new Set<string>();
    const cell = (key: string) => (state.cells[key] ??= { amount: '', status: 'verify' });
    const panel = (letter: string) => root.querySelector<HTMLElement>(`[data-plan="${letter.toLowerCase()}"]`)!;
    const inputFor = (key: string) => root.querySelector<HTMLInputElement>(`[data-cell="${key}"]`)!;
    const selectFor = (key: string) => root.querySelector<HTMLSelectElement>(`[data-status="${key}"]`)!;

    const parseAmount = (raw: string): number | null => {
      const cleaned = raw.replace(/[\s,]/g, '');
      if (cleaned === '' || !/^\d+(\.\d{1,2})?$/.test(cleaned)) return null;
      return Number(cleaned);
    };

    const money = (value: number): string => {
      try {
        return new Intl.NumberFormat(locale, {
          style: 'currency',
          currency: state.currency,
          minimumFractionDigits: 0,
          maximumFractionDigits: 2,
        }).format(value);
      } catch {
        return `${state.currency} ${value.toLocaleString(locale)}`;
      }
    };

    const plural = (n: number) => (n === 1 ? T.oneS : T.pluralS);

    function totalsFor(letter: string) {
      let included = 0;
      let pending = 0;
      let excluded = 0;
      let invalid = 0;
      let filled = 0;
      for (let index = 0; index < itemCount; index += 1) {
        const c = cell(`${index}:${letter}`);
        const hasAmount = c.amount.trim() !== '';
        if (hasAmount || c.status === 'out') filled += 1;
        if (c.status === 'out') {
          excluded += 1;
          continue;
        }
        if (c.status === 'in') {
          const n = parseAmount(c.amount);
          if (n !== null) included += n;
          else {
            pending += 1;
            if (hasAmount) invalid += 1;
          }
          continue;
        }
        pending += 1;
      }
      return { included, pending, excluded, invalid, filled };
    }

    function recompute() {
      const totals: Record<string, ReturnType<typeof totalsFor>> = {};
      for (const letter of letters) {
        const t = totalsFor(letter);
        totals[letter] = t;
        root.querySelector<HTMLElement>(`[data-progress="${letter}"]`)!.textContent = fill(T.progress, {
          done: t.filled,
          total: itemCount,
        });
        root.querySelector<HTMLElement>(`[data-total="${letter}"]`)!.textContent = money(t.included);
        root.querySelector<HTMLElement>(`[data-header-total="${letter}"]`)!.textContent = money(t.included);
        root.querySelector<HTMLElement>(`[data-pending="${letter}"]`)!.textContent = fill(T.unconfirmed, {
          n: t.pending,
          s: plural(t.pending),
        });
        root.querySelector<HTMLElement>(`[data-excluded="${letter}"]`)!.textContent = fill(T.notIncluded, {
          n: t.excluded,
          s: plural(t.excluded),
        });
        const invalid = root.querySelector<HTMLElement>(`[data-invalid="${letter}"]`)!;
        invalid.hidden = t.invalid === 0;
        invalid.textContent = fill(T.unreadable, { n: t.invalid, s: plural(t.invalid) });
      }

      const comparable = !panel('B').hidden && totals.A.filled > 0 && totals.B.filled > 0;
      const diff = root.querySelector<HTMLElement>('[data-diff]')!;
      diff.hidden = !comparable;
      if (comparable) {
        const gap = totals.A.included - totals.B.included;
        root.querySelector<HTMLElement>('[data-diff-value]')!.textContent =
          `${gap < 0 ? '-' : ''}${money(Math.abs(gap))}`;
      }
    }

    function markInvalid(key: string) {
      const amount = inputFor(key);
      const bad =
        cell(key).status === 'in' && amount.value.trim() !== '' && parseAmount(amount.value) === null;
      amount.classList.toggle('border-flag', bad);
      amount.setAttribute('aria-invalid', bad ? 'true' : 'false');
    }

    function setSecondPlanVisible(visible: boolean) {
      panel('B').hidden = !visible;
      root.querySelector<HTMLElement>('[data-add-wrap]')!.hidden = visible;
      recompute();
    }

    function clearPlan(letter: string) {
      for (let index = 0; index < itemCount; index += 1) {
        const key = `${index}:${letter}`;
        delete state.cells[key];
        autoStatus.delete(key);
        const amount = inputFor(key);
        amount.value = '';
        amount.classList.remove('border-flag');
        amount.setAttribute('aria-invalid', 'false');
        selectFor(key).value = 'verify';
      }
    }

    root.addEventListener('input', (event) => {
      const target = event.target as HTMLInputElement;
      if (!target.matches('[data-cell]')) return;
      const key = target.getAttribute('data-cell')!;
      const status = selectFor(key);
      cell(key).amount = target.value;

      if (target.value.trim() !== '') {
        if (status.value === 'verify') {
          status.value = 'in';
          cell(key).status = 'in';
          autoStatus.add(key);
        }
      } else if (status.value === 'in' && autoStatus.has(key)) {
        status.value = 'verify';
        cell(key).status = 'verify';
        autoStatus.delete(key);
      }

      markInvalid(key);
      recompute();
    });

    root.addEventListener('change', (event) => {
      const target = event.target as HTMLElement;
      if (target.matches('[data-field="currency"]')) {
        state.currency = (target as HTMLSelectElement).value;
        recompute();
        return;
      }
      if (target.matches('[data-status]')) {
        const key = target.getAttribute('data-status')!;
        cell(key).status = (target as HTMLSelectElement).value as Status;
        autoStatus.delete(key);
        markInvalid(key);
        recompute();
      }
    });

    function cellText(index: number, letter: string): string {
      const c = cell(`${index}:${letter}`);
      const n = parseAmount(c.amount);
      if (c.status === 'in') {
        return n !== null ? money(n) : c.amount.trim() === '' ? T.amountMissing : c.amount;
      }
      if (c.status === 'out') {
        return c.amount.trim() === '' ? T.statusOut : `${T.statusOut} · ${c.amount}`;
      }
      return c.amount.trim() === '' ? T.statusVerify : `${T.statusVerify} · ${c.amount}`;
    }

    function asMarkdown(): string {
      const savedAt = new Date().toLocaleString(locale, { dateStyle: 'long', timeStyle: 'short' });
      const shown = letters.filter((letter) => !panel(letter).hidden);
      const heads = shown.map((letter) => fill(T.quoteName, { letter }));
      const totals = shown.map((letter) => totalsFor(letter));
      const lines: string[] = [
        `# ${T.exportTool}`,
        '',
        `${T.savedLine} ${savedAt} · ${state.currency}`,
        T.exportNote,
        '',
      ];

      if (shown.length === 2) {
        lines.push(`| ${T.lineItem} | ${heads[0]} | ${heads[1]} |`, '| --- | --- | --- |');
      } else {
        lines.push(`| ${T.lineItem} | ${heads[0]} |`, '| --- | --- |');
      }
      for (let index = 0; index < itemCount; index += 1) {
        lines.push(`| ${T.items[index]} | ${shown.map((letter) => cellText(index, letter)).join(' | ')} |`);
      }

      if (shown.length === 2) {
        const gap = totals[0].included - totals[1].included;
        lines.push(
          '',
          `${T.totalLine}: ${heads[0]} ${money(totals[0].included)} · ${heads[1]} ${money(totals[1].included)}`,
          `${T.diffLine}: ${gap < 0 ? '-' : ''}${money(Math.abs(gap))}`,
        );
      } else {
        lines.push('', `${T.totalLineOne}: ${money(totals[0].included)}`);
      }

      lines.push('', T.exportFooter);
      return lines.join('\n');
    }

    root.addEventListener('click', (event) => {
      const trigger = (event.target as HTMLElement).closest<HTMLElement>('[data-action], [data-add-plan], [data-remove-plan]');
      if (!trigger) return;

      if (trigger.matches('[data-add-plan]')) {
        setSecondPlanVisible(true);
        inputFor('0:B').focus();
        return;
      }

      if (trigger.matches('[data-remove-plan]')) {
        clearPlan('B');
        setSecondPlanVisible(false);
        root.querySelector<HTMLButtonElement>('[data-add-plan]')!.focus();
        return;
      }

      const action = trigger.getAttribute('data-action');

      if (action === 'download') {
        const blob = new Blob([asMarkdown()], { type: 'text/markdown' });
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = T.exportFilename;
        a.click();
        URL.revokeObjectURL(url);
      }

      if (action === 'reset') {
        clearPlan('A');
        clearPlan('B');
        setSecondPlanVisible(false);
      }
    });

    recompute();
  }
</script>
