---
/*
 * Agency quote comparison, kept as light as the page allows.
 *
 * The rows are printed by the server: the common costs a surrogacy quote is built from are known
 * in advance, so a visitor meets a filled-out table instead of an empty grid and an
 * "add line item" button. What is left to do is type two columns of amounts and set each scope.
 * Nothing is collected and nothing is kept: there is no browser storage behind this tool, closing
 * the page discards what was typed, and the download is the only copy that leaves.
 *
 * The scope options distinguish "not included" from "needs checking" on purpose: a quote that
 * excludes an item and one that fails to mention it are different facts about the same provider.
 *
 * The copy is serialized into the DOM by the page rather than written into the script below,
 * because one bundle serves both languages and a status label left in English would sit inside
 * Chinese rows.
 */
import { langFromPath } from '@/i18n/paths';
import { QUOTE_CHROME } from '@/data/tool-pages';
import { LANG_META } from '@/i18n/config';

const lang = langFromPath(Astro.url.pathname);
const copy = QUOTE_CHROME[lang];
const plans = [
  { id: 'a', letter: 'A' },
  { id: 'b', letter: 'B' },
] as const;
const name = (letter: string) => copy.quoteName.replace('{letter}', letter);
---

<div
  class="rounded-(--radius-panel) border border-line bg-surface p-5 sm:p-7"
  data-quote-tool
  data-locale={LANG_META[lang].dateLocale}
  data-copy={JSON.stringify(copy)}
>
  <p class="text-[13px] text-muted">
    {copy.stays}
  </p>

  <div class="mt-5 flex flex-wrap items-end gap-3">
    <div class="w-40">
      <label class="field-label" for="qc-currency">{copy.currency}</label>
      <select id="qc-currency" class="field-input" data-field="currency" aria-describedby="qc-currency-note">
        {
          copy.currencies.map((code) => (
            <option value={code} selected={code === 'USD'}>
              {code}
            </option>
          ))
        }
      </select>
    </div>
    <button type="button" class="btn-ghost text-sm" data-action="download">{copy.download}</button>
    <button type="button" class="btn-ghost text-sm" data-action="reset">{copy.reset}</button>
  </div>
  <p class="mt-2 max-w-[64ch] text-[13px] leading-[1.5] text-muted" id="qc-currency-note">{copy.currencyNote}</p>

  <!-- relative: the sr-only caption is absolutely positioned, and without a
       containing block here it lands against the document and widens the page. -->
  <div class="relative mt-6 overflow-x-auto pb-2">
    <table class="w-full min-w-[680px] border-collapse text-left text-[15px]">
      <caption class="sr-only">
        {copy.caption}
      </caption>
      <thead>
        <tr>
          <th scope="col" class="w-[34%] border-b border-line-strong pb-2 pr-4 text-[13px] font-semibold text-muted">
            {copy.lineItem}
          </th>
          {
            plans.map((plan) => (
              <>
                <th scope="col" class="border-b border-line-strong px-2 pb-2 text-[13px] font-semibold text-muted min-w-[110px]">
                  {copy.amount}
                </th>
                <th scope="col" class="border-b border-line-strong px-2 pb-2 text-[13px] font-semibold text-muted min-w-[130px]">
                  {name(plan.letter)}
                </th>
              </>
            ))
          }
        </tr>
      </thead>
      <tbody>
        {
          copy.items.map((label, index) => (
            <tr>
              <th scope="row" class="border-b border-line py-2.5 pr-3 text-left font-normal align-top">
                {label}
              </th>
              {
                plans.map((plan) => (
                  <>
                    <td class="border-b border-line py-2.5 pr-2 align-top">
                      <label class="sr-only" for={`qc-${index}-${plan.id}-amount`}>
                        {copy.srAmount.replace('{item}', label).replace('{plan}', name(plan.letter))}
                      </label>
                      <input
                        id={`qc-${index}-${plan.id}-amount`}
                        class="field-input tnum text-[14px]"
                        type="text"
                        inputmode="decimal"
                        data-cell={`${index}:${plan.letter}`}
                        placeholder="0"
                      />
                    </td>
                    <td class="border-b border-line py-2.5 pr-3 align-top">
                      <label class="sr-only" for={`qc-${index}-${plan.id}-status`}>
                        {copy.srScope.replace('{item}', label).replace('{plan}', name(plan.letter))}
                      </label>
                      <select
                        id={`qc-${index}-${plan.id}-status`}
                        class="field-input text-[14px]"
                        data-status={`${index}:${plan.letter}`}
                      >
                        <option value="verify" selected>
                          {copy.statusVerify}
                        </option>
                        <option value="in">{copy.statusIn}</option>
                        <option value="out">{copy.statusOut}</option>
                      </select>
                    </td>
                  </>
                ))
              }
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>

  <div class="mt-6 grid gap-4 sm:grid-cols-2">
    {
      plans.map((plan) => (
        <div class="rounded-(--radius) border border-line bg-surface-2 px-4 py-3.5">
          <p class="text-[13px] font-medium text-muted" data-plan-label={plan.letter}>{name(plan.letter)}</p>
          <p class="mt-1 tnum text-[24px] leading-none" data-total={plan.letter}>&nbsp;</p>
          <p class="mt-2 grid gap-0.5 text-[13px] text-muted">
            <span data-pending={plan.letter}></span>
            <span data-excluded={plan.letter}></span>
            <span data-invalid={plan.letter} class="text-flag" hidden></span>
          </p>
        </div>
      ))
    }
  </div>

  <section class="mt-6 rounded-(--radius) border border-flag/35 bg-flag-tint px-5 py-4" data-diff hidden>
    <p class="text-[13px] font-semibold tracking-wide text-flag">{copy.diffHeading}</p>
    <p class="mt-1 tnum text-[26px] leading-none text-flag" data-diff-value>&nbsp;</p>
    <p class="mt-2 text-[14px] leading-relaxed text-flag">
      {copy.diffBody}
    </p>
  </section>

  <p class="mt-5 text-[14px] leading-relaxed text-muted">{copy.footer}</p>
</div>

<script>
  import { fill } from '@/i18n/ui';
  import type { QuoteChrome } from '@/data/tool-pages';

  type Status = 'in' | 'out' | 'verify';

  for (const node of Array.from(document.querySelectorAll<HTMLElement>('[data-quote-tool]'))) {
    const root = node;
    const T = JSON.parse(root.dataset.copy!) as QuoteChrome;
    const locale = root.dataset.locale ?? 'en-US';
    const letters = ['A', 'B'] as const;
    const itemCount = root.querySelectorAll<HTMLInputElement>('[data-cell$=":A"]').length;

    const state: { currency: string; cells: Record<string, { amount: string; status: Status }> } = {
      currency: 'USD',
      cells: {},
    };
    const cell = (key: string) => (state.cells[key] ??= { amount: '', status: 'verify' });

    const parseAmount = (raw: string): number | null => {
      const cleaned = raw.replace(/[\s,]/g, '');
      if (cleaned === '' || !/^\d+(\.\d{1,2})?$/.test(cleaned)) return null;
      return Number(cleaned);
    };

    const money = (value: number): string => {
      try {
        return new Intl.NumberFormat(locale, {
          style: 'currency',
          currency: state.currency,
          maximumFractionDigits: 0,
        }).format(value);
      } catch {
        return `${state.currency} ${value.toLocaleString(locale)}`;
      }
    };

    const plural = (n: number) => (n === 1 ? T.oneS : T.pluralS);

    function totalsFor(letter: string) {
      let included = 0;
      let pending = 0;
      let excluded = 0;
      let invalid = 0;
      for (let index = 0; index < itemCount; index += 1) {
        const c = cell(`${index}:${letter}`);
        if (c.status === 'in') {
          const n = parseAmount(c.amount);
          if (n !== null) included += n;
          else pending += 1;
          if (c.amount.trim() !== '' && n === null) invalid += 1;
        } else if (c.status === 'out') {
          excluded += 1;
        } else {
          pending += 1;
        }
      }
      return { included, pending, excluded, invalid };
    }

    function recompute() {
      for (const letter of letters) {
        const t = totalsFor(letter);
        root.querySelector<HTMLElement>(`[data-total="${letter}"]`)!.textContent = money(t.included);
        root.querySelector<HTMLElement>(`[data-pending="${letter}"]`)!.textContent = fill(T.unconfirmed, { n: t.pending, s: plural(t.pending) });
        root.querySelector<HTMLElement>(`[data-excluded="${letter}"]`)!.textContent = fill(T.notIncluded, { n: t.excluded, s: plural(t.excluded) });
        const invalid = root.querySelector<HTMLElement>(`[data-invalid="${letter}"]`)!;
        invalid.hidden = t.invalid === 0;
        invalid.textContent = fill(T.unreadable, { n: t.invalid, s: plural(t.invalid) });
      }
      const gap = totalsFor('A').included - totalsFor('B').included;
      const hasNumbers = totalsFor('A').included > 0 || totalsFor('B').included > 0;
      root.querySelector<HTMLElement>('[data-diff]')!.hidden = !hasNumbers;
      root.querySelector<HTMLElement>('[data-diff-value]')!.textContent = `${gap < 0 ? '-' : ''}${money(Math.abs(gap))}`;
    }

    function markInvalid(key: string) {
      const amount = root.querySelector<HTMLInputElement>(`[data-cell="${key}"]`)!;
      const bad =
        cell(key).status === 'in' && amount.value.trim() !== '' && parseAmount(amount.value) === null;
      amount.classList.toggle('border-flag', bad);
      amount.setAttribute('aria-invalid', bad ? 'true' : 'false');
    }

    root.addEventListener('input', (event) => {
      const target = event.target as HTMLElement;
      if (!target.matches('[data-cell]')) return;
      const key = target.getAttribute('data-cell')!;
      cell(key).amount = (target as HTMLInputElement).value;
      markInvalid(key);
      recompute();
    });

    root.addEventListener('change', (event) => {
      const target = event.target as HTMLElement;
      if (target.matches('[data-field="currency"]')) {
        state.currency = (target as HTMLSelectElement).value;
        recompute();
        return;
      }
      if (target.matches('[data-status]')) {
        const key = target.getAttribute('data-status')!;
        cell(key).status = (target as HTMLSelectElement).value as Status;
        markInvalid(key);
        recompute();
      }
    });

    function cellText(index: number, letter: string): string {
      const c = cell(`${index}:${letter}`);
      const n = parseAmount(c.amount);
      if (c.status === 'in') return n !== null ? money(n) : c.amount.trim() === '' ? T.statusVerify : c.amount;
      if (c.status === 'out') return c.amount.trim() === '' ? T.statusOut : `${T.statusOut} · ${c.amount}`;
      return c.amount.trim() === '' ? T.statusVerify : `${T.statusVerify} · ${c.amount}`;
    }

    function asMarkdown(): string {
      const savedAt = new Date().toLocaleString(locale, { dateStyle: 'long', timeStyle: 'short' });
      const headA = fill(T.quoteName, { letter: 'A' });
      const headB = fill(T.quoteName, { letter: 'B' });
      const tA = totalsFor('A');
      const tB = totalsFor('B');
      const gap = tA.included - tB.included;
      const lines: string[] = [
        `# ${T.exportTool}`,
        '',
        `${T.savedLine} ${savedAt} · ${state.currency}`,
        T.exportNote,
        '',
        `| ${T.lineItem} | ${headA} | ${headB} |`,
        '| --- | --- | --- |',
      ];
      for (let index = 0; index < itemCount; index += 1) {
        lines.push(`| ${T.items[index]} | ${cellText(index, 'A')} | ${cellText(index, 'B')} |`);
      }
      lines.push(
        '',
        `${T.totalLine}: ${money(tA.included)} · ${money(tB.included)}`,
        `${T.diffLine}: ${gap < 0 ? '-' : ''}${money(Math.abs(gap))}`,
        '',
        T.exportFooter,
      );
      return lines.join('\n');
    }

    root.addEventListener('click', (event) => {
      const trigger = (event.target as HTMLElement).closest<HTMLElement>('[data-action]');
      if (!trigger) return;
      const action = trigger.getAttribute('data-action');

      if (action === 'download') {
        const blob = new Blob([asMarkdown()], { type: 'text/markdown' });
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = T.exportFilename;
        a.click();
        URL.revokeObjectURL(url);
      }

      if (action === 'reset') {
        for (const input of root.querySelectorAll<HTMLInputElement>('[data-cell]')) {
          input.value = '';
          input.classList.remove('border-flag');
          input.setAttribute('aria-invalid', 'false');
        }
        for (const select of root.querySelectorAll<HTMLSelectElement>('[data-status]')) select.value = 'verify';
        state.cells = {};
        recompute();
      }
    });

    recompute();
  }
</script>
