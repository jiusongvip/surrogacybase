---
/*
 * The destination assessment.
 *
 * A three-step questionnaire that ends in a research roadmap. It is deliberately not a
 * matching engine: nothing in the answers identifies a country as suitable, because the
 * verified material on this site describes how a legal system works, not which family may
 * use it. What the answers do change is which conditions you have to check first, which
 * risks are yours rather than theoretical, and which page you should open next.
 *
 * Every step and every note is server-rendered. With JavaScript disabled the reader still
 * sees all ten questions in one list and the complete roadmap with every note in it, which
 * is a superset of what the scripted version shows. The script adds three things only: it
 * splits the questions into steps, it hides the notes your answers make irrelevant, and it
 * writes the summary line. Nothing is submitted anywhere, and no answer leaves the browser.
 * There is therefore no submit button: the last control is a button that runs the filter.
 *
 * The wording lives in src/data/destination-assessment, where every string is a paired en/zh
 * record, so the compiler asks for a Chinese half of each question, note and button. The legal
 * statements quoted in the notes are still taken from the jurisdiction records in
 * src/data/jurisdictions, so each one carries the publisher and the date we opened it.
 */
import Icon from '@/components/ui/Icon.astro';
import { SITE } from '@/const';
import { formatDate } from '@/lib/dates';
import { getJurisdictions } from '@/lib/jurisdictions';
import { langFromPath, localizedPath } from '@/i18n/paths';
import { fill, pick } from '@/i18n/ui';
import {
  ASSESSMENT_CHROME,
  ASSESSMENT_CORE,
  ASSESSMENT_NOTES,
  ASSESSMENT_OWNERS,
  ASSESSMENT_STEPS,
  type AssessmentNote,
} from '@/data/destination-assessment';

type Props = {
  storageKey?: string;
};

const { storageKey = 'surrogacybase.destination-assessment.v1' } = Astro.props;

/*
 * An answer is stored as its code and every label is read back off the page, so one storage key
 * serves both languages: a reader who switches to the mirror finds the roadmap they filled in.
 */
const lang = langFromPath(Astro.url.pathname);
const copy = ASSESSMENT_CHROME[lang];

const steps = ASSESSMENT_STEPS.map((s) => ({
  num: s.num,
  title: pick(s.title, lang),
  purpose: pick(s.purpose, lang),
  fields: s.fields.map((f) => ({
    id: f.id,
    kind: f.kind,
    optional: f.optional,
    legend: pick(f.legend, lang),
    hint: f.hint ? pick(f.hint, lang) : undefined,
    options: f.options.map((o) => ({ value: o.value, label: pick(o.label, lang) })),
  })),
}));

const REQUIRED = steps
  .flatMap((s) => s.fields)
  .filter((f) => !f.optional)
  .map((f) => f.id);

const core = ASSESSMENT_CORE.map((c) => ({ title: pick(c.title, lang), body: pick(c.body, lang) }));
const owners = ASSESSMENT_OWNERS.map((o) => ({ who: pick(o.who, lang), owns: pick(o.owns, lang) }));

/*
 * A note names the jurisdiction fact it rests on rather than carrying its own copy of the
 * provenance, so the publisher and the date are the ones that record's own page shows, and a
 * citation pointing at anything unpublished fails the build here instead of printing a legal
 * sentence with no source beside it.
 */
const records = await getJurisdictions(lang);

function citation(note: AssessmentNote) {
  if (!note.cite) return undefined;
  const { code, fact } = note.cite;
  const entry = records.find((r) => r.data.code === code)?.data.facts[fact];
  if (!entry) throw new Error(`Note "${note.id}" cites ${code} fact ${fact}, which is not a published fact.`);
  return entry.source;
}

const notes = ASSESSMENT_NOTES.map((n) => ({
  id: n.id,
  field: n.when.field,
  values: n.when.values,
  title: pick(n.title, lang),
  body: pick(n.body, lang),
  link: pick(n.link, lang),
  href: localizedPath(lang, n.href ?? ''),
  cite: citation(n),
}));

const home = localizedPath(lang, '/');
const inbox = SITE.contactEmail;
---

<div class="card overflow-hidden" data-assessment={storageKey} data-copy={JSON.stringify(copy)}>
  <div class="border-b border-line bg-surface-2 px-5 py-6 sm:px-8">
    <p class="flex items-center gap-2 text-[13px] font-semibold uppercase tracking-[0.16em] text-accent">
      <Icon name="map-pin" size={15} />
      {copy.eyebrow}
    </p>
    <h2 class="mt-3 text-[clamp(1.6rem,3.2vw,2.1rem)] leading-[1.15]">{copy.heading}</h2>
    <p class="mt-3 max-w-[62ch] text-[16px] leading-[1.7] text-muted">
      {copy.intro}
    </p>
    <p class="mt-3 flex items-start gap-2.5 max-w-[62ch] text-[14px] leading-relaxed text-muted">
      <Icon name="lock" size={16} class="mt-0.5 shrink-0 text-accent" />
      <span>
        {copy.privacy}
      </span>
    </p>
  </div>

  <div class="grid lg:grid-cols-[212px_minmax(0,1fr)]">
    <nav class="border-b border-line px-5 py-5 lg:border-r lg:border-b-0 lg:px-6 lg:py-8" aria-label={copy.stepsLabel}>
      <ol class="flex flex-wrap gap-x-5 gap-y-2 lg:block lg:space-y-5">
        {
          steps.map((s, i) => (
            <li data-step-indicator={s.num} aria-current="false">
              <span class="tnum block text-[12px] font-semibold tracking-[0.14em] text-muted">{s.num}</span>
              <span class="mt-0.5 block text-[15px] leading-snug font-medium">{s.title}</span>
              {i === steps.length - 1 && <span class="mt-0.5 block text-[13px] text-muted">{copy.lastStep}</span>}
            </li>
          ))
        }
      </ol>
    </nav>

    <div class="min-w-0 px-5 py-6 sm:px-8">
      <form data-form novalidate data-required={REQUIRED.join(' ')}>
        {
          steps.map((step) => (
            <div data-step={step.num} tabindex="-1">
              <p class="text-[13px] font-semibold uppercase tracking-[0.14em] text-muted tnum">
                {step.num} / {step.title}
              </p>
              <p class="mt-2 max-w-[62ch] text-[15px] leading-[1.7] text-muted">{step.purpose}</p>

              <div class="mt-7 space-y-8">
                {step.fields.map((field) => (
                  <fieldset
                    class="min-w-0"
                    data-field={field.id}
                    data-label={field.legend}
                    data-kind={field.kind}
                    aria-describedby={field.hint ? `hn-${field.id}` : undefined}
                  >
                    <legend class="text-[17px] leading-snug font-medium">
                      {field.legend}
                      {field.kind === 'check' && <span class="ml-2 align-middle text-[13px] font-normal text-muted">{copy.chooseAny}</span>}
                      {field.optional && <span class="ml-2 align-middle text-[13px] font-normal text-muted">{copy.optional}</span>}
                    </legend>
                    {field.hint && (
                      <p class="mt-1.5 max-w-[62ch] text-[14px] leading-relaxed text-muted" id={`hn-${field.id}`}>
                        {field.hint}
                      </p>
                    )}

                    <ul class="mt-3.5 space-y-2">
                      {field.options.map((o) => (
                        <li>
                          <label class="option">
                            <input class="sr-only peer" type={field.kind === 'radio' ? 'radio' : 'checkbox'} name={field.id} value={o.value} />
                            <span class="option-box">
                              <span class="option-mark" aria-hidden="true"></span>
                              <span class="option-label">{o.label}</span>
                            </span>
                          </label>
                        </li>
                      ))}
                    </ul>
                  </fieldset>
                ))}
              </div>
            </div>
          ))
        }

        <script is:inline>
          /*
           * The server renders every step open, because a browser without scripts has to be able to
           * read all ten questions and the whole roadmap. This runs mid-parse, before the first paint,
           * and folds the steps for everyone else. It touches no content, only whether it is on screen.
           */
          const assessment = document.currentScript?.closest('[data-assessment]');
          if (assessment instanceof HTMLElement) {
            assessment.setAttribute('data-steps-on', '');
            const first = assessment.querySelector('[data-step]');
            if (first) first.setAttribute('data-open', '');
          }
        </script>

        <div class="mt-9 flex flex-wrap items-center gap-3 border-t border-line pt-6" data-navs>
          <button type="button" class="btn-ghost" data-nav="back" hidden>{copy.back}</button>
          <button type="button" class="btn-primary" data-nav="next">
            {copy.next}
            <Icon name="arrow-right" size={16} />
          </button>
          <button type="button" class="btn-primary" data-nav="submit" hidden>
            {copy.submit}
            <Icon name="arrow-down-right" size={16} />
          </button>
          <p class="text-[14px] text-muted" data-hint>{fill(copy.hintRequired, { n: REQUIRED.length })}</p>
        </div>
        <p class="mt-3 empty:hidden text-[14px] leading-relaxed text-flag" data-error role="alert"></p>
      </form>

      <noscript>
        <p class="mt-5 rounded-(--radius) border border-line bg-surface-2 px-4 py-3 text-[14px] leading-relaxed text-muted">
          {copy.noscript}
        </p>
      </noscript>
    </div>
  </div>

  <section class="border-t border-line px-5 py-8 sm:px-8" data-results>
    <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-2">
      <h3 class="text-[clamp(1.4rem,2.6vw,1.8rem)] leading-snug">{copy.resultsHeading}</h3>
      <p class="text-[13px] font-semibold uppercase tracking-[0.14em] text-muted" data-results-mode>{copy.resultsModeFull}</p>
    </div>
    <p class="mt-2 max-w-[62ch] text-[15px] leading-[1.7] text-muted" data-summary aria-live="polite">
      {copy.resultsIntro}
    </p>
    <p class="mt-3 flex flex-wrap gap-2" data-chips hidden></p>

    <h4 class="mt-9 text-[20px]">{copy.coreHeading}</h4>
    <ol class="mt-4 divide-y divide-line border-t border-line" data-core>
      {
        core.map((c, i) => (
          <li class="flex gap-4 py-5">
            <span class="tnum shrink-0 text-[13px] font-semibold text-accent">{String(i + 1).padStart(2, '0')}</span>
            <div class="min-w-0">
              <p class="text-[17px] leading-snug font-medium">{c.title}</p>
              <p class="mt-1.5 max-w-[64ch] text-[15px] leading-[1.7] text-muted">{c.body}</p>
            </div>
          </li>
        ))
      }
    </ol>

    <h4 class="mt-11 text-[20px]">{copy.notesHeading}</h4>
    <div class="mt-4 grid gap-4 sm:grid-cols-2">
      {
        notes.map((n) => (
          <article class="note min-w-0 rounded-(--radius) border border-line bg-surface p-5" data-note={n.id} data-for={n.field} data-values={n.values.join(' ')}>
            <p class="text-[16px] leading-snug font-medium">{n.title}</p>
            <p class="mt-2 text-[15px] leading-[1.7] text-muted">{n.body}</p>
            {n.cite && (
              <p class="mt-3 text-[13px] leading-relaxed text-muted">
                {copy.sourceLabel}<a href={n.cite.url} rel="noopener noreferrer" target="_blank" class="link-underlined ml-1 text-[13px]">{n.cite.publisher}</a>
                <span class="tnum ml-1">{fill(copy.checkedLabel, { date: formatDate(n.cite.verifiedOn, lang) })}</span>
              </p>
            )}
            <a href={n.href} class="textlink mt-4 text-[14px]">
              {n.link}
              <Icon name="arrow-right" size={15} />
            </a>
          </article>
        ))
      }
    </div>
    <p class="mt-4 text-[14px] leading-relaxed text-muted" data-notes-empty hidden>
      {copy.notesEmpty}
    </p>

    <h4 class="mt-11 text-[20px]">{copy.ownersHeading}</h4>
    <p class="mt-2 max-w-[64ch] text-[15px] leading-[1.7] text-muted">
      {copy.ownersIntro}
    </p>
    <dl class="mt-4 divide-y divide-line border-y border-line" data-owners>
      {
        owners.map((o) => (
          <div class="grid gap-1.5 py-4 sm:grid-cols-[minmax(0,0.9fr)_minmax(0,1.6fr)]">
            <dt class="text-[15px] font-medium">{o.who}</dt>
            <dd class="text-[15px] leading-[1.7] text-muted">{o.owns}</dd>
          </div>
        ))
      }
    </dl>

    <div class="mt-9 flex flex-wrap gap-3">
      <button type="button" class="btn-ghost text-sm" data-action="copy" hidden>
        <Icon name="file-text" size={15} />
        {copy.copyButton}
      </button>
      <button type="button" class="btn-ghost text-sm" data-action="download" hidden>
        <Icon name="download" size={15} />
        {copy.downloadButton}
      </button>
      <a href={localizedPath(lang, '/tools/destination-research-checklist')} class="textlink text-sm">
        {copy.checklistLink}
        <Icon name="arrow-right" size={15} />
      </a>
    </div>
    <p class="mt-4 max-w-[64ch] text-[14px] leading-relaxed text-muted">
      {copy.copyExplanation}
    </p>

    <div class="mt-8 rounded-(--radius) border border-line bg-surface-2 px-5 py-5" data-handoff>
      <p class="text-[16px] leading-snug font-medium">{copy.handoffTitle}</p>
      {
        inbox ? (
          <p class="mt-2 max-w-[60ch] text-[15px] leading-[1.7] text-muted">
            {copy.handoffWithEmail}
          </p>
        ) : (
          <p class="mt-2 max-w-[62ch] text-[15px] leading-[1.7] text-muted">
            {copy.handoffNoEmail}
          </p>
        )
      }
      <div class="mt-4 flex flex-wrap gap-3">
        <a href={`${home}#assessment`} class="btn-primary text-sm">
          {copy.handoffBrief}
          <Icon name="arrow-right" size={15} />
        </a>
        <a href={localizedPath(lang, '/editorial-policy')} class="btn-ghost text-sm">{copy.handoffStandards}</a>
      </div>
    </div>
  </section>
</div>

<style>
  .option {
    display: block;
    cursor: pointer;
  }

  .option-box {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
    padding: 0.8rem 0.9rem;
    font-size: 15px;
    line-height: 1.55;
    transition:
      border-color var(--dur) var(--ease),
      background-color var(--dur) var(--ease);
  }

  .option:hover .option-box {
    border-color: var(--line-strong);
  }

  .option-mark {
    margin-top: 0.28rem;
    width: 0.95rem;
    height: 0.95rem;
    flex: none;
    border: 1px solid var(--line-control);
    border-radius: 999px;
    transition:
      border-color var(--dur) var(--ease),
      background-color var(--dur) var(--ease);
  }

  :global([data-kind='check'] .option-mark) {
    border-radius: var(--radius);
  }

  .peer:checked + .option-box {
    border-color: var(--brand-fg);
    background: var(--accent-tint);
  }

  .peer:checked + .option-box .option-mark {
    border-color: var(--brand-fg);
    background-color: var(--brand-fg);
    box-shadow: inset 0 0 0 3px var(--surface);
  }

  .peer:focus-visible + .option-box {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }

  [data-step-indicator][aria-current='step'] > span:first-child {
    color: var(--accent);
  }

  [data-step-indicator][aria-current='step'] > span:nth-child(2) {
    font-weight: 600;
  }

  /*
   * Steps fold only for a browser that ran the inline marker. Without that attribute every
   * question stays on the page, which is what a reader with scripts disabled needs. This is
   * keyed off the marker rather than the hidden attribute because preflight's
   * [hidden]{display:none!important} sits in a cascade layer, and no noscript style can beat it.
   */
  [data-assessment][data-steps-on] [data-step]:not([data-open]) {
    display: none;
  }

  [data-assessment]:not([data-steps-on]) [data-navs] {
    display: none;
  }

  .note[data-note-hidden='true'] {
    display: none;
  }

  /* Two notes per row from sm, and .textlink is nowrap by default. A forty-six character label
   * would push its own card past the column the grid gave it, so this is the one place it breaks. */
  .note .textlink {
    white-space: normal;
  }
</style>

<script>
  const root = document.querySelector('[data-assessment]');

  if (root instanceof HTMLElement) {
    /*
     * One bundle serves both languages, so the script takes its wording from the page instead of
     * importing the dictionary, which would ship every language's strings inside it. Only the
     * slice it writes is named.
     */
    const T: {
      hintComplete: string;
      hintProgress: string;
      modeNarrowed: string;
      summaryMatched: string;
      summaryUnmatched: string;
      errorStepComplete: string;
      errorStepOpen: string;
      copied: string;
      copyBlocked: string;
      export: {
        title: string;
        assembled: string;
        note: string;
        answers: string;
        core: string;
        changes: string;
        owners: string;
        answerLine: string;
        sourceLine: string;
        nextLine: string;
        ownerLine: string;
        valueJoin: string;
        footer: string;
        filename: string;
        dateLocale: string;
      };
    } = JSON.parse(root.dataset.copy!);

    const fill = (template: string, vars: Record<string, string | number>) =>
      template.replace(/\{(\w+)\}/g, (match, key: string) => (key in vars ? String(vars[key]) : match));

    /* English marks a plural with s. The Chinese templates carry no such token, so it goes unfilled. */
    const plural = (n: number) => (n === 1 ? '' : 's');

    const form = root.querySelector('form');
    const steps = [...root.querySelectorAll<HTMLElement>('[data-step]')];
    const indicators = [...root.querySelectorAll<HTMLElement>('[data-step-indicator]')];
    const back = root.querySelector<HTMLElement>('[data-nav="back"]');
    const next = root.querySelector<HTMLElement>('[data-nav="next"]');
    const done = root.querySelector<HTMLElement>('[data-nav="submit"]');
    const hint = root.querySelector<HTMLElement>('[data-hint]');
    const error = root.querySelector<HTMLElement>('[data-error]');
    const results = root.querySelector<HTMLElement>('[data-results]');
    const summary = root.querySelector<HTMLElement>('[data-summary]');
    const chips = root.querySelector<HTMLElement>('[data-chips]');
    const mode = root.querySelector<HTMLElement>('[data-results-mode]');
    const notes = [...root.querySelectorAll<HTMLElement>('[data-note]')];
    const empty = root.querySelector<HTMLElement>('[data-notes-empty]');
    const key = root.dataset.assessment ?? 'surrogacybase.destination-assessment.v1';

    /* The required ids come from the markup so the list cannot drift from the questions. */
    const REQUIRED = (form?.dataset.required ?? '').split(' ').filter(Boolean);
    const LABELS: Record<string, string> = {};
    const QUESTIONS: Record<string, string> = {};
    const STEP_FIELD = new Map<string, string[]>();

    let current = 0;

    root.querySelectorAll<HTMLInputElement>('input[name]').forEach((input) => {
      const text = input.closest('label')?.querySelector('.option-label')?.textContent?.trim() ?? input.value;
      LABELS[`${input.name}:${input.value}`] = text;
    });

    /* The export has to read as a document a lawyer can answer, so every line carries the
     * question it answers rather than the field id the form uses internally. */
    root.querySelectorAll<HTMLElement>('[data-field]').forEach((f) => {
      QUESTIONS[f.dataset.field ?? ''] = f.dataset.label ?? '';
    });

    steps.forEach((step) => {
      STEP_FIELD.set(
        step.dataset.step ?? '',
        [...step.querySelectorAll<HTMLElement>('[data-field]')].map((f) => f.dataset.field ?? ''),
      );
    });

    const read = (): Record<string, string[]> => {
      const out: Record<string, string[]> = {};
      if (!form) return out;
      form.querySelectorAll<HTMLInputElement>('input:checked').forEach((input) => {
        (out[input.name] ??= []).push(input.value);
      });
      return out;
    };

    const save = () => {
      try {
        localStorage.setItem(key, JSON.stringify(read()));
      } catch {
        /* A private window that refuses storage is not a reason to break the form. */
      }
    };

    const restore = () => {
      let raw: string | null = null;
      try {
        raw = localStorage.getItem(key);
      } catch {
        return;
      }
      if (!raw) return;
      const stored = JSON.parse(raw) as Record<string, unknown>;
      for (const [name, values] of Object.entries(stored)) {
        if (!Array.isArray(values)) continue;
        for (const value of values) {
          if (typeof value !== 'string') continue;
          const input = form?.querySelector<HTMLInputElement>(`input[name="${CSS.escape(name)}"][value="${CSS.escape(value)}"]`);
          if (input) input.checked = true;
        }
      }
    };

    const showError = (message: string) => {
      if (error) error.textContent = message;
    };

    const clearError = () => {
      if (error) error.textContent = '';
    };

    const missingOn = (index: number, answers: Record<string, string[]>) =>
      (STEP_FIELD.get(steps[index]?.dataset.step ?? '') ?? []).some((id) => REQUIRED.includes(id) && !answers[id]?.length);

    const show = (index: number) => {
      current = Math.max(0, Math.min(steps.length - 1, index));
      steps.forEach((el, i) => {
        if (i === current) el.setAttribute('data-open', '');
        else el.removeAttribute('data-open');
      });
      indicators.forEach((el, i) => el.setAttribute('aria-current', i === current ? 'step' : 'false'));
      if (back) back.hidden = current === 0;
      if (next) next.hidden = current === steps.length - 1;
      if (done) done.hidden = current !== steps.length - 1;
      const answers = read();
      const filled = REQUIRED.filter((f) => answers[f]?.length).length;
      if (hint) {
        hint.textContent =
          filled === REQUIRED.length
            ? fill(T.hintComplete, { n: REQUIRED.length })
            : fill(T.hintProgress, { filled, total: REQUIRED.length });
      }
    };

    const firstMissingStep = (answers: Record<string, string[]>) => {
      for (let i = 0; i < steps.length; i++) if (missingOn(i, answers)) return i;
      return -1;
    };

    const visibleNotes = (answers: Record<string, string[]>) =>
      notes.filter((note) => {
        const wanted = (note.dataset.values ?? '').split(' ').filter(Boolean);
        const got = answers[note.dataset.for ?? ''] ?? [];
        return wanted.some((w) => got.includes(w));
      });

    const render = () => {
      const answers = read();
      const matched = visibleNotes(answers);
      notes.forEach((n) => n.setAttribute('data-note-hidden', String(!matched.includes(n))));
      if (empty) empty.hidden = matched.length !== 0;
      const answered = Object.keys(answers).length;
      if (mode) mode.textContent = fill(T.modeNarrowed, { n: answered, s: plural(answered) });
      if (summary) {
        summary.textContent = matched.length
          ? fill(T.summaryMatched, { n: matched.length, s: plural(matched.length) })
          : T.summaryUnmatched;
      }
      if (chips) {
        chips.textContent = '';
        chips.hidden = answered === 0;
        for (const [field, values] of Object.entries(answers)) {
          for (const value of values) {
            const chip = document.createElement('span');
            chip.className = 'rounded-(--radius) border border-line bg-surface px-2.5 py-1 text-[13px] text-muted';
            chip.textContent = LABELS[`${field}:${value}`] ?? value;
            chips.append(chip);
          }
        }
      }
    };

    /* The date is formatted in the browser, the same shape as formatDate in src/lib/dates. */
    const stamp = () =>
      new Date().toLocaleDateString(T.export.dateLocale, {
        day: 'numeric',
        month: 'short',
        year: 'numeric',
        timeZone: 'UTC',
      });

    const asMarkdown = (answers: Record<string, string[]>, matched: HTMLElement[]) => {
      const core = [...(results?.querySelectorAll<HTMLElement>('[data-core] > li') ?? [])];
      const owners = [...(results?.querySelectorAll<HTMLElement>('[data-owners] > div') ?? [])];
      const text = (el: Element | null | undefined) => el?.textContent?.trim() ?? '';
      return [
        `# ${T.export.title}`,
        '',
        fill(T.export.assembled, { date: stamp() }),
        '',
        T.export.note,
        '',
        `## ${T.export.answers}`,
        '',
        ...Object.entries(answers).map(
          ([field, values]) =>
            `- ${fill(T.export.answerLine, {
              question: QUESTIONS[field] ?? field,
              answer: values.map((v) => LABELS[`${field}:${v}`] ?? v).join(T.export.valueJoin),
            })}`,
        ),
        '',
        `## ${T.export.core}`,
        '',
        ...core.map((li, i) => {
          const paras = [...li.querySelectorAll('p')];
          return `${i + 1}. ${text(paras[0])}\n   ${text(paras[1])}`;
        }),
        '',
        `## ${T.export.changes}`,
        '',
        ...matched.flatMap((n) => {
          const paras = [...n.querySelectorAll('p')];
          const cite = n.querySelector<HTMLAnchorElement>('a[target="_blank"]');
          const link = n.querySelector<HTMLAnchorElement>('a.textlink');
          const block = [`### ${text(paras[0])}`, '', text(paras[1])];
          if (cite) block.push('', `${fill(T.export.sourceLine, { label: text(cite) })} <${cite.href}>`);
          if (link) block.push('', `${fill(T.export.nextLine, { label: text(link) })} <${link.href}>`);
          return [...block, ''];
        }),
        `## ${T.export.owners}`,
        '',
        ...owners.map(
          (row) => `- ${fill(T.export.ownerLine, { who: text(row.querySelector('dt')), owns: text(row.querySelector('dd')) })}`,
        ),
        '',
        T.export.footer,
      ].join('\n');
    };

    restore();
    show(0);

    form?.addEventListener('change', () => {
      save();
      show(current);
    });

    next?.addEventListener('click', () => {
      if (missingOn(current, read())) {
        showError(T.errorStepComplete);
        return;
      }
      clearError();
      show(current + 1);
      /* Focus follows the step so a keyboard reader is told where they landed. */
      steps[current]?.focus({ preventScroll: true });
      steps[current]?.scrollIntoView({ block: 'start' });
    });

    back?.addEventListener('click', () => {
      clearError();
      show(current - 1);
      steps[current]?.focus({ preventScroll: true });
    });

    done?.addEventListener('click', () => {
      const answers = read();
      const bad = firstMissingStep(answers);
      if (bad >= 0) {
        const num = steps[bad]?.dataset.step ?? '';
        show(bad);
        /* One wording for both cases: the reader may already be on the step that needs the answer. */
        showError(fill(T.errorStepOpen, { num }));
        return;
      }
      clearError();
      render();
      results?.scrollIntoView({ block: 'start' });
    });

    root.querySelectorAll<HTMLElement>('[data-action]').forEach((button) => {
      button.hidden = false;
      const label = button.textContent?.trim() ?? '';
      button.addEventListener('click', async () => {
        const text = asMarkdown(read(), visibleNotes(read()));
        if (button.dataset.action === 'copy') {
          try {
            await navigator.clipboard.writeText(text);
            button.textContent = T.copied;
          } catch {
            button.textContent = T.copyBlocked;
          }
          setTimeout(() => {
            button.textContent = label;
          }, 2600);
          return;
        }
        const url = URL.createObjectURL(new Blob([text], { type: 'text/markdown' }));
        const a = document.createElement('a');
        a.href = url;
        a.download = T.export.filename;
        a.click();
        URL.revokeObjectURL(url);
      });
    });
  }
</script>
