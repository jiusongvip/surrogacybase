---
/*
 * The brief a reader assembles and takes away.
 *
 * Every line here is server-rendered from one destination record, in the language of the page, and
 * the exporter re-reads those rendered lines rather than holding a second copy of the text. That is
 * the whole design: a file that cannot say anything the screen does not already say, and a control
 * that decides only which destinations appear.
 *
 * Nothing is collected, stored or sent. There is no server to send to, so the exits are the
 * clipboard and a file, and the brief is addressed to whichever professional the reader hands it to.
 */
import Icon from '@/components/ui/Icon.astro';
import { LANG_META } from '@/i18n/config';
import { langFromPath, localizedPath } from '@/i18n/paths';
import { BASIS_LABELS, UI, fill } from '@/i18n/ui';
import { BRIEF_CHROME } from '@/data/brief';
import { getJurisdictions } from '@/lib/jurisdictions';
import { formatDate } from '@/lib/dates';
import { costText } from '@/lib/costs';
import { ADMISSION_FAMILIES, admissionFor, familyLabel } from '@/lib/admits';

const lang = langFromPath(Astro.url.pathname);
const rows = await getJurisdictions(lang);

const chrome = BRIEF_CHROME[lang];
const page = UI[lang].pages.jurisdiction;
const costsCopy = UI[lang].costs;
const admitsCopy = UI[lang].admits;
const basis = BASIS_LABELS[lang];

/*
 * A qualifier sits in brackets that belong to the page's language, and a bracketed sentence loses
 * the full stop it no longer needs. English keeps its period, Chinese does not stack one inside （）.
 */
const qualify = (text: string) =>
  `${chrome.noteGap}${chrome.parenOpen}${chrome.stop === '' ? text : text.replace(new RegExp(`${chrome.stop}$`), '')}${chrome.parenClose}`;
---

<div
  class="rounded-(--radius) border border-line bg-paper p-6 shadow-lift sm:p-7"
  data-brief
  data-export={chrome.filename}
  data-locale={LANG_META[lang].dateLocale}
  data-copy={JSON.stringify(chrome)}
>
  <p class="text-[16px] font-semibold">{chrome.pickHeading}</p>
  <p class="mt-2 max-w-[64ch] text-[15px] leading-[1.7] text-muted">{chrome.pickIntro}</p>

  <div class="mt-5 flex flex-wrap gap-2">
    {
      rows.map((row, i) => (
        <label class="flex cursor-pointer items-center gap-2 rounded-full border border-line-control px-3.5 py-1.5 text-[14px] hover:border-line-strong">
          <input type="checkbox" class="accent-accent" data-include={row.data.code} checked={i < 3} />
          {row.data.name}
        </label>
      ))
    }
  </div>

  <div class="mt-4 flex flex-wrap gap-3">
    <button type="button" class="btn-ghost text-sm" data-action="all">{chrome.all}</button>
    <button type="button" class="btn-ghost text-sm" data-action="none">{chrome.none}</button>
  </div>

  <div class="mt-6 flex flex-wrap gap-3">
    <button type="button" class="btn-primary text-sm" data-action="copy">{chrome.copy}</button>
    <button type="button" class="btn-ghost text-sm" data-action="download">
      <Icon name="download" size={16} />
      {chrome.download}
    </button>
  </div>

  <p class="mt-3 text-[14px] leading-relaxed text-muted" role="status" aria-live="polite" data-status>
    {chrome.statusIdle}
  </p>

  <div class="mt-8 space-y-8">
    {
      rows.map((row) => {
        const d = row.data;
        const admissions = ADMISSION_FAMILIES.map((family) => admissionFor(d.admits, family)).filter(
          (row) => row !== undefined,
        );
        return (
          <section class="border-t border-line pt-6" data-block={d.code} data-name={d.name}>
            <h3 class="text-[19px] leading-snug">
              {d.name}{' '}
              <span class="ml-2 text-[14px] font-normal text-muted">{d.region}</span>
            </h3>

            <dl class="mt-4 space-y-4 text-[15px] leading-[1.7]">
              <div data-line>
                <dt class="font-semibold text-muted">{page.positions.legalBasis}</dt>
                <dd class="mt-1" data-text>{basis[d.basis] ?? d.basis}</dd>
              </div>

              <div data-line>
                <dt class="font-semibold text-muted">{page.positions.whoMayCommission}</dt>
                <dd class="mt-1" data-text>{d.eligibility}</dd>
              </div>

              {admissions.length > 0 && (
                <div data-line>
                  <dt class="font-semibold text-muted">{admitsCopy.heading}</dt>
                  <dd class="mt-1 list-disc space-y-1 pl-5">
                    {admissions.map((a) => (
                      <li data-item>
                        {`${familyLabel(a.family, lang)}${chrome.labelJoin}${admitsCopy.status[a.status]}${
                          a.note !== undefined ? qualify(admitsCopy.note[a.note]) : ''
                        }`}
                      </li>
                    ))}
                  </dd>
                </div>
              )}

              <div data-line>
                <dt class="font-semibold text-muted">{page.positions.payment}</dt>
                <dd class="mt-1" data-text>{d.paymentModel}</dd>
              </div>

              <div data-line>
                <dt class="font-semibold text-muted">{page.positions.parentage}</dt>
                <dd class="mt-1" data-text>{d.parentage}</dd>
              </div>

              {d.costs.length > 0 && (
                <div data-line>
                  <dt class="font-semibold text-muted">{costsCopy.heading}</dt>
                  <dd class="mt-1 list-disc space-y-1 pl-5">
                    {d.costs.map((figure) => {
                      const fact = d.facts[figure.fact];
                      if (!fact) throw new Error(`${d.code} cost figure names fact ${figure.fact}, which it does not carry.`);
                      return (
                        <li data-item data-url={fact.source.url}>
                          {`${costsCopy.items[figure.item]}${chrome.labelJoin}${costText(figure, lang)}${
                            chrome.noteGap
                          }${chrome.parenOpen}${fill(costsCopy.asOf, { year: figure.asOf })}${chrome.parenClose}`}
                        </li>
                      );
                    })}
                  </dd>
                </div>
              )}

              {d.openQuestions.length > 0 && (
                <div data-line>
                  <dt class="font-semibold text-muted">{page.openTitle}</dt>
                  <dd class="mt-1 list-disc space-y-1 pl-5">
                    {d.openQuestions.map((q) => (
                      <li data-item>{q}</li>
                    ))}
                  </dd>
                </div>
              )}

              <div data-line>
                <dt class="font-semibold text-muted">{UI[lang].sources.heading}</dt>
                <dd class="mt-1 list-disc space-y-1 pl-5">
                  {d.facts.map((fact) => (
                    <li data-item data-url={fact.source.url}>
                      <a href={fact.source.url} rel="noopener noreferrer" target="_blank" class="link-underlined">{fact.source.label}</a>{
                        fill(page.citeChecked, { date: formatDate(fact.source.verifiedOn, lang) })
                      }
                    </li>
                  ))}
                </dd>
              </div>

              <div data-page>
                <a href={localizedPath(lang, `/destinations/${d.code}`)} class="text-[14px] textlink">
                  {d.name}
                  <Icon name="arrow-right" size={15} />
                </a>
              </div>
            </dl>
          </section>
        );
      })
    }
  </div>
</div>

<script>
  import type { BriefChrome } from '@/data/brief';

  for (const root of Array.from(document.querySelectorAll<HTMLElement>('[data-brief]'))) {
    const T = JSON.parse(root.dataset.copy!) as BriefChrome;
    const locale = root.dataset.locale ?? 'en-GB';
    const fileName = root.dataset.export ?? 'surrogacybase-brief.md';
    const status = root.querySelector<HTMLElement>('[data-status]')!;
    const boxes = Array.from(root.querySelectorAll<HTMLInputElement>('[data-include]'));
    /* Document order, so the file reads in the order the page prints. */
    const blocks = Array.from(root.querySelectorAll<HTMLElement>('[data-block]'));

    /* Astro's JSX leaves the indentation between expressions in the DOM, so runs of it are one space. */
    const text = (el: Element | null | undefined) => (el?.textContent ?? '').replace(/\s+/g, ' ').trim();
    const chosen = () => blocks.filter((b) => boxes.find((x) => x.dataset.include === b.dataset.block)?.checked);

    function token(template: string, vars: Record<string, string>): string {
      return template.replace(/\{(\w+)\}/g, (m, k: string) => (k in vars ? vars[k] : m));
    }

    function repaint() {
      const n = chosen().length;
      status.textContent = token(T.count, { n: String(n), total: String(blocks.length) }) + ' ' + T.statusIdle;
    }

    /** Reads the rendered page, so the file can never claim more than the screen shows. */
    function asMarkdown(): string {
      const savedAt = new Date().toLocaleString(locale, { dateStyle: 'long', timeStyle: 'short' });
      const lines: string[] = [`# ${T.fileTitle}`, '', token(T.savedLine, { date: savedAt }), '', T.fileHint];

      for (const block of chosen()) {
        lines.push('', `## ${block.dataset.name ?? ''}`);
        for (const line of Array.from(block.querySelectorAll<HTMLElement>('[data-line]'))) {
          const label = text(line.querySelector('dt'));
          const items = Array.from(line.querySelectorAll<HTMLElement>('[data-item]'));
          if (items.length > 0) {
            lines.push('', `- ${label}`);
            for (const item of items) {
              const body = text(item);
              const url = item.dataset.url;
              /* The address goes on its own line rather than inside brackets, so it stays clickable
                 in any reader and needs no punctuation that a Chinese line would have to borrow. */
              lines.push(url ? `  - ${body}\n    ${new URL(url, location.href).href}` : `  - ${body}`);
            }
          } else {
            lines.push('', `- ${label}${T.labelJoin}${text(line.querySelector('[data-text]'))}`);
          }
        }
        const page = block.querySelector<HTMLAnchorElement>('[data-page] a');
        if (page) lines.push('', `- ${T.sourcePage}${T.labelJoin}${new URL(page.href, location.href).href}`);
      }

      lines.push('', T.exportFooter);
      return lines.join('\n');
    }

    root.addEventListener('change', repaint);

    root.addEventListener('click', async (event) => {
      const trigger = (event.target as HTMLElement).closest<HTMLElement>('[data-action]');
      if (!trigger) return;
      const action = trigger.dataset.action;

      if (action === 'all' || action === 'none') {
        for (const box of boxes) box.checked = action === 'all';
        repaint();
        return;
      }

      const n = chosen().length;
      if (n === 0) {
        status.textContent = T.empty;
        return;
      }

      const markdown = asMarkdown();

      if (action === 'copy') {
        try {
          await navigator.clipboard.writeText(markdown);
          status.textContent = T.copied;
        } catch {
          status.textContent = T.clipboardBlocked;
        }
        return;
      }

      if (action === 'download') {
        const blob = new Blob([markdown], { type: 'text/markdown' });
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = fileName;
        a.click();
        URL.revokeObjectURL(url);
        status.textContent = token(T.downloaded, { file: fileName });
      }
    });

    repaint();
  }
</script>
