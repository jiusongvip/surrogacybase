---
/*
 * The destination notes: one static section, no questions asked.
 *
 * This was the output of a ten question form. The form is gone and the findings stayed, because
 * none of them was about the person answering: each note is something a published rule or a
 * professional body says that a shortlist tends to miss. The whole list renders on the server, so
 * it reads the same with JavaScript disabled as with it, and the only two controls collect
 * nothing. They copy the list or write it to a file, both assembled in this browser.
 *
 * The legal statements quoted here are taken from the jurisdiction records, so each one carries
 * the publisher and the date we opened it. A note that cites a fact no record publishes fails the
 * build rather than printing an unsourced legal sentence.
 *
 * The wording lives in src/data/destination-notes, where every string is a paired en/zh record, so
 * the compiler asks for a Chinese half of each note.
 */
import Icon from '@/components/ui/Icon.astro';
import { getJurisdictions } from '@/lib/jurisdictions';
import { formatDate } from '@/lib/dates';
import { langFromPath, localizedPath } from '@/i18n/paths';
import { fill, pick } from '@/i18n/ui';
import {
  DESTINATION_NOTES,
  DESTINATION_NOTES_CHROME,
  DESTINATION_OWNERS,
  type DestinationNote,
} from '@/data/destination-notes';

const lang = langFromPath(Astro.url.pathname);
const copy = DESTINATION_NOTES_CHROME[lang];

const records = await getJurisdictions(lang);

function citation(note: DestinationNote) {
  if (!note.cite) return undefined;
  const { code, fact } = note.cite;
  const entry = records.find((r) => r.data.code === code)?.data.facts[fact];
  if (!entry) throw new Error(`Note "${note.id}" cites ${code} fact ${fact}, which is not a published fact.`);
  return entry.source;
}

const notes = DESTINATION_NOTES.map((n) => ({
  id: n.id,
  title: pick(n.title, lang),
  body: pick(n.body, lang),
  link: pick(n.link, lang),
  href: localizedPath(lang, n.href ?? ''),
  cite: citation(n),
}));

const owners = DESTINATION_OWNERS.map((o) => ({ who: pick(o.who, lang), owns: pick(o.owns, lang) }));
---

<div class="card overflow-hidden" data-notes data-copy={JSON.stringify(copy)}>
  <div class="border-b border-line bg-surface-2 px-5 py-6 sm:px-8">
    <p class="eyebrow flex items-center gap-2">
      <Icon name="map-pin" size={15} />
      {copy.eyebrow}
    </p>
    <h2 class="mt-3 text-[clamp(1.6rem,3.2vw,2.1rem)] leading-[1.15]">{copy.heading}</h2>
    <p class="mt-3 max-w-[62ch] text-[16px] leading-[1.7] text-muted">
      {copy.intro}
    </p>
  </div>

  <div class="grid gap-4 px-5 py-7 sm:grid-cols-2 sm:px-8">
    {
      notes.map((n) => (
        <article class="note min-w-0 rounded-(--radius) border border-line bg-surface p-5" data-note={n.id}>
          <p class="text-[16px] leading-snug font-medium">{n.title}</p>
          <p class="mt-2 text-[15px] leading-[1.7] text-muted">{n.body}</p>
          {n.cite && (
            <p class="mt-3 text-[13px] leading-relaxed text-muted">
              {copy.sourceLabel}<a href={n.cite.url} rel="noopener noreferrer" target="_blank" class="link-underlined ml-1 text-[13px]">{n.cite.publisher}</a>
              <span class="tnum ml-1">{fill(copy.checkedLabel, { date: formatDate(n.cite.verifiedOn, lang) })}</span>
            </p>
          )}
          <a href={n.href} class="textlink mt-4 text-[14px]">
            {n.link}
            <Icon name="arrow-right" size={15} />
          </a>
        </article>
      ))
    }
  </div>

  <section class="border-t border-line px-5 py-8 sm:px-8">
    <h3 class="text-[20px]">{copy.ownersHeading}</h3>
    <p class="mt-2 max-w-[64ch] text-[15px] leading-[1.7] text-muted">
      {copy.ownersIntro}
    </p>
    <dl class="mt-4 divide-y divide-line border-y border-line" data-owners>
      {
        owners.map((o) => (
          <div class="grid gap-1.5 py-4 sm:grid-cols-[minmax(0,0.9fr)_minmax(0,1.6fr)]">
            <dt class="text-[15px] font-medium">{o.who}</dt>
            <dd class="text-[15px] leading-[1.7] text-muted">{o.owns}</dd>
          </div>
        ))
      }
    </dl>

    <div class="mt-8 flex flex-wrap gap-3">
      <button type="button" class="btn-ghost text-sm" data-action="copy">
        <Icon name="file-text" size={15} />
        {copy.copyButton}
      </button>
      <button type="button" class="btn-ghost text-sm" data-action="download">
        <Icon name="download" size={15} />
        {copy.downloadButton}
      </button>
      <a href={localizedPath(lang, '/tools/destination-research-checklist')} class="textlink text-sm">
        {copy.checklistLink}
        <Icon name="arrow-right" size={15} />
      </a>
    </div>
    <p class="mt-3 empty:hidden text-[14px] leading-relaxed text-muted" role="status" aria-live="polite" data-status></p>
    <p class="mt-2 max-w-[64ch] text-[14px] leading-relaxed text-muted">
      {copy.copyExplanation}
    </p>
  </section>
</div>

<style>
  /* Two notes per row from sm, and .textlink is nowrap by default. A forty-six character label
   * would push its own card past the column the grid gave it, so this is the one place it breaks. */
  .note .textlink {
    white-space: normal;
  }
</style>

<script>
  const root = document.querySelector<HTMLElement>('[data-notes]');

  if (root) {
    /*
     * One bundle serves both languages, so the script takes its wording from the page instead of
     * importing the dictionary, which would ship every language's strings inside it.
     */
    const T = JSON.parse(root.dataset.copy!);

    const fill = (template: string, vars: Record<string, string | number>) =>
      template.replace(/\{(\w+)\]/g, (match, key: string) => (key in vars ? String(vars[key]) : match));

    const stamp = () =>
      new Date().toLocaleDateString(T.export.dateLocale, {
        day: 'numeric',
        month: 'short',
        year: 'numeric',
        timeZone: 'UTC',
      });

    const text = (el: Element | null | undefined) => el?.textContent?.trim() ?? '';

    /** Re-reads the rendered page, so the file carries exactly what the screen shows. */
    const asMarkdown = () => {
      const items = [...root.querySelectorAll<HTMLElement>('[data-note]')];
      const owners = [...root.querySelectorAll<HTMLElement>('[data-owners] > div')];
      return [
        `# ${T.export.title}`,
        '',
        fill(T.export.assembled, { date: stamp() }),
        '',
        T.export.note,
        '',
        `## ${T.heading}`,
        '',
        ...items.flatMap((n) => {
          const paras = [...n.querySelectorAll('p')];
          const cite = n.querySelector<HTMLAnchorElement>('a[target="_blank"]');
          const link = n.querySelector<HTMLAnchorElement>('a.textlink');
          const block = [`### ${text(paras[0])}`, '', text(paras[1])];
          if (cite) block.push('', `${fill(T.export.sourceLine, { label: text(cite) })} <${cite.href}>`);
          if (link) block.push('', `${fill(T.export.nextLine, { label: text(link) })} <${link.href}>`);
          return [...block, ''];
        }),
        `## ${T.ownersHeading}`,
        '',
        ...owners.map(
          (row) => `- ${fill(T.export.ownerLine, { who: text(row.querySelector('dt')), owns: text(row.querySelector('dd')) })}`,
        ),
        '',
        T.export.footer,
      ].join('\n');
    };

    const status = root.querySelector<HTMLElement>('[data-status]');

    /** Says which exit just ran, in the line below the buttons, so the buttons keep their labels. */
    function report(message: string) {
      if (!status) return;
      status.textContent = message;
      setTimeout(() => {
        if (status.textContent === message) status.textContent = '';
      }, 4000);
    }

    root.querySelectorAll<HTMLElement>('[data-action]').forEach((button) => {
      button.addEventListener('click', async () => {
        const markdown = asMarkdown();
        if (button.dataset.action === 'copy') {
          try {
            await navigator.clipboard.writeText(markdown);
            report(T.copied);
          } catch {
            report(T.copyBlocked);
          }
          return;
        }
        const url = URL.createObjectURL(new Blob([markdown], { type: 'text/markdown' }));
        const a = document.createElement('a');
        a.href = url;
        a.download = T.export.filename;
        a.click();
        URL.revokeObjectURL(url);
      });
    });
  }
</script>
