---
import { Image } from 'astro:assets';
import logoMark from '@/assets/images/logo.png';
import { SITE } from '@/const';
import { LANG_META, LOCALES, type Lang } from '@/i18n/config';
import { langFromPath, localizedPath, stripLocale } from '@/i18n/paths';
import { HOME_BY_LANG, isTranslated } from '@/i18n/routes';
import { UI } from '@/i18n/ui';
import Icon from '@/components/ui/Icon.astro';

const lang = langFromPath(Astro.url.pathname);
const copy = UI[lang];
const current = Astro.url.pathname;
const isActive = (href: string) => current === href || current.startsWith(`${href}/`);

/*
 * The switch is a dropdown listing every locale, the pattern the site owner pointed at on the
 * sister site: the current language is marked in place, a language with no version of this page
 * is printed greyed rather than linking to a 404, and the openable twins are plain links.
 *
 * The menu ships open in the HTML and the script closes it on load, so a reader without script
 * still gets every language link, just always visible. That keeps the site's promise that its
 * pages work before any script runs; the script only buys back the vertical space.
 */
const base = stripLocale(current);
const pathsByLang = Object.fromEntries(LOCALES.map((locale) => [locale, localizedPath(locale, base)])) as Record<Lang, string>;
for (const locale of LOCALES) {
  if (locale !== lang && !isTranslated(base)) pathsByLang[locale] = '';
}
pathsByLang[lang] = current;
const hasOther = LOCALES.some((locale) => locale !== lang && pathsByLang[locale]);
---

<header class="sticky top-0 z-40 border-b border-line bg-paper/92 backdrop-blur-sm">
  <div class="shell flex h-16 items-center justify-between gap-6">
    <a href={HOME_BY_LANG[lang]} class="flex items-center gap-2.5 text-text hover:text-accent">
      <Image
        src={logoMark}
        widths={[32, 64]}
        sizes="32px"
        width={32}
        height={32}
        loading="eager"
        class="h-8 w-8 shrink-0"
        alt={copy.brandAlt}
      />
      <span class="font-display text-[21px] leading-none tracking-tight">{SITE.name}</span>
    </a>

    <nav aria-label={copy.primaryNavLabel} class="hidden items-center gap-1 lg:flex">
      {copy.nav.map((item) => (
        <a
          href={item.href}
          aria-current={isActive(item.href) ? 'page' : undefined}
          class:list={[
            'rounded-(--radius) px-3 py-2 text-[15px] transition-colors duration-(--dur) hover:text-accent',
            isActive(item.href) ? 'text-accent' : 'text-muted',
          ]}
        >
          {item.label}
        </a>
      ))}
    </nav>

    <div class="flex items-center gap-3">
      {
        hasOther && (
          <div class="lang-switcher relative">
            <button
              type="button"
              class="inline-flex h-10 items-center gap-1.5 rounded-(--radius) border border-line-strong bg-surface px-3 text-[14px] text-text transition-colors duration-(--dur) hover:border-accent hover:text-accent"
              aria-haspopup="true"
              aria-expanded="false"
              aria-controls="lang-menu"
              data-lang-trigger
            >
              <Icon name="world" size={16} class="text-muted" />
              <span class="hidden sm:inline">{copy.languageLabel}</span>
              {LANG_META[lang].selfName}
              <Icon name="chevron-down" size={14} class="text-muted" />
            </button>
            <div
              id="lang-menu"
              class="absolute right-0 top-full z-50 mt-1.5 min-w-[150px] rounded-(--radius) border border-line bg-surface py-1 shadow-lift"
              data-lang-menu
            >
              {LOCALES.map((locale) => {
                const target = pathsByLang[locale];
                const label = LANG_META[locale].selfName;
                if (locale === lang) {
                  return (
                    <span class="block bg-surface-2/60 px-4 py-2 text-[14px] font-medium text-brand-fg" aria-current="true">
                      {label}
                    </span>
                  );
                }
                if (!target) {
                  return (
                    <span class="block cursor-not-allowed px-4 py-2 text-[14px] text-muted/60" title={copy.languageUnavailable}>
                      {label}
                    </span>
                  );
                }
                return (
                  <a
                    href={target}
                    hreflang={LANG_META[locale].htmlLang}
                    class="block px-4 py-2 text-[14px] text-text transition-colors duration-(--dur) hover:bg-surface-2 hover:text-accent"
                  >
                    {label}
                  </a>
                );
              })}
            </div>
          </div>
        )
      }
      <a href={copy.cta.href} class="btn-primary hidden text-sm sm:inline-flex">
        {copy.cta.label}
      </a>
      <button
        type="button"
        class="inline-flex h-10 w-10 items-center justify-center rounded-(--radius) border border-line-strong text-text lg:hidden"
        aria-expanded="false"
        aria-controls="mobile-nav"
        data-nav-toggle
      >
        <span class="sr-only">{copy.openNav}</span>
        <svg aria-hidden="true" width="18" height="18" viewBox="0 0 18 18" class="stroke-current" stroke-width="1.5">
          <path d="M2 5h14M2 9h14M2 13h14" fill="none" stroke-linecap="round" />
        </svg>
      </button>
    </div>
  </div>

  <nav
    id="mobile-nav"
    aria-label={copy.primaryNavLabel}
    class="hidden border-t border-line bg-surface px-5 pb-5 pt-2 lg:hidden"
    data-nav-panel
  >
    <ul class="flex flex-col">
      {copy.nav.map((item) => (
        <li>
          <a
            href={item.href}
            class:list={[
              'block border-b border-line py-3.5 text-[17px]',
              isActive(item.href) ? 'text-accent' : 'text-text',
            ]}
          >
            {item.label}
          </a>
        </li>
      ))}
      {
        LOCALES.filter((locale) => locale !== lang && pathsByLang[locale]).map((locale) => (
          <li>
            <a
              href={pathsByLang[locale]}
              hreflang={LANG_META[locale].htmlLang}
              class="block border-b border-line py-3.5 text-[17px] text-muted"
            >
              {copy.languageLabel}: {LANG_META[locale].selfName}
            </a>
          </li>
        ))
      }
      <li>
        <a href={copy.cta.href} class="btn-primary mt-4 w-full">{copy.cta.label}</a>
      </li>
    </ul>
  </nav>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('[data-nav-toggle]');
  const panel = document.querySelector<HTMLElement>('[data-nav-panel]');
  if (toggle && panel) {
    toggle.addEventListener('click', () => {
      const open = toggle.getAttribute('aria-expanded') === 'true';
      toggle.setAttribute('aria-expanded', String(!open));
      panel.classList.toggle('hidden', open);
    });
    panel.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('a')) {
        toggle.setAttribute('aria-expanded', 'false');
        panel.classList.add('hidden');
      }
    });
  }

  /* The menu is visible in the HTML and only collapses once this runs. Hiding it with a
   * class in markup would strand every language link behind script. */
  const langRoot = document.querySelector<HTMLElement>('.lang-switcher');
  const langTrigger = document.querySelector<HTMLButtonElement>('[data-lang-trigger]');
  const langMenu = document.querySelector<HTMLElement>('[data-lang-menu]');
  if (langRoot && langTrigger && langMenu) {
    const close = () => {
      langMenu.hidden = true;
      langTrigger.setAttribute('aria-expanded', 'false');
    };
    close();
    langTrigger.addEventListener('click', (e) => {
      e.stopPropagation();
      if (langMenu.hidden) {
        langMenu.hidden = false;
        langTrigger.setAttribute('aria-expanded', 'true');
      } else {
        close();
      }
    });
    document.addEventListener('click', (e) => {
      if (!langRoot.contains(e.target as Node)) close();
    });
    langRoot.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        close();
        langTrigger.focus();
      }
    });
  }
</script>
