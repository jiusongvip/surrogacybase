---
import { langFromPath } from '@/i18n/paths';
import { UI } from '@/i18n/ui';

type Heading = { text: string; slug: string; depth: number };
type Props = { headings: Heading[] };
const { headings } = Astro.props;
const heading = UI[langFromPath(Astro.url.pathname)].toc.heading;
---

{headings.length >= 3 && (
  <nav aria-label={heading} class="text-[14px]">
    <p class="font-semibold text-text">{heading}</p>
    <ul class="mt-3 space-y-2 border-l border-line">
      {headings.map((h) => (
        <li class:list={[h.depth === 3 ? 'pl-6' : 'pl-4']}>
          <a
            href={`#${h.slug}`}
            data-toc-link
            class="block -ml-px border-l-2 border-transparent py-0.5 text-muted transition-colors duration-(--dur) hover:border-accent hover:text-accent"
          >
            {h.text}
          </a>
        </li>
      ))}
    </ul>
  </nav>
)}

<script>
  const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-toc-link]'));
  if (links.length) {
    const byId = new Map(links.map((a) => [a.getAttribute('href')!.slice(1), a]));
    const targets = Array.from(byId.keys())
      .map((id) => document.getElementById(id))
      .filter((el): el is HTMLElement => el !== null);

    const setActive = (id: string) => {
      links.forEach((a) => {
        const on = a.getAttribute('href') === `#${id}`;
        a.classList.toggle('border-accent', on);
        a.classList.toggle('text-accent', on);
        a.classList.toggle('text-muted', !on);
      });
    };

    // Marks the heading nearest the top of the viewport as the current section.
    const observer = new IntersectionObserver(
      (entries) => {
        const visible = entries
          .filter((e) => e.isIntersecting)
          .sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top);
        if (visible[0]) setActive(visible[0].target.id);
      },
      { rootMargin: '-96px 0px -66% 0px', threshold: [0, 1] },
    );

    targets.forEach((t) => observer.observe(t));
    setActive(targets[0]?.id ?? '');
  }
</script>
