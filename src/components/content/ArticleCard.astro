---
import { langFromPath } from '@/i18n/paths';
import { CATEGORY_LABELS, UI, fill } from '@/i18n/ui';
import { formatDate, readingTime } from '@/lib/dates';
import { pathOf, type ContentEntry } from '@/lib/content';
import ContentPhoto from '@/components/content/ContentPhoto.astro';
import type { ContentImage } from '@/data/content-images';

type Props = {
  entry: ContentEntry;
  featured?: boolean;
  /**
   * The heading level the title is written at. Cards sit under a section heading on most pages,
   * which makes them third level; on a topic page they are the only list on the document, and a
   * heading that skips past the second level reads to an outline parser as a page missing a part.
   */
  heading?: 2 | 3;
  /* A piece with no registered photograph stays text-only rather than borrowing a picture that
   * belongs to a different page. */
  image?: ContentImage;
  /**
   * Set false where every card in the list is the same kind, as on a page that only lists
   * explainers: printing the kind on each card there repeats the section heading four times.
   */
  showKind?: boolean;
  /**
   * Set false where the section deliberately does not sort its cards by subject, as on the
   * homepage: there the label would turn six picks into six buckets, which is the taxonomy the
   * section is trying not to be. The piece still carries its category on its own page.
   */
  showCategory?: boolean;
};

const { entry, featured = false, heading = 3, image, showKind = true, showCategory = true } = Astro.props;
const Heading = `h${heading}` as 'h2' | 'h3';
const { title, description, category, type, updatedOn } = entry.data;
const href = pathOf(entry);
const minutes = type === 'article' ? readingTime(entry.body ?? '') : 0;

const lang = langFromPath(Astro.url.pathname);
const copy = UI[lang];
const label = CATEGORY_LABELS[lang][category] ?? category;
---

<article class:list={featured ? 'sm:col-span-2' : ''}>
  <a href={href} class="card card-hover flex h-full flex-col overflow-hidden">
    {
      image && (
        <div class="aspect-[16/9] w-full shrink-0">
          <ContentPhoto
            image={image}
            sizes={featured ? '(min-width: 640px) 640px, 100vw' : '(min-width: 1024px) 320px, (min-width: 640px) 50vw, 100vw'}
          />
        </div>
      )
    }
    <div class="flex flex-1 flex-col px-5 py-5">
      {
        showCategory && (
          <p class="text-[13px] font-medium text-accent">
            {label}
            {showKind && <span class="text-muted"> · {copy.kinds.guide}</span>}
          </p>
        )
      }
      <Heading class:list={[featured ? 'mt-2 text-[27px]' : 'mt-2 text-[21px]']}>{title}</Heading>
      <p class="mt-2 max-w-[58ch] text-[15px] leading-relaxed text-muted">{description}</p>
      <p class="mt-4 tnum text-[13px] text-muted">
        {copy.labels.updated} {formatDate(updatedOn, lang)}
        {minutes > 0 && <span> · {fill(copy.time.minRead, { n: minutes })}</span>}
      </p>
    </div>
  </a>
</article>
