---
/*
 * Marks a decision or fact the site owner still has to supply, so nothing ships
 * as a confident sentence that is actually an empty slot.
 */
import { langFromPath } from '@/i18n/paths';
import { UI } from '@/i18n/ui';

type Props = {
  label: string;
  why?: string;
};
const { label, why } = Astro.props;
const needsInput = UI[langFromPath(Astro.url.pathname)].needsInput;
---

<span
  class="inline-flex flex-wrap items-baseline gap-2 rounded-(--radius) border border-dashed border-flag/50 bg-flag-tint px-2 py-1 align-baseline text-[14px] text-flag"
  role="note"
>
  <span class="font-semibold">{needsInput}</span>
  <span>{label}</span>
  {why && <span class="text-flag/80">{why}</span>}
</span>
