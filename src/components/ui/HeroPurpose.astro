---
/*
 * A plain-language statement of what the reader does on this page, placed directly under the H1
 * so the purpose lands before any of the deeper framing below it. It exists because a page whose
 * opening sentence argues a philosophy is a page the visitor has to read twice to understand.
 */
type Props = { text: string; label?: string };
const { text, label } = Astro.props;
---

<div class="mt-6 max-w-[70ch] border-l-2 border-line-strong py-0.5 pl-5">
  {
    label && (
      <p class="mb-1 text-[14px] font-medium text-muted">{label}</p>
    )
  }
  <p class="font-display text-[19px] leading-[1.55] text-brand-fg">{text}</p>
</div>
