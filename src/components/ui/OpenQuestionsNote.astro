---
/*
 * One sentence, pointing at the register on the About page.
 *
 * Privacy, terms, the editorial policy and the enquiry form each used to carry their own notice about
 * what is missing. Five wordings of one gap are five claims to keep true, and the third reading of
 * them makes the whole site look unfinished rather than honest about one list.
 */
import { UI } from '@/i18n/ui';
import { langFromPath, localizedPath } from '@/i18n/paths';

type Props = { class?: string };

const { class: className = 'mt-4 text-[16px] leading-relaxed text-muted' } = Astro.props;
const lang = langFromPath(Astro.url.pathname);
const copy = UI[lang].openQuestions;
/** English needs a word space before the link; Chinese writes none after a full-width period. */
const gap = lang === 'zh' ? '' : ' ';
---

<p class={className}>{copy.body}{gap}<a href={`${localizedPath(lang, '/about')}#open-questions`} class="link-underlined">{copy.link}</a></p>
