# Astro fingerprints everything it bundles, so those files never change under one name and can be
# served as immutable. The paths below it are copied straight out of public/, which keeps its names,
# so they get a long but revisitable lifetime.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/flags/*
  Cache-Control: public, max-age=2592000

/og/*
  Cache-Control: public, max-age=86400

/images/*
  Cache-Control: public, max-age=604800

/favicon.png
  Cache-Control: public, max-age=604800

/apple-touch-icon.png
  Cache-Control: public, max-age=604800

/logo.png
  Cache-Control: public, max-age=604800
