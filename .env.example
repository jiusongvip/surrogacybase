# Enquiry delivery for SurrogacyBase.
#
# These values are read by functions/api/enquiry.ts on the server only. They are never sent to
# the browser, and they are this site's own credentials: do not copy them from another project.
#
# Cloudflare Pages: add them under Settings -> Environment variables for this project.
# Local emulation: copy this file to .dev.vars and fill it in. .dev.vars is git-ignored.
#
# Feishu Bitable expects these text fields:
#   姓名 / 邮箱 / 电话 / 联系方式 / 账号 / 咨询内容 / 来源页面 / 来源按钮 / 语言 / 提交时间
# Leave the Bitable block blank to deliver through webhooks only. Each configured channel is
# attempted independently; if none is configured, the form falls back to the browser.

FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_BITABLE_APP_TOKEN=
FEISHU_BITABLE_TABLE_ID=
FEISHU_WEBHOOK_URL=
# Optional. Enables signed requests for a Feishu custom bot.
FEISHU_WEBHOOK_SECRET=
WECOM_WEBHOOK_URL=
# Optional. Enables signed requests for a WeCom group robot.
WECOM_WEBHOOK_SECRET=
